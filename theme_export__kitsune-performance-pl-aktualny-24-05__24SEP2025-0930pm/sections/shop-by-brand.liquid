{%- comment -%}
------------------------------------------------------------------------------
	Section: Shop by brand
------------------------------------------------------------------------------
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
	{%- render 'adastra' with '/src/styles/shop-by-brand.scss' -%}

	{%- style -%}
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_mobile -}}px;
			padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
		}

		@media screen and (min-width: 768px) {
			#shopify-section-{{- section.id -}} {
				padding-top: {{- section.settings.offset_top_desktop -}}px;
				padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
			}
		}
	{%- endstyle -%}

	{%- assign heading                    = section.settings.heading -%}
	{%- assign grid_type                  = section.settings.grid_type -%}
	{%- assign container                  = section.settings.container_width -%}
	{%- assign blocks 	                  = section.blocks -%}
	{%- assign carousel_classes           = '' -%}
	{%- assign carousel_container_classes = '' -%}
	{%- assign carousel_item_classes      = '' -%}

	{%- if container == 'inherit' -%}
		{%- assign container_width = settings.container_width -%}
	{%- else -%}
		{%- assign container_width = container -%}
	{%- endif -%}

	{% assign pagination_dynamic = false %}

	{% if section.blocks.size > 6 %}
		{% assign pagination_dynamic = true %}
	{% endif %}

	{%- capture section_styles -%}
		--container-width: {{ container_width }}; {{-  -}}
	{%- endcapture -%}

	{%- if grid_type == "carousel" -%}
		{%- assign carousel_classes = 'swiper js-shop-by-brand-slider' -%}
		{%- assign carousel_container_classes = 'swiper-wrapper' -%}
		{%- assign carousel_item_classes = 'swiper-slide js-shop-by-brand-slide' -%}
	{%- endif -%}

{%- if blocks.size < 2 -%}
	{%- assign center = 'after' -%}
{%- elsif blocks.size < 3 -%}
	{%- assign center = 'after-mobile-landscape' -%}
{%- elsif blocks.size < 4 -%}
	{%- assign center = 'after-small' -%}
{%- elsif blocks.size < 6 -%}
	{%- assign center = 'after-medium' -%}
{%- elsif blocks.size < 9 -%}
	{%- assign center = 'after-large' -%}
{%- endif -%}

	<section
		class="shop-by-brand js-shop-by-brand-section js-animate {% if grid_type == 'carousel' %}need-animate{% endif %} {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}"
		style="{{- section_styles -}}"
	>
		{%- if heading != blank -%}
			<h2 class="shop-by-brand__heading h2">
				{{- heading -}}
			</h2>
		{%- endif -%}

		<div class="shop-by-brand__items {{ carousel_classes }}" data-dynamic-pagination="{{ pagination_dynamic }}">
			<div
				class="shop-by-brand__items-container shop-by-brand__items-container--{{ center }} {{ carousel_container_classes }}"
			>
				{% assign delay_step = 0 %}

				{%- for block in blocks -%}
				{%- assign brand_image = block.settings.brand_image -%}
				{%- assign brand_link = block.settings.brand_link -%}
				{% assign delay_step = delay_step | plus: 0.15 %}

				<div class="shop-by-brand__item-wrapper {% if grid_type == 'grid' %}need-animate tr-dur-0-5{% endif %} {{ carousel_item_classes }}"
					 style="--delay-step: {{ delay_step }}s;"
				>
				{%- if brand_link != blank -%}
					<a href="{{ brand_link }}"
					   class="shop-by-brand__item shop-by-brand__item--link focus-visible-outline">
						{%- else -%}
						<div class="shop-by-brand__item">
							{%- endif -%}
							<div class="shop-by-brand__item-image-container">
								{%- if brand_image != blank -%}
									{%- capture img_focal -%}
										--img-desktop-pos: {{ brand_image.presentation.focal_point }};
									{%- endcapture -%}

									<picture class="lazy">
										<source
											data-srcset="{{ brand_image | image_url: width: 148 }} 1x, {{ brand_image | image_url: width: 296 }} 2x"
											srcset="{{ brand_image | image_url: width: 10 }} 1x, {{ brand_image | image_url: width: 20 }} 2x"
											media="(max-width: 375px)"
											width="148"
											height="85"
										/>

										<source
											data-srcset="{{ brand_image | image_url: width: 170 }} 1x, {{ brand_image | image_url: width: 340 }} 2x"
											srcset="{{ brand_image | image_url: width: 10 }} 1x, {{ brand_image | image_url: width: 20 }} 2x"
											media="(max-width: 420px)"
											width="170"
											height="97"
										/>

										<source
											data-srcset="{{ brand_image | image_url: width: 248 }} 1x, {{ brand_image | image_url: width: 496 }} 2x"
											srcset="{{ brand_image | image_url: width: 10 }} 1x, {{ brand_image | image_url: width: 20 }} 2x"
											media="(max-width: 575px)"
											width="248"
											height="142"
										/>

										<source
											data-srcset="{{ brand_image | image_url: width: 293 }} 1x, {{ brand_image | image_url: width: 586 }} 2x"
											srcset="{{ brand_image | image_url: width: 10 }} 1x, {{ brand_image | image_url: width: 20 }} 2x"
											media="(max-width: 991px)"
											width="293"
											height="132"
										/>

										<source
											data-srcset="{{ brand_image | image_url: width: 264 }} 1x, {{ brand_image | image_url: width: 528 }} 2x"
											srcset="{{ brand_image | image_url: width: 10 }} 1x, {{ brand_image | image_url: width: 20 }} 2x"
											media="(max-width: 1199px)"
											width="264"
											height="119"
										/>

										<img
											class="shop-by-brand__item-image"
											data-srcset="{{ brand_image | image_url: width: 180 }} 1x, {{ brand_image | image_url: width: 360 }} 2x"
											srcset="{{ brand_image | image_url: width: 10 }} 1x, {{ brand_image | image_url: width: 20 }} 2x"
											data-src="{{ brand_image | image_url: width: 180 }}"
											src="{{ brand_image | image_url: width: 10 }}"
											alt="{{ brand_image.alt }}"
											width="180"
											height="81"
											style="{{ img_focal }}"
										/>
									</picture>

									<noscript>
										<picture>
											<source
												srcset="{{ brand_image | image_url: width: 148 }} 1x, {{ brand_image | image_url: width: 296 }} 2x"
												media="(max-width: 375px)"
												width="140"
												height="80"
											/>

											<source
												srcset="{{ brand_image | image_url: width: 170 }} 1x, {{ brand_image | image_url: width: 340 }} 2x"
												media="(max-width: 420px)"
												width="170"
												height="97"
											/>

											<source
												srcset="{{ brand_image | image_url: width: 248 }} 1x, {{ brand_image | image_url: width: 496 }} 2x"
												media="(max-width: 575px)"
												width="248"
												height="142"
											/>

											<source
												srcset="{{ brand_image | image_url: width: 293 }} 1x, {{ brand_image | image_url: width: 586 }} 2x"
												media="(max-width: 991px)"
												width="293"
												height="132"
											/>

											<source
												srcset="{{ brand_image | image_url: width: 264 }} 1x, {{ brand_image | image_url: width: 528 }} 2x"
												media="(max-width: 1199px)"
												width="264"
												height="119"
											/>

											<img
												class="shop-by-brand__item-image"
												srcset="{{ brand_image | image_url: width: 180 }} 1x, {{ brand_image | image_url: width: 360 }} 2x"
												src="{{ brand_image | image_url: width: 180 }}"
												alt="{{ brand_image.alt }}"
												width="180"
												height="81"
												style="{{ img_focal }}"
											/>
										</picture>
									</noscript>
								{%- else -%}
									{%- assign odd = forloop.index | modulo: 2 -%}

									{%- if odd == 1 -%}
										{{- "lifestyle-1" | placeholder_svg_tag: "shop-by-brand__item-image" -}}
									{%- else -%}
										{{- "lifestyle-2" | placeholder_svg_tag: "shop-by-brand__item-image" -}}
									{%- endif -%}
								{%- endif -%}
							</div>
							{%- if brand_link != blank -%}
					</a>
					{%- else -%}
				</div>
				{%- endif -%}
			</div>
			{%- endfor -%}
		</div>

		<div class="shop-by-brand__pagination js-shop-by-brand-slider-pagination"></div>
	</section>
	</section>

	{%- if grid_type == "carousel" -%}
		{%- render 'adastra' with '/src/scripts/section-shop-by-brand.js' -%}
	{%- endif -%}
{%- endif -%}

{%- schema -%}
{
	"name": "Our Partners",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Our Partners"
		},
		{
			"type": "select",
			"id": "grid_type",
			"label": "Type",
			"options": [
				{
					"value": "carousel",
					"label": "Carousel"
				},
				{
					"value": "grid",
					"label": "Grid"
				}
			],
			"default": "carousel"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"blocks": [
		{
			"name": "Brand",
			"type": "brand",
			"settings": [
				{
					"type": "image_picker",
					"id": "brand_image",
					"label": "Image"
				},
				{
					"type": "url",
					"id": "brand_link",
					"label": "Link"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Our Partners",
			"settings": {},
			"blocks": [
				{
					"type": "brand"
				},
				{
					"type": "brand"
				},
				{
					"type": "brand"
				},
				{
					"type": "brand"
				},
				{
					"type": "brand"
				},
				{
					"type": "brand"
				},
				{
					"type": "brand"
				},
				{
					"type": "brand"
				},
				{
					"type": "brand"
				},
				{
					"type": "brand"
				}
			]
		}
	]
}
{%- endschema -%}

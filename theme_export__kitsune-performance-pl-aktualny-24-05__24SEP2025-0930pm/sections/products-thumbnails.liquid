{%- comment -%}
------------------------------------------------------------------------------
	Section: Products thumbnails
------------------------------------------------------------------------------
{%- endcomment -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
	#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign container 			= section.settings.container_width -%}
{%- assign blocks 				= section.blocks  -%}
{%- assign has_filled_block 	= false -%}

{%- if container == 'inherit' -%}
	{%- assign container_width = settings.container_width -%}
{%- else -%}
	{% assign container_width = container %}
{%- endif -%}

{%- assign image_size        = 640 -%}
{%- assign image_size_tablet = 382 -%}
{%- assign image_size_mobile = 240 -%}

{%- for block in blocks -%}
	{%- assign heading = block.settings.heading -%}

	{%- if heading != blank -%}
		{%- assign has_filled_block = true -%}
		{%- break -%}
	{%- endif -%}
{%- endfor -%}

{%- assign heading 					= section.settings.heading -%}

{%- capture style -%}
	--container-width: {{ container_width -}};
{%- endcapture -%}

{%- if has_filled_block -%}
	<section class="products-thumbnails js-products-thumbnails-section js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}"
			 style="{{- style -}}"
	>
		{%- render 'adastra' with '/src/styles/products-thumbnails.scss' -%}

		<div class="products-thumbnails__container">
			<div class="products-thumbnails__heading-wrapper">
				{%- if heading != blank -%}
					<h2 class="product-tabs__title need-animate tr-dur-0-5">{{- heading -}}</h2>
				{%- endif -%}

				<div class="products-thumbnails__button-lists__wrapper js-products-thumbnails-buttons-wrapper">
					<ul class="products-thumbnails__button-lists">
						{% assign index = 1 %}

						{% assign tab_button_delay = 0.75 %}

						{%- for block in blocks -%}
							{%- assign heading = block.settings.heading -%}
							{% assign tab_button_delay = tab_button_delay | plus: 0.25 %}

							{%- if heading != blank -%}
								<li class="products-thumbnails__button-list-item need-animate tr-dur-0-5" style="transition-delay: {{ tab_button_delay }}s;">
									<button
										class="tab-button focus-visible-outline js-products-thumbnails-button {% if index == 1 -%}is-active{%- endif -%}"
										data-index="{{- index -}}"
									>
										{{- heading -}} <span
											class="visually-hidden">{{- 'sections.product_tabs.button_aria' | t: number: index | escape -}}</span>
									</button>
								</li>

								{%- assign index = index | plus: 1 -%}
							{%- endif -%}
						{%- endfor -%}
					</ul>
				</div>
			</div>

			{% assign index = 1 %}

			{%- for block in blocks -%}
				{%- assign heading = block.settings.heading -%}
				{%- assign product_list = block.settings.product_list -%}
				{%- assign button_label = block.settings.button_label -%}
				{%- assign button_link = block.settings.button_link -%}

				{%- if heading != blank -%}
					<div
						class="products-thumbnails__tab js-products-thumbnails-tab {% if product_list.count != 1 %} is-loading {% endif %} {% if index != 1 -%}is-hidden{%- endif -%}"
						data-index="{{- index -}}">
						<div
							class="products-thumbnails-slider swiper {% if product_list.count != 1 %}js-featured-content-slider{%- endif -%}">
							<div class="products-thumbnails__tab-content swiper-wrapper">
								{%- if product_list.count > 0 -%}
									{% if forloop.index == 1 %}
										{% assign delay_card_step = 0.25 %}
									{% endif %}

									{%- for product in product_list limit: limit -%}
										{% assign delay_card_step = delay_card_step | plus: 0.25 %}
										<div class="products-thumbnails__product  swiper-slide {% if forloop.parentloop.index == 1 %}need-animate tr-dur-0-5{% endif %}"
											 {% if forloop.parentloop.index == 1 %}style="--card-delay: {{ delay_card_step | append: 's' }};"{% endif %}
										>
											{%- render
												'product-card',
												product: product,
												size: image_size,
												tablet_size: image_size_tablet,
												mobile_size: image_size_mobile,
											-%}
										</div>
									{%- endfor -%}
								{%- else -%}
									{%- for i in (1..4) -%}
										<div class="products-thumbnails__product  swiper-slide">
											{%- render 'product-card', product: nil -%}
										</div>
									{%- endfor -%}
								{%- endif -%}
							</div>
						</div>

						{% if button_link != blank and button_label != blank %}
							<div class="products-thumbnails__button-wrapper need-animate tr-dur-0-5 tr-del-1-5">
								<a class="products-thumbnails__button button button--secondary-border"
								   href="{{ button_link }}">{{ button_label }}</a>
							</div>
						{% endif %}
					</div>
					{%- assign index = index | plus: 1 -%}
				{%- endif -%}
			{%- endfor -%}
		</div>

		{%- render 'adastra' with '/src/scripts/component-featured-content-slider.js' -%}
		{%- render 'adastra' with '/src/scripts/section-products-thumbnails.js' -%}
	</section>
{%- endif -%}


{%- schema -%}
{
	"name": "Products thumbnails",
	"disabled_on": {
		"groups": [
			"header",
			"footer"
		]
	},
	"settings": [
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Products thumbnails"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"blocks": [
		{
			"type": "tab",
			"name": "Tab",
			"limit": 4,
			"settings": [
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "Best sellers"
				},
				{
					"type": "product_list",
					"id": "product_list",
					"label": "Products",
					"limit": 4
				},
				{
					"type": "text",
					"id": "button_label",
					"label": "Button label",
					"default": "See all products"
				},
				{
					"type": "url",
					"id": "button_link",
					"label": "Button link"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Products thumbnails",
			"blocks": [
				{
					"type": "tab",
					"settings": {
						"heading": "Best sellers"
					}
				},
				{
					"type": "tab",
					"settings": {
						"heading": "New Arrivals"
					}
				},
				{
					"type": "tab",
					"settings": {
						"heading": "On sale"
					}
				}
			]
		}
	]
}
{%- endschema -%}

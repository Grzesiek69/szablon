{%- comment -%}
------------------------------------------------------------------------------
	Section: Header
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign blocks		 			= section.blocks -%}
{%- assign logo			 			= section.settings.logo -%}
{%- assign logo_transparent			= section.settings.logo_transparent | default: logo -%}
{%- assign logo_width	 			= section.settings.logo_width -%}
{%- assign menu_position 			= section.settings.menu_position -%}
{%- assign show_cart_notification 	= settings.show_cart_notification -%}

{%- assign menu							= section.settings.menu -%}
{%- assign menu_type_desktop			= section.settings.menu_type_desktop -%}
{%- assign menu_highlighted_link_name	= section.settings.menu_highlighted_link_name -%}

{%- assign show_burger_menu 				= section.settings.show_burger_menu -%}
{%- assign burger_menu_primary 				= section.settings.burger_menu_primary -%}
{%- assign burger_menu_secondary 			= section.settings.burger_menu_secondary -%}
{%- assign burger_menu_image 				= section.settings.burger_menu_image -%}
{%- assign burger_menu_heading 				= section.settings.burger_menu_heading -%}
{%- assign burger_menu_subheading 			= section.settings.burger_menu_subheading -%}
{%- assign burger_menu_link 				= section.settings.burger_menu_link -%}

{%- assign header_bg						= section.settings.header_bg -%}
{%- assign mobile_menu_bg					= section.settings.mobile_menu_bg -%}
{%- assign menu_border_color 				= section.settings.menu_border_color -%}
{%- assign text_color						= section.settings.text_color -%}
{%- assign text_color_active				= section.settings.text_color_active -%}
{%- assign text_background_color_selected	= section.settings.text_background_color_selected -%}
{%- assign text_color_secondary				= section.settings.text_color_secondary -%}
{%- assign text_color_active_secondary		= section.settings.text_color_active_secondary -%}
{%- assign text_color_transparent			= section.settings.text_color_transparent -%}
{%- assign text_color_transparent_active	= section.settings.text_color_transparent_active -%}
{%- assign menu_highlighted_link_color		= section.settings.menu_highlighted_link_color -%}
{%- assign icon_color						= section.settings.icon_color -%}
{%- assign icon_color_transparent			= section.settings.icon_color_transparent -%}
{%- assign count_text_color					= section.settings.count_text_color -%}
{%- assign count_text_color_transparent		= section.settings.count_text_color_transparent -%}
{%- assign count_text_bg					= section.settings.count_text_bg -%}
{%- assign count_text_bg_transparent		= section.settings.count_text_bg_transparent -%}
{%- assign megamenu_overlay_color			= section.settings.megamenu_overlay_color -%}
{%- assign megamenu_image_text				= section.settings.megamenu_image_text -%}

{%- assign burger_button_color						= section.settings.burger_button_color -%}
{%- assign burger_button_text_color					= section.settings.burger_button_text_color -%}
{%- assign burger_button_color_hover				= section.settings.burger_button_color_hover -%}
{%- assign burger_button_text_color_hover			= section.settings.burger_button_text_color_hover -%}
{%- assign burger_button_color_transparent			= section.settings.burger_button_color_transparent -%}
{%- assign burger_button_text_color_transparent		= section.settings.burger_button_text_color_transparent -%}

{%- assign burger_button_color_secondary				= section.settings.burger_button_color_secondary -%}
{%- assign burger_button_text_color_secondary			= section.settings.burger_button_text_color_secondary -%}
{%- assign burger_button_color_hover_secondary			= section.settings.burger_button_color_hover_secondary -%}
{%- assign burger_button_text_color_hover_secondary		= section.settings.burger_button_text_color_hover_secondary -%}

{%- assign burger_button_close_color				= section.settings.burger_button_close_color -%}
{%- assign burger_button_close_text_color			= section.settings.burger_button_close_text_color -%}
{%- assign burger_button_close_color_hover			= section.settings.burger_button_close_color_hover -%}
{%- assign burger_button_close_text_color_hover		= section.settings.burger_button_close_text_color_hover -%}

{%- assign search_input_color						= section.settings.search_input_color -%}
{%- assign search_input_text_color					= section.settings.search_input_text_color -%}
{%- assign search_input_color_transparent			= section.settings.search_input_color_transparent -%}
{%- assign search_input_text_color_transparent		= section.settings.search_input_text_color_transparent -%}

{%- assign bottom_menu_bg 					= section.settings.bottom_menu_bg -%}
{%- assign bottom_menu_border				= section.settings.bottom_menu_border -%}
{%- assign bottom_menu_border_transparent	= section.settings.bottom_menu_border_transparent -%}

{%- assign is_show_language_selector			= section.settings.is_show_language_selector -%}
{%- assign is_show_country_selector				= section.settings.is_show_country_selector -%}
{%- assign header_type 							= section.settings.header_type -%}
{%- assign enable_sticky_header		 			= true -%}
{%- assign enable_transparent_header			= false -%}
{%- assign enable_transparent_header_homepage	= section.settings.enable_transparent_header_homepage -%}
{%- assign enable_transparent_header_collection	= section.settings.enable_transparent_header_collection -%}
{%- assign enable_rounded_header				= section.settings.enable_rounded_header -%}
{%- assign is_show_box_shadow					= section.settings.is_show_box_shadow -%}
{%- assign open_menu_type			 			= section.settings.open_menu_type -%}
{%- assign make_first_lvl_clickable				= section.settings.make_first_lvl_clickable -%}
{%- assign cart_type 							= settings.cart_type -%}

{% assign display_link_on_first_lvl = false %}

{% if make_first_lvl_clickable and open_menu_type == 'hover' %}
	{% assign display_link_on_first_lvl = true %}
{% endif %}

{%- if header_type == "static" -%}
	{%- assign enable_sticky_header	= false -%}
{%- endif -%}

{%- if enable_transparent_header_homepage and template.name == "index" -%}
	{%- assign enable_transparent_header = true -%}
{%- endif -%}

{%- if enable_transparent_header_collection and template.name == "collection" -%}
	{%- assign enable_transparent_header = true -%}
{%- endif -%}

{%- assign enable_burger_menu = false -%}

{%- if show_burger_menu -%}
	{%- if burger_menu_primary != blank or burger_menu_secondary != blank -%}
		{%- assign enable_burger_menu = true -%}
	{%- endif -%}
{%- endif -%}


<style>
	:root {
		--header-position: {% if enable_sticky_header == true %}sticky{% else %}static{% endif %};
		--header-background: {{ header_bg -}};
		--header-mobile-menu-bg: {{ mobile_menu_bg -}};
		--header-menu-border-color: {{ menu_border_color -}};
		--header-text-color: {{ text_color -}};
		--header-text-color-active: {{ text_color_active -}};
		--header-text-background-color-selected: {{ text_background_color_selected -}};
		--header-text-color-secondary: {{ text_color_secondary -}};
		--header-text-color-active-secondary: {{ text_color_active_secondary -}};
		--header-transparent-text-color: {{ text_color_transparent -}};
		--header-transparent-text-color-active: {{ text_color_transparent_active -}};
		--header-menu-highlighted-link-color: {{ menu_highlighted_link_color -}};
		--header-icon-color: {{ icon_color -}};
		--header-transparent-icon-color: {{ icon_color_transparent -}};
		--header-count-text-color: {{ count_text_color -}};
		--header-transparent-count-text-color: {{ count_text_color_transparent -}};
		--header-count-text-bg: {{ count_text_bg -}};
		--header-transparent-count-text-bg: {{ count_text_bg_transparent -}};
		--header-megamenu-overlay: {{ megamenu_overlay_color -}};
		--header-megamenu-image-text: {{ megamenu_image_text -}};
		--header-height-sticky: {% if enable_sticky_header == true %}var(--header-height){% else %}0px{% endif %};
		--header-box-shadow: {%- if is_show_box_shadow -%} 0px 4px 11px 0px rgb(0 0 0 / 10%); {%- else -%} none {%- endif -%};
		--header-burger-button-color: {{ burger_button_color -}};
		--header-burger-button-text-color: {{ burger_button_text_color -}};
		--header-burger-button-color-hover: {{ burger_button_color_hover -}};
		--header-burger-button-text-color-hover: {{ burger_button_text_color_hover -}};
		--header-burger-button-color-secondary: {{ burger_button_color_secondary -}};
		--header-burger-button-text-color-secondary: {{ burger_button_text_color_secondary -}};
		--header-burger-button-color-hover-secondary: {{ burger_button_color_hover_secondary -}};
		--header-burger-button-text-color-hover-secondary: {{ burger_button_text_color_hover_secondary -}};
		--header-burger-button-transparent-color: {{ burger_button_color_transparent -}};
		--header-burger-button-text-transparent-color: {{ burger_button_text_color_transparent -}};
		--header-burger-button-close-color: {{ burger_button_close_color -}};
		--header-burger-button-close-text-color: {{ burger_button_close_text_color -}};
		--header-burger-button-close-color-hover: {{ burger_button_close_color_hover -}};
		--header-burger-button-close-text-color-hover: {{ burger_button_close_text_color_hover -}};
		--header-search-input-color: {{ search_input_color -}};
		--header-search-input-text-color: {{ search_input_text_color -}};
		--header-search-input-transparent-color: {{ search_input_color_transparent | color_modify: 'alpha', 0.1 -}};
		--header-search-input-text-transparent-color: {{ search_input_text_color_transparent -}};
		--header-bottom-menu-bg: {{ bottom_menu_bg -}};
		--header-bottom-menu-border: {{ bottom_menu_border -}};
		--header-bottom-menu-border-transparent: {{- bottom_menu_border_transparent | color_modify: 'alpha', 0.1 -}};
	}
</style>

{%- capture classes -%}
	{% if menu_position == 'left' %}
		header--menu-left
	{% elsif menu_position == 'middle' %}
		header--menu-middle
	{% elsif menu_position == 'bottom' %}
		header--menu-bottom

		{%- if menu == blank and enable_burger_menu == false -%}
			header--menu-bottom--empty
		{%- endif -%}
	{% endif %}

	{% if enable_rounded_header == true %}
		header--rounded
	{% endif %}
{%- endcapture -%}

{%- capture logo_shippet -%}
	<div class="header__logo">
		<span class="visually-hidden">
			{{ "layout.header.labels.store_logo" | t }}"
		</span>

		{%- if request.page_type == 'index' -%}
			<h1 class="header__heading">
				{%- endif -%}
				<a
					href="{{ routes.root_url }}"
					class="header__heading-link"
				>
					{%- if logo != blank -%}
						{%- assign logo_alt 			= logo.alt | default: shop.name | escape -%}
						{%- assign logo_alt_transparent = logo_transparent.alt | default: shop.name | escape -%}

						{%- assign logo_height 		= logo_width | divided_by: logo.aspect_ratio | round: 0 -%}
						{%- assign logo_width_x2 	= logo_width | times: 2 -%}

						{%- assign logo_height_mobile 		= logo_height | times: 0.7 -%}
						{%- assign logo_width_mobile 		= logo_width | times: 0.7 -%}
						{%- assign logo_width_x2_mobile 	= logo_width_x2 | times: 0.7 -%}


						{%- capture img_focal -%}
							--img-desktop-pos: {{ logo.presentation.focal_point }}; {{- -}}
						{%- endcapture -%}

						{%- capture img_focal_transparent -%}
							--img-desktop-pos-transparent: {{ logo_transparent.presentation.focal_point }}; --base-logo-width: {{ logo_width -}}px; --base-logo-height: {{ logo_height -}}px;
						{%- endcapture -%}

						<picture class="header__heading-logo-picture">
							<source
								srcset="{{ logo | image_url: width: logo_width_mobile }} 1x, {{ logo | image_url: width: logo_width_x2_mobile }} 2x"
								media="(max-width: 1199px)"
								width="{{ logo_width_mobile }}"
								height="{{ logo_height_mobile }}"
							>

							<img
								srcset="{{ logo | image_url: width: logo_width }} 1x, {{ logo | image_url: width: logo_width_x2 }} 2x"
								src="{{ logo | image_url: width: logo_width }}"
								alt="{{ logo.alt }}"
								class="header__heading-logo"
								height="{{ logo_height }}"
								width="{{ logo_width }}"
								style="{{ img_focal }}"
							/>
						</picture>

						{%- if enable_transparent_header -%}
							<img
								srcset="{{ logo_transparent | image_url: width: logo_width }} 1x, {{ logo_transparent | image_url: width: logo_width_x2 }} 2x"
								src="{{ logo_transparent | image_url: width: logo_width }}"
								alt="{{ logo_alt_transparent.alt }}"
								class="header__heading-logo header__heading-logo--transparent"
								height="{{ logo_height }}"
								width="{{ logo_width }}"
								style="{{ img_focal_transparent }}"
							/>
						{%- endif -%}
					{%- else -%}
						<span class="h2">{{ shop.name }}</span>
					{%- endif -%}
				</a>
				{%- if request.page_type == 'index' -%}
			</h1>
		{%- endif -%}
	</div>
{%- endcapture -%}

{%- capture header_search_snippet -%}
	<div class="header__search">
		<button
			type="button"
			class="header__search-input"
			data-target="headerPopupSearch"
			data-js-toggle="searchTogglePopup"
			aria-expanded="false"
			aria-controls="headerPopupSearch"
			aria-label="{{- "layout.navigation.search" | t | escape -}}"
		>
			{%- render 'icons', icon: 'search' -%}

			<span class="header__search-input-label">
				{{- "layout.navigation.search_input" | t -}}
			</span>
		</button>
	</div>
{%- endcapture -%}

<header
	class="header {{ classes | strip_newlines }} js-header"
	data-open-menu-type="{{- open_menu_type -}}"
	{% if header_type == "sticky_hide" %}
		data-hide-on-scroll-down
	{% endif %}
	{% if header_type == "static" %}
		data-static-header
	{% endif %}
	{% if enable_transparent_header %}
		data-header-transparent
	{% endif %}
>
	<div
		class="header__container"
		data-header-container
		{% if enable_sticky_header == true %}
			data-header-sticky
		{% endif %}
	>
		<div class="header__main">
			<div class="header__burger-menu-button-wrapper">
				<button
					class="header-burger-menu-button js-header-drawer-toggler js-main-menu-toggler"
					type="button"
					data-target="headerDrawerMenu"
					data-js-toggle="headerToggleMenuDrawer"
					aria-expanded="false"
					aria-controls="headerDrawerMenu"
					aria-label="{{ "layout.navigation.open_drawer_menu" | t | escape }}"
				>
					{%- render 'icons', icon: 'burger-menu-main' -%}

					<span class="header-burger-menu-button__label">
						{{ "layout.navigation.main_drawer_menu_button_label" | t }}
					</span>
				</button>
			</div>

			{%- if menu_position == 'middle' or menu_position == 'bottom' -%}
				{{- logo_shippet -}}
			{%- endif -%}

			{%- if menu_position == 'bottom' -%}
				{{ header_search_snippet }}
			{%- endif -%}


			{%- if menu_position != 'bottom' -%}
				{%- if menu != blank or enable_burger_menu == true -%}
					<div class="header__menu">
						{%- render 'header-menu',
							menu: menu,
							menu_type_desktop: menu_type_desktop,
							menu_position: menu_position,
							blocks: blocks,
							enable_rounded_header: enable_rounded_header,
							menu_highlighted_link_name: menu_highlighted_link_name,
							enable_burger_menu: enable_burger_menu,
							display_link_on_first_lvl: display_link_on_first_lvl
						-%}
					</div>
				{%- endif -%}
			{%- endif -%}

			{%- if menu_position == 'left' -%}
				{{- logo_shippet -}}
			{%- endif -%}

			<div class="header__utils">
				{% if menu_position != 'bottom' %}
					{{ header_search_snippet }}
				{% endif %}

				{%- if is_show_language_selector == true and localization.available_languages.size > 1 -%}
					{% assign language_selector = true %}
				{%- endif -%}

				{%- if is_show_country_selector == true and localization.available_countries.size > 1 -%}
					{% assign country_selector = true %}
				{%- endif -%}

				{%- if language_selector == true or country_selector -%}
					<div class="header__localization">
						{%- if language_selector == true -%}
							{%- render 'language-localization-form', class: 'header', id_prefix: 'header', form_id: 'header-localization-form' -%}
						{%- endif -%}

						{%- if country_selector == true -%}
							{%- render 'country-localization-form', class: 'header', id_prefix: 'header', form_id: 'header-country-form', show_full_name: section.settings.show_country_full_name -%}
						{%- endif -%}
					</div>
				{%- endif -%}

				<div class="header__icons">
					<button
						type="button"
						class="header__icon header__icon--search js-header-drawer-toggler"
						data-target="headerPopupSearch"
						data-js-toggle="searchTogglePopup"
						aria-expanded="false"
						aria-controls="headerPopupSearch"
						aria-label="{{- "layout.navigation.search" | t | escape -}}"
					>
						<span class="header__icon-wrapper">
							{%- render 'icons', icon: 'search' -%}
						</span>

						<span class="header__icon-label" aria-hidden="true">
							{{- "layout.navigation.search" | t -}}
						</span>
					</button>

					<a
						href="{{- routes.search_url -}}"
						class="header__icon header__icon--search no-js"
						aria-label="{{- "layout.navigation.search" | t | escape -}}"
					>
						<span class="header__icon-wrapper">
							{%- render 'icons', icon: 'search' -%}
						</span>

						<span
							class="header__icon-label"
							aria-hidden="true"
						>
							{{- "layout.navigation.search" | t -}}
						</span>
					</a>

					{%- if shop.customer_accounts_enabled -%}
						<a
							href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
							class="header__icon header__icon--account"
							{% if customer %}
								aria-label="{{- "layout.customer.account" | t | escape -}}"
							{% else %}
								aria-label="{{- "layout.customer.log_in" | t | escape -}}"
							{% endif %}
						>
							<span class="header__icon-wrapper">
								{%- render 'icons', icon: 'account' -%}
							</span>

							<span
								class="header__icon-label"
								aria-hidden="true"
							>
								{% if customer %}
									{{- "layout.customer.account" | t -}}
								{% else %}
									{{- "layout.customer.log_in" | t -}}
								{% endif %}
							</span>
						</a>
					{%- endif -%}

					<a
						href="{{- routes.cart_url -}}"
						class="header__icon header__icon--cart no-js"
						aria-label="{{- "layout.header.labels.cart" | t | escape -}}"
					>
						<span class="header__icon-wrapper">
							{%- render 'icons', icon: 'cart' -%}

							<span
								class="header__cart-count"
								data-cart-count="{{- cart.item_count -}}"
							>
								<span class="visually-hidden">
									{{ "layout.header.labels.cart_item_count" | t }}"
								</span>

								<span>
									{%- if cart.item_count > 99 -%}
										99+
									{%- else -%}
										{{- cart.item_count -}}
									{%- endif -%}
								</span>
							</span>
						</span>

						<span
							class="header__icon-label"
							aria-hidden="true"
						>
							{{- "layout.header.labels.cart" | t -}}
						</span>
					</a>

					{%- if cart_type == 'page' -%}
						<a href="{{- routes.cart_url -}}"
						   class="header__icon header__icon--cart"
						>
							<span class="header__icon-wrapper">
								{%- render 'icons', icon: 'cart' -%}

								<span class="visually-hidden">
									{{- "layout.header.labels.cart" | t | escape -}}.
								</span>

								<span
									class="header__cart-count js-header-cart-item-count-wrapper"
									data-cart-count="{{- cart.item_count -}}"
								>
									<span class="visually-hidden">
										{{ "layout.header.labels.cart_item_count" | t }}"
									</span>

									<span class="js-header-cart-item-count">
										{%- if cart.item_count > 99 -%}
											99+
										{%- else -%}
											{{- cart.item_count -}}
										{%- endif -%}
									</span>
								</span>
							</span>

							<span
								class="header__icon-label"
								aria-hidden="true"
							>
								{{- "layout.header.labels.cart" | t -}}
							</span>
						</a>
					{%- else -%}
						<button
							type="button"
							class="header__icon header__icon--cart"
							data-target="CartDrawer"
							data-js-toggle="CartDrawer"
							aria-expanded="false"
							aria-controls="CartDrawer"
						>
							<span class="header__icon-wrapper">
								{%- render 'icons', icon: 'cart' -%}

								<span class="visually-hidden">
									{{- "layout.header.labels.cart_drawer" | t | escape -}}.
								</span>

								<span
									class="header__cart-count js-header-cart-item-count-wrapper"
									data-cart-count="{{- cart.item_count -}}"
								>
									<span class="visually-hidden">
										{{ "layout.header.labels.cart_item_count" | t }}"
									</span>

									<span class="js-header-cart-item-count">
										{%- if cart.item_count > 99 -%}
											99+
										{%- else -%}
											{{- cart.item_count -}}
										{%- endif -%}
									</span>
								</span>
							</span>

							<span
								class="header__icon-label"
								aria-hidden="true"
							>
								{{- "layout.header.labels.cart" | t -}}
							</span>
						</button>
					{%- endif -%}
				</div>
			</div>
		</div>

		{%- if menu_position == "bottom" -%}
			{%- if menu != blank or enable_burger_menu == true -%}
				<div class="header__bottom-menu">
					{%- render 'header-menu',
						menu_style_type: 'secondary',
						menu_position: 'middle',
						menu: menu,
						menu_type_desktop: menu_type_desktop,
						blocks: blocks,
						enable_rounded_header: enable_rounded_header,
						menu_highlighted_link_name: menu_highlighted_link_name,
						enable_burger_menu: enable_burger_menu,
						display_link_on_first_lvl: display_link_on_first_lvl
					-%}
				</div>
			{%- endif -%}
		{%- endif -%}
	</div>

	{%- if show_cart_notification -%}
		{%- render 'cart-notification' -%}
	{%- endif -%}

	{%- render 'cart-notification-error' -%}
</header>


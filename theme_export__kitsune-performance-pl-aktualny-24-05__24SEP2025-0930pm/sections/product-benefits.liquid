{%- render "adastra" with '/src/styles/section-product-benefits.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
	#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign label 				= section.settings.label -%}
{%- assign heading 				= section.settings.heading -%}
{%- assign text 				= section.settings.text -%}
{%- assign image 				= section.settings.image -%}
{%- assign button_text 			= section.settings.button_text -%}
{%- assign button_link 			= section.settings.button_link -%}
{%- assign button_style 		= section.settings.button_style -%}
{%- assign box_feature_blocks_alignment = section.settings.box_feature_blocks_alignment -%}
{%- assign background 			= section.settings.background -%}
{%- assign color_label 			= section.settings.color_label -%}
{%- assign color_text 			= section.settings.color_text -%}
{%- assign box_background 		= section.settings.box_background -%}
{%- assign color_box 			= section.settings.color_box -%}
{%- assign container 			= section.settings.container_width -%}

{%- if container == 'inherit' -%}
	{%- assign container_width = settings.container_width -%}
{%- else -%}
	{% assign container_width = container -%}
{%- endif -%}

{%- assign enable_lazy_load = true -%}

{% if section.index == 1 %}
	{%- assign enable_lazy_load = false -%}
{% endif %}

{%- capture style -%}
	--box-feature-blocks-alignment: {{- box_feature_blocks_alignment -}};
	--background: {{- background -}};
	--color-label: {{- color_label -}};
	--color-text: {{- color_text -}};
	--box-background: {{- box_background -}};
	--color-box: {{- color_box -}};
	--container-width: {{- container_width -}};
{%- endcapture -%}

<section id="{{- section.id -}}" class="section-product-benefits js-product-benefits js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}" style="{{- style -}}">
	<div class="section-product-benefits__wrapper">
		<div class="section-product-benefits__content-wrap">
			<div class="section-product-benefits__box-text need-animate tr-dur-0-5 tr-del-0-75">
				{%- if label != blank -%}
					<div class="section-product-benefits__label">
						{{- label -}}
					</div>
				{%- endif -%}

				{%- if heading != blank -%}
					<h2 class="section-product-benefits__title h2">
						{{- heading -}}
					</h2>
				{%- endif -%}

				{%- if text != blank -%}
					<div class="section-product-benefits__text rte">
						{{- text -}}
					</div>
				{%- endif -%}

				{%- if section.blocks.size > 0 -%}
					{%- assign has_logo = false -%}

					{%- for block in section.blocks %}
						{%- if block.type == 'logo' -%}
							{% assign has_logo = true -%}
							{%- break -%}
						{%- endif -%}
					{%- endfor %}

					{%- if has_logo -%}
						<ul class="section-product-benefits__logo-list">
							{% assign logo_delay = 0.7 %}

							{%- for block in section.blocks -%}
								{%- assign logo = block.settings.logo_image -%}

								{%- if block.type == 'logo' and logo != blank -%}
									{% assign logo_delay = logo_delay | plus: 0.15 %}

									{%- if enable_lazy_load -%}
										<li class="section-product-benefits__logo-item lazy need-animate tr-dur-0-5" style="transition-delay: {{ logo_delay }}s;">
											<img
												class="section-product-benefits__logo-image"
												data-srcset="{{- logo | image_url: height: 64 -}} 1x,
															 {{- logo | image_url: height: 128 -}} 2x"
												data-src="{{- logo | image_url: height: 64 -}}"
												srcset="{{- logo | image_url: height: 10 -}} 1x,
														{{- logo | image_url: height: 20 -}} 2x"
												src="{{- logo | image_url: height: 10 -}}"
												alt="{{- logo.alt | escape -}}"
												width="64"
												height="64"
											>
										</li>
									{%- else -%}
										<li class="section-product-benefits__logo-item need-animate tr-dur-0-5" style="transition-delay: {{ logo_delay }}s;">
											<img
												class="section-product-benefits__logo-image"
												srcset="{{- logo | image_url: height: 64 -}} 1x,
														{{- logo | image_url: height: 128 -}} 2x"
												src="{{- logo | image_url: height: 64 -}}"
												alt="{{- logo.alt | escape -}}"
												width="64"
												height="64"
											>
										</li>
									{%- endif -%}
								{%- endif -%}
							{%- endfor -%}
						</ul>
					{%- endif %}
				{%- endif -%}

				{%- if button_text != blank or button_link != blank -%}
					<a
						href="{{- button_link -}}"
						class="section-product-benefits__btn button button--{{- button_style -}}"
					>
						{{- button_text -}}
					</a>
				{%- endif -%}
			</div>

			<div class="section-product-benefits__box-image">
				<div class="section-product-benefits__wrapper-image">
					{%- if image != blank -%}
						{%- capture focal_point -%}
							--image-focal: {{- image.presentation.focal_point -}}
						{%- endcapture -%}

						{%- if enable_lazy_load -%}
							<picture class="lazy">
								<source
									data-srcset="{{ image | image_url: width: 348, height: 348 }} 1x,
												 {{ image | image_url: width: 696, height: 696 }} 2x"
									srcset="{{ image | image_url: width: 10, height: 10 }} 1x,
											{{ image | image_url: width: 20, height: 20 }} 2x"
									media="(max-width: 380px)"
									height="348"
									width="348"
								>

								<source
									data-srcset="{{ image | image_url: width: 388, height: 388 }} 1x,
												 {{ image | image_url: width: 776, height: 776 }} 2x"
									srcset="{{ image | image_url: width: 10, height: 10 }} 1x,
											{{ image | image_url: width: 20, height: 20 }} 2x"
									media="(max-width: 420px)"
									height="388"
									width="388"
								>

								<source
									data-srcset="{{ image | image_url: width: 735, height: 735 }} 1x,
												 {{ image | image_url: width: 1470, height: 1470 }} 2x"
									srcset="{{ image | image_url: width: 10, height: 10 }} 1x,
											{{ image | image_url: width: 20, height: 20 }} 2x"
									media="(max-width: 767px)"
									height="735"
									width="735"
								>

								<source
									data-srcset="{{ image | image_url: width: 959, height: 959 }} 1x,
												 {{ image | image_url: width: 1919, height: 1919 }} 2x"
									srcset="{{ image | image_url: width: 10, height: 10 }} 1x,
											{{ image | image_url: width: 20, height: 20 }} 2x"
									media="(max-width: 991px)"
									height="959"
									width="959"
								>

								<source
									data-srcset="{{ image | image_url: width: 661, height: 661 }} 1x,
											 	 {{ image | image_url: width: 1322, height: 1322 }} 2x"
									srcset="{{ image | image_url: width: 10, height: 10 }} 1x,
											{{ image | image_url: width: 20, height: 20 }} 2x"
									media="(max-width: 1500px)"
									height="661"
									width="661"
								>

								<img
									class="section-product-benefits__image need-animate"
									data-srcset="{{ image | image_url: width: 854, height: 854 }} 1x,
												 {{ image | image_url: width: 1708, height: 1708 }} 2x"
									data-src="{{ image | image_url: width: 854, height: 854 }}"
									srcset="{{ image | image_url: width: 10, height: 10 }} 1x,
											{{ image | image_url: width: 20, height: 20 }} 2x"
									src="{{ image | image_url: width: 10, height: 10 }}"
									alt="{{ image.alt | escape }}"
									height="854"
									width="854"
									{%- if focal_point -%}
										style="{{- focal_point -}}"
									{%- endif -%}
								>
							</picture>
						{% else %}
							<picture>
								<source
									srcset="{{ image | image_url: width: 348, height: 348 }} 1x,
											{{ image | image_url: width: 696, height: 696 }} 2x"
									media="(max-width: 380px)"
									height="348"
									width="348"
								>

								<source
									srcset="{{ image | image_url: width: 388, height: 388 }} 1x,
											{{ image | image_url: width: 776, height: 776 }} 2x"
									media="(max-width: 420px)"
									height="388"
									width="388"
								>

								<source
									srcset="{{ image | image_url: width: 735, height: 735 }} 1x,
											{{ image | image_url: width: 1470, height: 1470 }} 2x"
									media="(max-width: 767px)"
									height="735"
									width="735"
								>

								<source
									srcset="{{ image | image_url: width: 959, height: 959 }} 1x,
											{{ image | image_url: width: 1919, height: 1919 }} 2x"
									media="(max-width: 991px)"
									height="959"
									width="959"
								>

								<source
									srcset="{{ image | image_url: width: 661, height: 661 }} 1x,
											{{ image | image_url: width: 1322, height: 1322 }} 2x"
									media="(max-width: 1500px)"
									height="661"
									width="661"
								>

								<img
									class="section-product-benefits__image need-animate"
									srcset="{{ image | image_url: width: 854, height: 854 }} 1x,
											{{ image | image_url: width: 1708, height: 1708 }} 2x"
									src="{{ image | image_url: width: 854, height: 854 }}"
									alt="{{- image.alt | escape -}}"
									height="854"
									width="854"
									{%- if focal_point -%}
										style="{{- focal_point -}}"
									{%- endif -%}
								>
							</picture>
						{%- endif -%}
					{%- else -%}
						{{- "product-1" | placeholder_svg_tag: 'section-product-benefits__image need-animate' -}}
					{%- endif -%}
				</div>
			</div>

			{%- if section.blocks.size > 0 -%}
				{%- assign has_text_feature = false -%}

				{%- for block in section.blocks -%}
					{%- if block.type == 'text-feature' -%}
						{%- assign has_text_feature = true -%}
						{%- break -%}
					{%- endif -%}
				{%- endfor -%}

				{%- if has_text_feature -%}
					{%- assign delay_step = 0.4 -%}

					<div class="section-product-benefits__box-text-feature need-animate tr-dur-0-75 tr-del-0-5">
						{%- for block in section.blocks -%}
							{%- assign text_feature_heading = block.settings.feature_heading -%}
							{%- assign text_feature_text = block.settings.feature_text -%}
							{%- assign text_feature = text_feature_heading | default: text_feature_text -%}
							{%- assign delay_step = delay_step | plus: 0.15 -%}

							{% if block.type == 'text-feature' and text_feature != blank %}
								<div class="section-product-benefits__text-feature-item need-animate js-text-feature-item"
									 style="transition-delay: {{ delay_step }}s;"
								>
									{%- if text_feature_heading != blank -%}
										<div class="section-product-benefits__text-feature-heading">
											{{- text_feature_heading -}}
										</div>
									{%- endif -%}

									{%- if text_feature_text != blank -%}
										<div class="section-product-benefits__text-feature-text">
											{{- text_feature_text -}}
										</div>
									{%- endif -%}
								</div>
							{% endif %}
						{%- endfor -%}
					</div>
				{%- endif -%}
			{%- endif -%}
		</div>

		{%- if section.blocks.size > 0 -%}
			{%- assign has_box_feature = false -%}

			{%- for block in section.blocks %}
				{%- if block.type == 'box-feature' -%}
					{% assign has_box_feature = true -%}
					{%- break -%}
				{%- endif -%}
			{%- endfor %}

			{%- if has_box_feature -%}
				<ul class="section-product-benefits__box-feature">
					{% assign delay_step = 0.4 %}

					{%- for block in section.blocks -%}
						{%- assign box_feature_image 	= block.settings.box_feature_image -%}
						{%- assign box_feature_heading 	= block.settings.box_feature_heading -%}

						{%- if block.type == 'box-feature' -%}
							{% assign delay_step = delay_step | plus: 0.15 %}

							<li class="section-product-benefits__box-feature-item need-animate tr-dur-0-5" style="transition-delay: {{ delay_step }}s;">
								{%- if box_feature_image != blank -%}
									<div class="section-product-benefits__box-feature-image-wrap">
										<picture>
											<source
												srcset="{{ box_feature_image | image_url: width: 64, height: 64 }} 1x,
														{{ box_feature_image | image_url: width: 128, height: 128 }} 2x"
												media="(max-width: 991.98px)"
												height="64"
												width="64"
											>
											<img
												class="section-product-benefits__box-feature-image"
												srcset="{{ box_feature_image | image_url: width: 80, height: 80 }} 1x,
														{{ box_feature_image | image_url: width: 160, height: 160 }} 2x"
												src="{{ box_feature_image | image_url: width: 80, height: 80 }}"
												alt="{{ box_feature_image | escape }}"
												height="80"
												width="80"
											>
										</picture>
									</div>
								{%- endif -%}

								{%- if box_feature_heading != blank -%}
									<div class="section-product-benefits__box-feature-heading">
										{{- box_feature_heading -}}
									</div>
								{%- endif -%}
							</li>
						{%- endif -%}
					{%- endfor -%}
				</ul>
			{%- endif -%}
		{%- endif -%}
	</div>
</section>

{% schema %}
	{
		"name": "Product benefits",
		"disabled_on": {
			"groups": ["header", "footer"]
		},
		"settings": [
			{
				"type": "text",
				"id": "label",
				"label": "Label",
				"default": "Label"
			},
			{
				"type": "text",
				"id": "heading",
				"label": "Heading",
				"default": "Product benefits"
			},
			{
				"type": "richtext",
				"id": "text",
				"label": "Text",
				"default": "<p>Give customers details about.</p>"
			},
			{
				"type": "image_picker",
				"id": "image",
				"label": "Image"
			},
			{
				"type": "text",
				"id": "button_text",
				"label": "Button text",
				"default": "Button"
			},
			{
				"type": "url",
				"id": "button_link",
				"label": "Button link",
				"default": "/"
			},
			{
				"id": "button_style",
				"type": "select",
				"label": "Button style",
				"options": [
					{
						"value": "primary",
						"label": "Primary"
					},
					{
						"value": "secondary",
						"label": "Secondary"
					},
					{
						"value": "primary-border",
						"label": "Primary with border"
					},
					{
						"value": "secondary-border",
						"label": "Secondary with border"
					}
				],
				"default": "secondary"
			},
			{
				"type": "select",
				"id": "box_feature_blocks_alignment",
				"label": "Box feature blocks alignment",
				"options": [
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "left"
			},
			{
				"type": "header",
				"content": "Color"
			},
			{
				"type": "color_background",
				"id": "background",
				"label": "Background",
				"default": "#161324"
			},
			{
				"type": "color",
				"id": "color_label",
				"label": "Label",
				"default": "#4D71F9"
			},
			{
				"type": "color",
				"id": "color_text",
				"label": "Text",
				"default": "#ffffff"
			},
			{
				"type": "color_background",
				"id": "box_background",
				"label": "Box background",
				"default": "rgba(255, 255, 255, 0.10)"
			},
			{
				"type": "color",
				"id": "color_box",
				"label": "Box text",
				"default": "#ffffff"
			},
			{
				"type": "header",
				"content": "Layout"
			},
			{
				"type": "select",
				"id": "container_width",
				"label": "Container width",
				"options": [
					{
						"value": "1432px",
						"label": "Default - 1400px"
					},
					{
						"value": "1952px",
						"label": "Large - 1920px"
					},
					{
						"value": "100%",
						"label": "Full width"
					},
					{
						"value": "inherit",
						"label": "Inherit of general setting"
					}
				],
				"default": "inherit",
				"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
			},
			{
				"type": "range",
				"id": "offset_top_desktop",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Desktop offset top",
				"default": 40
			},
			{
				"type": "range",
				"id": "offset_bottom_desktop",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Desktop offset bottom",
				"default": 40
			},
			{
				"type": "range",
				"id": "offset_top_mobile",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Mobile offset top",
				"default": 25
			},
			{
				"type": "range",
				"id": "offset_bottom_mobile",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Mobile offset bottom",
				"default": 25
			}
		],
		"blocks": [
			{
				"type": "logo",
				"name": "Logo",
				"settings": [
					{
						"type": "image_picker",
						"id": "logo_image",
						"label": "Image"
					}
				]
			},
			{
				"type": "text-feature",
				"name": "Text feature",
				"settings": [
					{
						"type": "text",
						"id": "feature_heading",
						"label": "Heading",
						"default": "Heading"
					},
					{
						"type": "text",
						"id": "feature_text",
						"label": "Text",
						"default": "Feature text"
					}
				]
			},
			{
				"type": "box-feature",
				"name": "Box feature",
				"settings": [
					{
						"type": "image_picker",
						"id": "box_feature_image",
						"label": "Image"
					},
					{
						"type": "text",
						"id": "box_feature_heading",
						"label": "Heading",
						"default": "Box feature heading"
					}
				]
			}
		],
		"presets": [
			{
				"name": "Product benefits",
				"blocks": [
					{
						"type": "text-feature"
					},
					{
						"type": "text-feature"
					},
					{
						"type": "text-feature"
					}
				]
			}
		]
	}
{% endschema %}

{%- comment -%}
------------------------------------------------------------------------------
	Section: Contact section
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/contact-section.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
	padding-top: {{- section.settings.offset_top_mobile -}}px;
	padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
	#shopify-section-{{- section.id -}} {
	padding-top: {{- section.settings.offset_top_desktop -}}px;
	padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
	}
	}
{%- endstyle -%}

{%- assign map_api_key = section.settings.map_api_key -%}
{%- assign map_query = section.settings.map_query -%}
{%- assign map_url = section.settings.map_url -%}
{%- assign image_desktop = section.settings.image_desktop -%}
{%- assign image_mobile = section.settings.image_mobile | default: image_desktop -%}

{%- assign address_heading = section.settings.address_heading -%}
{%- assign address_icon = section.settings.address_icon -%}
{%- assign address_text = section.settings.address_text -%}
{%- assign phone_heading = section.settings.phone_heading -%}
{%- assign phone_icon = section.settings.phone_icon -%}
{%- assign phone_text = section.settings.phone_text -%}
{%- assign email_heading = section.settings.email_heading -%}
{%- assign email_icon = section.settings.email_icon -%}
{%- assign email_text = section.settings.email_text -%}
{%- assign schedule_heading = section.settings.schedule_heading -%}
{%- assign schedule_icon = section.settings.schedule_icon -%}
{%- assign schedule_text = section.settings.schedule_text -%}
{%- assign is_shown_social = section.settings.show_socials -%}
{%- assign social_text = section.settings.social_text -%}

{%- assign heading = section.settings.heading -%}
{%- assign subheading = section.settings.subheading -%}
{%- assign name_label = section.settings.name_label -%}
{%- assign name_placeholder = section.settings.name_placeholder -%}
{%- assign email_label = section.settings.email_label -%}
{%- assign email_placeholder = section.settings.email_placeholder -%}
{%- assign phone_label = section.settings.phone_label -%}
{%- assign phone_placeholder = section.settings.phone_placeholder -%}
{%- assign message_label = section.settings.message_label -%}
{%- assign message_placeholder = section.settings.message_placeholder -%}
{%- assign submit_label = section.settings.submit_label -%}
{%- assign submit_style = section.settings.submit_style -%}
{%- assign is_name_required = section.settings.is_name_required -%}
{%- assign is_phone_required = section.settings.is_phone_required -%}
{%- assign is_message_required = section.settings.is_message_required -%}

{%- assign container = section.settings.container_width -%}

{% assign is_any_contact_item = false %}

{% if address_heading != blank or address_text != blank
or phone_heading != blank or phone_text != blank
or email_heading != blank or email_text != blank
or schedule_heading != blank or schedule_text != blank %}
	{% assign is_any_contact_item = true %}
{% endif %}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- if image_desktop != blank -%}
	{%- assign section_has_images = true -%}
{%- else -%}
	{%- assign section_has_images = false -%}
{%- endif -%}

{%- capture map_image -%}
	{%- capture img_focal -%}
		--img-desktop-pos: {{ image_desktop.presentation.focal_point }};
		--img-mob-pos: {{ image_mobile.presentation.focal_point }};
	{%- endcapture -%}

	<picture class="lazy">
		<source
			data-srcset="{{ image_mobile | img_url: '380x282', crop: "center" }} 1x, {{ image_mobile | img_url: '760x564', crop: "center" }} 2x"
			srcset="{{ image_mobile | img_url: '10x' }} 1x, {{ image_mobile | img_url: '10x' }} 2x"
			media="(max-width: 380px)"
			width="380"
			height="282"
		/>

		<source
			data-srcset="{{ image_mobile | img_url: '480x356', crop: "center" }} 1x, {{ image_mobile | img_url: '960x712', crop: "center" }} 2x"
			srcset="{{ image_mobile | img_url: '10x' }} 1x, {{ image_mobile | img_url: '10x' }} 2x"
			media="(max-width: 480px)"
			width="480"
			height="356"
		/>

		<source
			data-srcset="{{ image_desktop | img_url: '575x345', crop: "center" }} 1x, {{ image_desktop | img_url: '1150x690', crop: "center" }} 2x"
			srcset="{{ image_desktop | img_url: '10x' }} 1x, {{ image_desktop | img_url: '10x' }} 2x"
			media="(max-width: 575px)"
			width="575"
			height="345"
		/>

		<source
			data-srcset="{{ image_desktop | img_url: '767x460', crop: "center" }} 1x, {{ image_desktop | img_url: '1534x920', crop: "center" }} 2x"
			srcset="{{ image_desktop | img_url: '10x' }} 1x, {{ image_desktop | img_url: '10x' }} 2x"
			media="(max-width: 767px)"
			width="767"
			height="460"
		/>

		<source
			data-srcset="{{ image_desktop | img_url: '991x445', crop: "center" }} 1x, {{ image_desktop | img_url: '1982x890', crop: "center" }} 2x"
			srcset="{{ image_desktop | img_url: '10x' }} 1x, {{ image_desktop | img_url: '10x' }} 2x"
			media="(max-width: 991px)"
			width="991"
			height="445"
		/>

		<source
			data-srcset="{{ image_desktop | img_url: '1199x342', crop: "center" }} 1x, {{ image_desktop | img_url: '2398x684', crop: "center" }} 2x"
			srcset="{{ image_desktop | img_url: '10x' }} 1x, {{ image_desktop | img_url: '10x' }} 2x"
			media="(max-width: 1199px)"
			width="1199"
			height="342"
		/>

		<source
			data-srcset="{{ image_desktop | img_url: '1500x427', crop: "center" }} 1x, {{ image_desktop | img_url: '3000x854', crop: "center" }} 2x"
			srcset="{{ image_desktop | img_url: '10x' }} 1x, {{ image_desktop | img_url: '10x' }} 2x"
			media="(max-width: 1500px)"
			width="1500"
			height="427"
		/>

		<source
			data-srcset="{{ image_desktop | img_url: '1680x479', crop: "center" }} 1x, {{ image_desktop | img_url: '3360x958', crop: "center" }} 2x"
			srcset="{{ image_desktop | img_url: '10x' }} 1x, {{ image_desktop | img_url: '10x' }} 2x"
			media="(max-width: 1680px)"
			width="1680"
			height="479"
		/>

		<img
			class="contact-section__map-image"
			srcset="{{ image_desktop | img_url: "10x" }}"
			data-srcset="{{ image_desktop | img_url: "1920x547", crop: "center" }} 1x, {{ image_desktop | img_url: "3840x1094", crop: "center" }} 2x"
			src="{{- image_desktop | img_url: "10x" -}}"
			data-src="{{- image_desktop | img_url: "1920x547", crop: "center" -}}"
			alt="{{- image_desktop.alt -}}"
			width="1920"
			height="547"
			style="{{ img_focal }}"
		/>
	</picture>
{%- endcapture -%}

{%- capture contact_form -%}
	<div class="contact-section__content-wrapper">
		{% if heading != blank or subheading != blank or is_shown_social or is_any_contact_item %}
			<div class="contact-section__info-wrapper">
				{% if heading != blank %}
					<h2>
						{{ heading }}
					</h2>
				{% endif %}

				{% if subheading != blank %}
					<div class="contact-section__info-subheading rte">{{ subheading }}</div>
				{% endif %}

				{% if is_any_contact_item %}
					<div class="contact-section__info-items">
						{% if address_heading != blank or address_text != blank %}
							<div class="contact-section__info-item">
								{% if address_icon != blank %}
									<div class="contact-info-icon-wrapper">
										<img
											class="contact-info-icon"
											srcset="{{ address_icon | image_url: width: 24, height: 24 }} 1x, {{ address_icon | image_url: width: 48, height: 48 }} 2x"
											src="{{- address_icon | image_url: width: 24, height: 24 -}}"
											alt="{{- address_icon.alt -}}"
											height="24"
											width="24"
										/>
									</div>
								{% endif %}

								<div class="contact-section__info-item-wrapper">
									{% if address_heading != blank %}
										<span class="contact-section__info-item-heading">{{ address_heading }}</span>
									{% endif %}

									{% if address_text != blank %}
										<div class="contact-section__info-item-text rte">{{ address_text }}</div>
									{% endif %}
								</div>
							</div>
						{% endif %}

						{% if phone_heading != blank or phone_text != blank %}
							<div class="contact-section__info-item">
								{% if phone_icon != blank %}
									<div class="contact-info-icon-wrapper">
										<img
											class="contact-info-icon"
											srcset="{{ phone_icon | image_url: width: 24, height: 24 }} 1x, {{ phone_icon | image_url: width: 48, height: 48 }} 2x"
											src="{{- phone_icon | image_url: width: 24, height: 24 -}}"
											alt="{{- phone_icon.alt -}}"
											height="24"
											width="24"
										/>
									</div>
								{% endif %}

								<div class="contact-section__info-item-wrapper">
									{% if phone_heading != blank %}
										<span class="contact-section__info-item-heading">{{ phone_heading }}</span>
									{% endif %}

									{% if phone_text != blank %}
										<div class="contact-section__info-item-text rte">{{ phone_text }}</div>
									{% endif %}
								</div>
							</div>
						{% endif %}

						{% if email_heading != blank or email_text != blank %}
							<div class="contact-section__info-item">
								{% if email_icon != blank %}
									<div class="contact-info-icon-wrapper">
										<img
											class="contact-info-icon"
											srcset="{{ email_icon | image_url: width: 24, height: 24 }} 1x, {{ email_icon | image_url: width: 48, height: 48 }} 2x"
											src="{{- email_icon | image_url: width: 24, height: 24 -}}"
											alt="{{- email_icon.alt -}}"
											height="24"
											width="24"
										/>
									</div>
								{% endif %}

								<div class="contact-section__info-item-wrapper">
									{% if email_heading != blank %}
										<span class="contact-section__info-item-heading">{{ email_heading }}</span>
									{% endif %}

									{% if email_text != blank %}
										<div class="contact-section__info-item-text rte">{{ email_text }}</div>
									{% endif %}
								</div>
							</div>
						{% endif %}

						{% if schedule_heading != blank or schedule_text != blank %}
							<div class="contact-section__info-item">
								{% if schedule_icon != blank %}
									<div class="contact-info-icon-wrapper">
										<img
											class="contact-info-icon"
											srcset="{{ schedule_icon | image_url: width: 24, height: 24 }} 1x, {{ schedule_icon | image_url: width: 48, height: 48 }} 2x"
											src="{{- schedule_icon | image_url: width: 24, height: 24 -}}"
											alt="{{- schedule_icon.alt -}}"
											height="24"
											width="24"
										/>
									</div>
								{% endif %}

								<div class="contact-section__info-item-wrapper">
									{% if schedule_heading != blank %}
										<span class="contact-section__info-item-heading">{{ schedule_heading }}</span>
									{% endif %}

									{% if schedule_text != blank %}
										<div class="contact-section__info-item-text rte">{{ schedule_text }}</div>
									{% endif %}
								</div>
							</div>
						{% endif %}
					</div>
				{% endif %}

				{% if is_shown_social %}
					<div class="contact-section__info-socials-wrapper">
						{% if social_text != blank %}
							<p class="contact-section__info-social-text">{{ social_text }}</p>
						{% endif %}
						{% render "social-links" %}
					</div>
				{% endif %}
			</div>
		{% endif %}

		{%- form "contact", class: "contact-section__form", id: "ContactForm" -%}
			{% if form.posted_successfully? or form.errors %}
				<div class="contact-section__form-header">
					{%- if form.posted_successfully? -%}
						<p class="contact-section__form-submitted-title success" tabindex="-1" autofocus>
							{{- "contact.form.success_heading" | t -}}
						</p>
					{%- elsif form.errors -%}
						<p
							class="contact-section__form-submitted-title error"
							autofocus
							tabindex="-1"
							role="alert"
						>
							{{- "contact.form.error_heading" | t -}}
						</p>
					{%- endif -%}
				</div>
			{% endif %}

			<div class="contact-section__form-fields">
				<div class="contact-section__form-fields-row">
					<div class="input-wrapper contact-section__field contact-section__fields-col">
						{% if name_label != blank %}
							<label class="label-input {% if is_name_required %}label-input--required{% endif %}"
								   for="ContactForm-name--{{- section.id -}}"
							>
								{{ name_label }}
							</label>
						{% endif %}

						<input
							id="ContactForm-name--{{- section.id -}}"
							class="{% if form.errors contains "name" %} error{% endif %}"
							type="text"
							name="contact[name]"
							placeholder="{{- name_placeholder -}}"
							autocomplete="name"
							autocapitalize="off"
							{% if is_name_required %}
								required
								aria-required="true"
							{% endif %}
							{% if form.errors contains "name" %}
								aria-invalid="true"
								aria-describedby="ContactForm-name-error--{{- section.id -}}"
							{% endif %}
							{% if customer %}
								value="{{- customer.name -}}"
							{% endif %}
						/>

						{%- if form.errors contains "name" -%}
							<small class="contact-section__input-error error" id="ContactForm-name-error--{{- section.id -}}">
								<span class="visually-hidden">
									{{- "contact.form.error" | t -}}
								</span>

								<span class="contact-section__input-error-message">
									{{ form.errors.translated_fields['name'] | capitalize }} {{ form.errors.messages['name'] }}
								</span>
							</small>
						{%- endif -%}
					</div>

					<div class="input-wrapper contact-section__field contact-section__fields-col">
						{% if email_label != blank %}
							<label class="label-input label-input--required"
								   for="ContactForm-email--{{- section.id -}}">
								{{ email_label }}
							</label>
						{% endif %}

						<input
							id="ContactForm-email--{{- section.id -}}"
							class="{% if form.errors contains "email" %} error{% endif %}"
							type="email"
							name="contact[email]"
							placeholder="{{- email_placeholder -}}"
							autocomplete="email"
							autocapitalize="off"
							{% if form.errors contains "email" %}
								aria-invalid="true"
								aria-describedby="ContactForm-email-error--{{- section.id -}}"
							{% endif %}
							{% if customer %}
								value="{{- customer.email -}}"
							{% endif %}
							aria-required="true"
							required
						/>

						{%- if form.errors contains "email" -%}
							<small class="contact-section__input-error error" id="ContactForm-email-error--{{- section.id -}}">
								<span class="visually-hidden">
									{{- "contact.form.error" | t -}}
								</span>

								<span class="contact-section__input-error-message">
									{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
								</span>
							</small>
						{%- endif -%}
					</div>
				</div>

				<div class="input-wrapper contact-section__field">
					{% if phone_label != blank %}
						<label class="label-input {% if is_phone_required %}label-input--required{% endif %}"
							   for="ContactForm-phone--{{- section.id -}}"
						>
							{{ phone_label }}
						</label>
					{% endif %}

					<input
						id="ContactForm-phone--{{- section.id -}}"
						type="tel"
						name="contact[phone]"
						placeholder="{{- phone_placeholder -}}"
						pattern="[0-9\-]*"
						autocomplete="name"
						autocapitalize="off"
						{% if is_phone_required %}
							required
							aria-required="true"
						{% endif %}
						value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
					/>
				</div>

				<div class="input-wrapper contact-section__field">
					{% if message_label != blank %}
						<label class="label-input {% if is_message_required %}label-input--required{% endif %}"
							   for="ContactForm-message--{{- section.id -}}"
						>
							{{ message_label }}
						</label>
					{% endif %}

					<textarea
						id="ContactForm-message--{{- section.id -}}"
						class="{% if form.errors contains "message" %} error{% endif %}"
						name="contact[message]"
						placeholder="{{- message_placeholder -}}"
				{% if form.errors contains "message" %}
					aria-invalid="true"
					aria-describedby="ContactForm-message-error--{{- section.id -}}"
				{% endif %}
						{% if is_message_required %}
							aria-required="true"
							required
						{% endif %}
					></textarea>

					{%- if form.errors contains "message" -%}
						<small class="contact-section__input-error error" id="ContactForm-message-error--{{- section.id -}}">
					<span class="visually-hidden">
						{{- "contact.form.error" | t -}}
					</span>

							<span class="contact-section__input-error-message">
						{{ form.errors.translated_fields['message'] | capitalize }} {{ form.errors.messages['message'] }}
					</span>
						</small>
					{%- endif -%}
				</div>

				<button class="button button--{{ submit_style }} contact-section__submit" type="submit">
					{{- submit_label -}}
				</button>
			</div>
		{%- endform -%}
	</div>
{%- endcapture -%}

<section class="contact-section" style="--container-width: {{ container_width }}">
	{{ contact_form }}

	{%- if map_api_key != blank and map_query != blank -%}
		<div class="contact-section__map-container">
			<div class="contact-section__map-wrapper js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}">
				<iframe
					class="contact-section__map"
					width="100%"
					height="100%"
					frameborder="0" style="border:0"
					referrerpolicy="no-referrer-when-downgrade"
					src="https://www.google.com/maps/embed/v1/place?key={{- map_api_key -}}&q={{- map_query -}}"
					allowfullscreen>
				</iframe>
			</div>
		</div>
	{%- elsif map_url != blank and section_has_images == true -%}
		<div class="contact-section__map-container">
			<a
				href="{{- map_url -}}"
				class="contact-section__map-link-image-wrapper contact-section__map-link-image-wrapper-hover js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}"
				target="_blank"
				rel="nofollow"
				aria-label="{{- 'contact.form.map_link_aria_label' | t | escape -}}"
			>
				{{- map_image -}}
			</a>
		</div>
	{% elsif section_has_images == true and map_url == nil %}
		<div class="contact-section__map-container">
			<div
				class="contact-section__map-link-image-wrapper js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}">
				{{- map_image -}}
			</div>
		</div>
	{% endif %}
</section>


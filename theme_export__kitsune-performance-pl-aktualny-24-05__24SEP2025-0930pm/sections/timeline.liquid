{%- assign container              = section.settings.container_width -%}
{%- assign blocks                 = section.blocks -%}
{%- assign first_active_index 	  = null -%}

{%- for block in blocks -%}
	{% if block.settings.is_block_active %}
		{% assign first_active_index = forloop.index %}
		{% break %}
	{% endif %}
{%- endfor -%}

{%- if first_active_index == null -%}
	{%- assign first_active_index = blocks.size | times: 1.0 | divided_by: 2 | ceil -%}
{%- endif -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{% if container_width != '100%' %}
	{% assign container_class = 'timeline__content-wrapper--limited-width' %}
{% endif %}

{%- if blocks.size > 0 -%}
	{%- render 'adastra' with '/src/styles/timeline.scss' -%}

	{%- style -%}
		#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
		}

		@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_desktop -}}px;
		padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
		}
	{%- endstyle -%}

	<section class="timeline{% if request.visual_preview_mode or section.index == 1 %} animated{% endif %} js-animate js-timeline" style="--container-width: {{- container_width -}};">
		<div class="timeline__slider swiper need-animate tr-del-0-75 js-timeline-slider">
			<div class="timeline__slider-container timeline__slider-container--{{ blocks.size }} swiper-wrapper">
				{%- for block in blocks -%}
					{% assign tab_heading = block.settings.tab_heading %}
					{% assign is_block_active = block.settings.is_block_active %}

					{%- if tab_heading != blank -%}
						<div
							class="timeline__slide{% if forloop.index == first_active_index %} timeline__slide--active{% endif %} swiper-slide focus-visible-outline js-timeline-slide"
							data-index="{{- forloop.index0 -}}"
							data-is-active="{{- is_block_active -}}"
						>
							<p class="timeline__slide-heading js-timeline-slide-heading">
								{{- tab_heading | truncate: 10, "" -}}
							</p>

							<div class="timeline__slide-indicator"></div>
						</div>
					{%- endif -%}
				{%- endfor -%}
			</div>

			<button
				class="timeline__swiper-button-prev is-hidden swiper-button swiper-button--prev js-timeline-slider-button-prev"
				type="button"
				aria-label="{{ "general.accessibility.slider.prev_slide_message" | t | escape -}}"
			>
				{% render "icons", icon: "arrow-left" %}
			</button>

			<button
				class="timeline__swiper-button-next is-hidden swiper-button swiper-button--next js-timeline-slider-button-next"
				type="button"
				aria-label="{{ "general.accessibility.slider.next_slide_message" | t | escape -}}"
			>
				{% render "icons", icon: "arrow-right" %}
			</button>
		</div>

		<div class="timeline__content-wrapper {{ container_class }}">
			{%- for block in blocks -%}
				{%- assign image_desktop      = block.settings.image_desktop -%}
				{%- assign image_mobile       = block.settings.image_mobile | default: image_desktop -%}
				{%- assign image_aspect_ratio = block.settings.image_aspect_ratio -%}
				{%- assign image_position     = block.settings.image_position -%}
				{%- assign text_alignment     = block.settings.text_alignment -%}
				{%- assign heading            = block.settings.heading -%}
				{%- assign subheading         = block.settings.subheading -%}
				{%- assign text               = block.settings.text -%}
				{%- assign button_text        = block.settings.button_text -%}
				{%- assign button_aria_label  = block.settings.button_aria_label -%}
				{%- assign button_link        = block.settings.button_link -%}
				{%- assign button_style       = block.settings.button_style -%}

				{%- capture block_css_variables -%}
					--text-alignment: {{ text_alignment }};
				{%- endcapture -%}

				{%- capture image -%}
					<div class="timeline__item-image-wrapper{% if image_position == 'right' %} timeline__item-image-wrapper--right{% endif %}">
						<div class="timeline__item-image-container need-animate tr-dur-0-75">
							{%- if image_desktop != blank -%}
								{%- capture img_focal -%}
									--img-desktop-pos: {{ image_desktop.presentation.focal_point }};
									--img-mob-pos: {{ image_mobile.presentation.focal_point }};
								{%- endcapture -%}

								{%- case image_aspect_ratio -%}
									{%- when 'square' -%}
										<picture class="lazy">
											<source
												data-srcset="{{ image_mobile | img_url: "343x", crop: 'center' }} 1x, {{ image_mobile | img_url: "686x", crop: 'center' }} 2x"
												srcset="{{ image_mobile | img_url: "10x", crop: 'center' }} 1x, {{ image_mobile | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 375px)"
												width="343"
												height="343"
											/>

											<source
												data-srcset="{{ image_mobile | img_url: "388x", crop: 'center' }} 1x, {{ image_mobile | img_url: "776x", crop: 'center' }} 2x"
												srcset="{{ image_mobile | img_url: "10x", crop: 'center' }} 1x, {{ image_mobile | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 420px)"
												width="388"
												height="388"
											/>

											<source
												data-srcset="{{ image_mobile | img_url: "543x", crop: 'center' }} 1x, {{ image_mobile | img_url: "1086x", crop: 'center' }} 2x"
												srcset="{{ image_mobile | img_url: "10x", crop: 'center' }} 1x, {{ image_mobile | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 575px)"
												width="543"
												height="543"
											/>

											<source
												data-srcset="{{ image_mobile | img_url: "735x", crop: 'center' }} 1x, {{ image_mobile | img_url: "1470x", crop: 'center' }} 2x"
												srcset="{{ image_mobile | img_url: "10x", crop: 'center' }} 1x, {{ image_mobile | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 767px)"
												width="735"
												height="735"
											/>

											<source
												data-srcset="{{ image_desktop | img_url: "959x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1918x", crop: 'center' }} 2x"
												srcset="{{ image_desktop | img_url: "10x", crop: 'center' }} 1x, {{ image_desktop | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 991px)"
												width="959"
												height="959"
											/>

											<source
												data-srcset="{{ image_desktop | img_url: "585x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1170x", crop: 'center' }} 2x"
												srcset="{{ image_desktop | img_url: "10x", crop: 'center' }} 1x, {{ image_desktop | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 1199px)"
												width="585"
												height="585"
											/>

											<source
												data-srcset="{{ image_desktop | img_url: "704x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1408x", crop: 'center' }} 2x"
												srcset="{{ image_desktop | img_url: "10x", crop: 'center' }} 1x, {{ image_desktop | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 1440px)"
												width="704"
												height="704"
											/>

											<img
												data-srcset="{{ image_desktop | img_url: "944x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1888x", crop: 'center' }} 2x"
												srcset="{{ image_desktop | img_url: "10x", crop: 'center' }} 1x, {{ image_desktop | img_url: "10x", crop: 'center' }} 2x"
												data-src="{{ image_desktop | img_url: "944x", crop: 'center' }}"
												src="{{ image_desktop | img_url: "10x", crop: 'center' }}"
												alt="{{ image_desktop.alt }}"
												width="944"
												height="944"
												class="timeline__item-image"
												style="{{ img_focal }}"
											/>
										</picture>

										<noscript>
											<picture>
												<source
													srcset="{{ image_mobile | img_url: "343x", crop: 'center' }} 1x, {{ image_mobile | img_url: "686x", crop: 'center' }} 2x"
													media="(max-width: 375px)"
													width="343"
													height="343"
												/>

												<source
													srcset="{{ image_mobile | img_url: "388x", crop: 'center' }} 1x, {{ image_mobile | img_url: "776x", crop: 'center' }} 2x"
													media="(max-width: 420px)"
													width="388"
													height="388"
												/>

												<source
													srcset="{{ image_mobile | img_url: "543x", crop: 'center' }} 1x, {{ image_mobile | img_url: "1086x", crop: 'center' }} 2x"
													media="(max-width: 575px)"
													width="543"
													height="543"
												/>

												<source
													srcset="{{ image_mobile | img_url: "735x", crop: 'center' }} 1x, {{ image_mobile | img_url: "1470x", crop: 'center' }} 2x"
													media="(max-width: 767px)"
													width="735"
													height="735"
												/>

												<source
													srcset="{{ image_desktop | img_url: "959x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1918x", crop: 'center' }} 2x"
													media="(max-width: 991px)"
													width="959"
													height="959"
												/>

												<source
													srcset="{{ image_desktop | img_url: "585x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1170x", crop: 'center' }} 2x"
													media="(max-width: 1199px)"
													width="585"
													height="585"
												/>

												<source
													srcset="{{ image_desktop | img_url: "704x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1408x", crop: 'center' }} 2x"
													media="(max-width: 1440px)"
													width="704"
													height="704"
												/>

												<img
													srcset="{{ image_desktop | img_url: "944x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1888x", crop: 'center' }} 2x"
													src="{{ image_desktop | img_url: "944x", crop: 'center' }}"
													alt="{{ image_desktop.alt }}"
													width="944"
													height="944"
													class="timeline__item-image"
													style="{{ img_focal }}"
												/>
											</picture>
										</noscript>
									{%- else -%}
										<picture class="lazy">
											<source
												data-srcset="{{ image_mobile | img_url: "343x", crop: 'center' }} 1x, {{ image_mobile | img_url: "686x", crop: 'center' }} 2x"
												srcset="{{ image_mobile | img_url: "10x", crop: 'center' }} 1x, {{ image_mobile | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 375px)"
												width="343"
												height="244"
											/>

											<source
												data-srcset="{{ image_mobile | img_url: "388x", crop: 'center' }} 1x, {{ image_mobile | img_url: "776x", crop: 'center' }} 2x"
												srcset="{{ image_mobile | img_url: "10x", crop: 'center' }} 1x, {{ image_mobile | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 420px)"
												width="388"
												height="276"
											/>

											<source
												data-srcset="{{ image_mobile | img_url: "543x", crop: 'center' }} 1x, {{ image_mobile | img_url: "1086x", crop: 'center' }} 2x"
												srcset="{{ image_mobile | img_url: "10x", crop: 'center' }} 1x, {{ image_mobile | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 575px)"
												width="543"
												height="386"
											/>

											<source
												data-srcset="{{ image_mobile | img_url: "735x", crop: 'center' }} 1x, {{ image_mobile | img_url: "1470x", crop: 'center' }} 2x"
												srcset="{{ image_mobile | img_url: "10x", crop: 'center' }} 1x, {{ image_mobile | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 767px)"
												width="735"
												height="522"
											/>

											<source
												data-srcset="{{ image_desktop | img_url: "959x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1918x", crop: 'center' }} 2x"
												srcset="{{ image_desktop | img_url: "10x", crop: 'center' }} 1x, {{ image_desktop | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 991px)"
												width="959"
												height="681"
											/>

											<source
												data-srcset="{{ image_desktop | img_url: "585x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1170x", crop: 'center' }} 2x"
												srcset="{{ image_desktop | img_url: "10x", crop: 'center' }} 1x, {{ image_desktop | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 1199px)"
												width="585"
												height="415"
											/>

											<source
												data-srcset="{{ image_desktop | img_url: "704x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1408x", crop: 'center' }} 2x"
												srcset="{{ image_desktop | img_url: "10x", crop: 'center' }} 1x, {{ image_desktop | img_url: "10x", crop: 'center' }} 2x"
												media="(max-width: 1440px)"
												width="704"
												height="500"
											/>

											<img
												data-srcset="{{ image_desktop | img_url: "944x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1888x", crop: 'center' }} 2x"
												srcset="{{ image_desktop | img_url: "10x", crop: 'center' }} 1x, {{ image_desktop | img_url: "10x", crop: 'center' }} 2x"
												data-src="{{ image_desktop | img_url: "944x", crop: 'center' }}"
												src="{{ image_desktop | img_url: "10x", crop: 'center' }}"
												alt="{{ image_desktop.alt }}"
												width="944"
												height="671"
												class="timeline__item-image"
												style="{{ img_focal }}"
											/>
										</picture>

										<noscript>
											<picture>
												<source
													srcset="{{ image_mobile | img_url: "343x", crop: 'center' }} 1x, {{ image_mobile | img_url: "686x", crop: 'center' }} 2x"
													media="(max-width: 375px)"
													width="343"
													height="244"
												/>

												<source
													srcset="{{ image_mobile | img_url: "388x", crop: 'center' }} 1x, {{ image_mobile | img_url: "776x", crop: 'center' }} 2x"
													media="(max-width: 420px)"
													width="388"
													height="276"
												/>

												<source
													srcset="{{ image_mobile | img_url: "543x", crop: 'center' }} 1x, {{ image_mobile | img_url: "1086x", crop: 'center' }} 2x"
													media="(max-width: 575px)"
													width="543"
													height="386"
												/>

												<source
													srcset="{{ image_mobile | img_url: "735x", crop: 'center' }} 1x, {{ image_mobile | img_url: "1470x", crop: 'center' }} 2x"
													media="(max-width: 767px)"
													width="735"
													height="522"
												/>

												<source
													srcset="{{ image_desktop | img_url: "959x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1918x", crop: 'center' }} 2x"
													media="(max-width: 991px)"
													width="959"
													height="681"
												/>

												<source
													srcset="{{ image_desktop | img_url: "585x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1170x", crop: 'center' }} 2x"
													media="(max-width: 1199px)"
													width="585"
													height="415"
												/>

												<source
													srcset="{{ image_desktop | img_url: "704x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1408x", crop: 'center' }} 2x"
													media="(max-width: 1440px)"
													width="704"
													height="500"
												/>

												<img
													srcset="{{ image_desktop | img_url: "944x", crop: 'center' }} 1x, {{ image_desktop | img_url: "1888x", crop: 'center' }} 2x"
													src="{{ image_desktop | img_url: "944x", crop: 'center' }}"
													alt="{{ image_desktop.alt }}"
													width="944"
													height="671"
													class="timeline__item-image"
													style="{{ img_focal }}"
												/>
											</picture>
										</noscript>
								{%- endcase -%}
							{%- else -%}
								{{ 'image' | placeholder_svg_tag: 'timeline__item-image timeline__item-image--placeholder' }}
							{%- endif -%}
						</div>
					</div>
				{%- endcapture -%}

				<div
					class="timeline__item{% if forloop.index == first_active_index %} timeline__item--visible{% endif %} timeline__item--{{ image_aspect_ratio }} js-timeline-content-item"
					style="{{ block_css_variables }}"
				>
					{%- if image_position == 'left' -%}
						{{- image -}}
					{%- endif -%}

					{%- if heading != blank or subheading != blank or text != blank -%}
						<div class="timeline__item-text-content need-animate tr-dur-0-5 tr-del-0-4">
							{%- if subheading != blank -%}
								<p class="timeline__item-subheading">
									{{- subheading -}}
								</p>
							{%- endif -%}

							{%- if heading != blank -%}
								<h2 class="timeline__item-heading">
									{{- heading -}}
								</h2>
							{%- endif -%}

							{%- if text != blank -%}
								<div class="timeline__item-text rte">
									{{- text -}}
								</div>
							{%- endif -%}

							{%- if button_text != blank and button_link != blank -%}
								<a
									href="{{ button_link }}"
									class="timeline__item-link button button--{{ button_style }} focus-visible-outline"
									{% if button_aria_label != blank -%}
										aria-label="{{- button_aria_label | escape -}}"
									{%- endif -%}
								>
									{{- button_text -}}
								</a>
							{%- endif -%}
						</div>
					{%- endif -%}

					{%- if image_position == 'right' -%}
						{{- image -}}
					{%- endif -%}
				</div>
			{%- endfor -%}
		</div>
	</section>

	{%- render 'adastra' with '/src/scripts/section-timeline.js' -%}
{%- endif -%}

{%- schema -%}
{
	"name": "Timeline",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"max_blocks": 7,
	"settings": [
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
		],
		"blocks": [
			{
			"name": "Content",
			"type": "content",
			"settings": [
				{
					"type": "checkbox",
					"id": "is_block_active",
					"label": "Make this block active",
					"default": false,
					"info": "Check this box to make the block open by default."
				},
				{
					"type": "text",
					"id": "tab_heading",
					"label": "Tab heading",
					"default": "Tab",
					"info": "Limit to 10 symbols"
				},
				{
					"type": "image_picker",
					"id": "image_desktop",
					"label": "Image desktop"
				},
				{
					"type": "image_picker",
					"id": "image_mobile",
					"label": "Image mobile"
				},
				{
					"type": "select",
					"id": "image_aspect_ratio",
					"label": "Image aspect ratio",
					"options": [
						{
							"value": "square",
							"label": "Square"
						},
						{
							"value": "landscape",
							"label": "Landscape"
						}
					],
					"default": "square"
				},
				{
					"type": "select",
					"id": "image_position",
					"label": "Image position",
					"options": [
						{
							"value": "left",
							"label": "Left"
						},
						{
							"value": "right",
							"label": "Right"
						}
					],
					"default": "left"
				},
				{
					"type": "select",
					"id": "text_alignment",
					"label": "Text alignment",
					"options": [
						{
							"value": "left",
							"label": "Left"
						},
						{
							"value": "center",
							"label": "Center"
						},
						{
							"value": "right",
							"label": "Right"
						}
					],
					"default": "left"
				},
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "Heading"
				},
				{
					"type": "textarea",
					"id": "subheading",

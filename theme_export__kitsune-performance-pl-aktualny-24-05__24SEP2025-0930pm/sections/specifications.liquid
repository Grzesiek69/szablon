{% render 'adastra' with '/src/styles/specifications.scss' %}

{%- assign title 			= section.settings.heading -%}
{%- assign product 			= section.settings.product -%}
{%- assign in_stock 		= section.settings.in_stock -%}
{%- assign button_style 	= section.settings.button_style -%}
{%- assign container 		= section.settings.container_width -%}

{%- if container == 'inherit' -%}
	{%- assign container_width = settings.container_width -%}
{%- else -%}
	{%- assign container_width = container -%}
{%- endif -%}

{%- capture section_style -%}
	--container-width: {{- container_width -}} {{- -}};
{%- endcapture -%}

{%- assign is_lazy = false -%}

{%- if section.index > 1 -%}
	{%- assign is_lazy = true -%}
{%- endif -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 767px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

<section class="specifications js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}" style="{{- section_style -}}">
	<div class="specifications__container">
		{%- if title != blank -%}
			<h2 class="specifications__title h2">{{- title -}}</h2>
		{%- endif -%}

		<div class="specifications__wrapper">
			{%- if section.blocks.size > 0 -%}
				<div class="specifications__accordions-box accordion need-animate tr-dur-0-75 tr-del-0-5 js-accordion-container">
					{%- for block in section.blocks -%}
						<div class="specifications__accordion js-accordion-item">
							{% assign block_heading = block.settings.specification_heading %}

							{%- capture accordion -%}
								{% for i in (1..10) %}
									{%- capture label_var_name %}label_{{- i -}}{% endcapture -%}
									{%- capture value_var_name %}value_{{- i -}}{% endcapture -%}

									{%- assign label_value = block.settings[label_var_name] -%}
									{%- assign value_value = block.settings[value_var_name] -%}

									{%- if label_value != blank or value_value != blank -%}
										<div class="specifications__accordion-item">
											{%- if label_value != blank -%}
												<div class="specifications__accordion-label">
													{{- label_value -}}
												</div>
											{%- endif %}

											{%- if value_value != blank -%}
												<div class="specifications__accordion-value">
													{{- value_value -}}
												</div>
											{%- endif -%}
										</div>
									{%- endif -%}
								{%- endfor -%}
							{%- endcapture -%}

							{%- if block_heading -%}
								<button
									class="specifications__accordion-header js-accordion-control"
									aria-controls="content-{{- block.id -}}"
									aria-expanded="false"
								>
									<div class="specifications__accordion-title">
										{{- block_heading -}}
									</div>

									{%- if accordion != blank -%}
										{% render 'icons', icon: 'arrow-down' %}
									{%- endif -%}
								</button>
							{%- endif -%}

							{% if accordion != blank %}
								<div
									id="content-{{- block.id -}}"
									class="specifications__accordion-body accordion__content accordion__content--animate js-accordion-content"
									style="height: 0;"
								>
									<div class="specifications__accordion-body-inner js-accordion-inner">
										{{- accordion -}}
									</div>
								</div>
							{% endif %}
						</div>
					{%- endfor -%}
				</div>
			{%- endif  -%}

			<div class="specifications__product-box need-animate tr-dur-0-75 tr-del-0-3">
				<div class="specifications__product-title">
					{%- if product.title != blank -%}
						{{- product.title -}}
					{%- else -%}
						{{ 'products.product_card.product_title' | t }}
					{%- endif -%}
				</div>
				<div class="specifications__product-box-image">
					<a href="{{- product.url -}}" class="specifications__product-image-wrap">
						{%- assign product_image = product.featured_image | default: settings.product_default_image -%}

						{%- if product != blank and product_image != blank -%}
							{%- if is_lazy -%}
								<picture class="lazy">
									<source
										data-srcset="{{ product_image | image_url: width: 200, height: 200 }} 1x,
													 {{ product_image | image_url: width: 400, height: 400 }} 2x"
										srcset="{{ product_image | image_url: width: 10, height: 10 }} 1x,
												{{ product_image | image_url: width: 20, height: 20 }} 2x"
										media="(max-width: 420px)"
										width="200"
										height="200"
									>
									<img
										class="specifications__product-image"
										data-src="{{ product_image | image_url: width: 280, height: 280 }}"
										data-srcset="{{ product_image | image_url: width: 280, height: 280 }} 1x,
														 {{ product_image | image_url: width: 560, height: 560 }} 2x"
										src="{{ product_image | image_url: width: 10, height: 10 }}"
										srcset="{{ product_image | image_url: width: 10, height: 10 }} 1x,
													{{ product_image | image_url: width: 20, height: 20 }} 2x"
										alt="{{ product_image.alt | escape }}"
										width="280"
										height="280"
									>
								</picture>
							{%- else -%}
								<picture>
									<source
										srcset="{{ product_image | image_url: width: 200, height: 200 }} 1x,
												{{ product_image | image_url: width: 400, height: 400 }} 2x"
										media="(max-width: 420px)"
										width="200"
										height="200"
									>
									<img
										class="specifications__product-image"
										src="{{ product_image | image_url: width: 280, height: 280 }}"
										srcset="{{ product_image | image_url: width: 280, height: 280 }} 1x,
													{{ product_image | image_url: width: 560, height: 560 }} 2x"
										alt="{{ product_image.alt | escape }}"
										width="280"
										height="280"
									>
								</picture>
							{%- endif -%}

						{%- else -%}
							{{ 'product-1' | placeholder_svg_tag: 'specifications__product-image' }}
						{%- endif -%}
					</a>
				</div>

				{%- if in_stock != blank and product.available -%}
					<div class="specifications__product-label">
							<span class="specifications__product-label-icon">
								{% render 'icons', icon: 'check' %}
							</span>
						{{- in_stock -}}
					</div>
				{%- endif -%}

				{% render 'price', product: product %}

				<button
					class="specifications__btn focus-visible-outline js-add-to-cart button button--{{- button_style -}}"
					type="button"
					data-product-handle="{{- product.handle -}}"
					data-min-quantity="{{- product.selected_or_first_available_variant.quantity_rule.min -}}"
					{% if product.has_only_default_variant or product.variants.size == 1 %}
						data-variant-id="{{- product.variants[0].id -}}"
					{% endif %}
					{% unless product.available %}
						disabled
					{% endunless %}
				>
					{% render 'icons', icon: 'cart' %}
					{%- if product.available -%}
						{{- 'products.product.add_to_cart' | t -}}
					{%- else -%}
						{{- 'products.product.sold_out' | t -}}
					{%- endif -%}
				</button>
			</div>
		</div>
	</div>
</section>


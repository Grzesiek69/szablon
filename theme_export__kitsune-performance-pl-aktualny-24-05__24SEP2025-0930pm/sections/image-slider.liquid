{%- if section.blocks.size > 0 -%}
	{%- render 'adastra' with '/src/styles/image-slider.scss' -%}

	{%- style -%}
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_mobile -}}px;
			padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
		}

		@media screen and (min-width: 768px) {
			#shopify-section-{{- section.id -}} {
				padding-top: {{- section.settings.offset_top_desktop -}}px;
				padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
			}
		}
	{%- endstyle -%}

	{%- assign heading         = section.settings.heading -%}
	{%- assign enable_autoplay = section.settings.enable_autoplay -%}
	{%- assign autoplay_speed  = section.settings.autoplay_speed -%}

	{% assign pagination_dynamic = false %}

	{% if section.blocks.size > 5 %}
		{% assign pagination_dynamic = true %}
	{% endif %}

	<section class="image-slider js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}">
		{%- if heading != blank -%}
			<h2 class="image-slider__heading h2 need-animate tr-dur-0-5">
				{{- heading -}}
			</h2>
		{%- endif -%}

		<div
			class="image-slider__items-container swiper-container need-animate tr-dur-0-75 tr-del-0-3 js-image-slider-container"
			data-dynamic-pagination="{{ pagination_dynamic }}"
			{%- if enable_autoplay == true -%}
				data-autoplay-speed="{{ autoplay_speed | times: 1000 }}"
			{%- endif -%}
		>
			<div class="image-slider__items-wrapper swiper-wrapper">
				{%- for block in section.blocks -%}
					{%- assign image = block.settings.image -%}
					{%- assign link  = block.settings.link -%}

					{% if section.index > 1 %}
						{% assign is_lazy = true %}
					{% elsif section.index == 1 and forloop.index > 2 %}
						{% assign is_lazy = true %}
					{% endif %}

					{% render 'image-slider-slide', image: image, link: link, is_lazy: is_lazy %}
				{%- endfor -%}

				{% if section.blocks.size == 2 %}
					{%- for i in (1..2) -%}
						{%- assign image = section.blocks[forloop.index0].settings.image -%}
						{%- assign link  = section.blocks[forloop.index0].settings.link -%}

						{% render 'image-slider-slide', image: image, link: link, is_lazy: is_lazy %}
					{%- endfor -%}
				{% elsif section.blocks.size == 1 %}
					{%- assign image = section.blocks[0].settings.image -%}
					{%- assign link  = section.blocks[0].settings.link -%}

					{%- for i in (1..2) -%}
						{% render 'image-slider-slide', image: image, link: link, is_lazy: is_lazy %}
					{%- endfor -%}
				{% endif %}
			</div>

			<div class="swiper-pagination image-slider__pagination"></div>
		</div>
	</section>

	{%- render 'adastra' with '/src/scripts/component-swiper-modules.js' -%}
	{%- render 'adastra' with '/src/scripts/section-image-slider.js' -%}
{%- endif -%}

{%- schema -%}
{
	"name": "Image slider",
	"disabled_on": {
		"groups": [
			"header",
			"footer"
		]
	},
	"settings": [
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Image slider"
		},
		{
			"type": "header",
			"content": "Slideshow settings"
		},
		{
			"type": "checkbox",
			"id": "enable_autoplay",
			"label": "Autoplay",
			"default": true
		},
		{
			"type": "range",
			"id": "autoplay_speed",
			"min": 3,
			"max": 15,
			"step": 1,
			"unit": "s",
			"label": "Autoplay speed",
			"default": 5
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"blocks": [
		{
			"name": "Slide",
			"type": "slide",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "url",
					"id": "link",
					"label": "Link"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Image slider",
			"settings": {},
			"blocks": [
				{
					"type": "slide"
				},
				{
					"type": "slide"
				},
				{
					"type": "slide"
				},
				{
					"type": "slide"
				},
				{
					"type": "slide"
				}
			]
		}
	]
}
{%- endschema -%}

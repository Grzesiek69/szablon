{%- comment -%}
------------------------------------------------------------------------------
	Section: Banner with tabs
------------------------------------------------------------------------------
{%- endcomment -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{% assign container                   = section.settings.container_width %}
{% assign label                       = section.settings.label %}
{% assign heading                     = section.settings.heading %}
{% assign text                        = section.settings.text %}
{% assign label_color                 = section.settings.label_color %}
{% assign text_color                  = section.settings.text_color %}
{% assign tab_button_color            = section.settings.tab_button_color %}
{% assign tab_button_active_color     = section.settings.tab_button_active_color %}
{% assign tab_background_color        = section.settings.tab_button_background %}
{% assign tab_active_background_color = section.settings.tab_button_active_background %}
{% assign background_color            = section.settings.background_color %}

{% assign active_tab                  = 1 %}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{% if section.blocks.size > 0 %}
	{% assign text_content_delay = "tr-del-1-25" %}
{% else %}
	{% assign text_content_delay = "tr-del-0-5" %}
{% endif %}

{% capture section_styles %}
	--button-active-color: {{ tab_button_active_color }}; {{- -}}
	--label-color: {{ label_color }}; {{- -}}
	--text-color: {{ text_color }}; {{- -}}
	--tab-color: {{ tab_button_color }}; {{- -}}
	--tab-active-color: {{ tab_button_active_color }}; {{- -}}
	--tab-background-color: {{ tab_background_color }}; {{- -}}
	--tab-active-background-color: {{ tab_active_background_color }}; {{- -}}
	--background-color: {{ background_color }}; {{- -}}
	--container-width: {{ container_width }}; {{- -}}
{% endcapture %}

{% if section.blocks.size > 0 %}
	<section class="banner-with-tabs {% if container_width == '100%' %}banner-with-tabs--full-width{% endif %} js-banner-with-tabs-container need-animate js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}" style="{{ section_styles | strip_newlines }}">
		<div class="banner-with-tabs__content">
			{% unless label == blank and heading == blank and text == blank %}
				<div class="banner-with-tabs__container need-animate tr-dur-0-5 {{ text_content_delay }}">
					{% if label != blank %}
						<h2 class="banner-with-tabs__label">{{ label }}</h2>
					{% endif %}

					{% if heading != blank %}
						<span class="banner-with-tabs__heading h2">{{ heading }}</span>
					{% endif %}

					{% if text != blank %}
						<div class="banner-with-tabs__text rte">{{ text }}</div>
					{% endif %}
				</div>
			{% endunless %}

			<ul class="banner-with-tabs__buttons js-banner-with-tabs-buttons-wrapper">
				{% assign delay_step = 0.5 %}

				{% for tab in section.blocks %}
					{% assign heading   	= tab.settings.heading | default: "Tab" %}
					{% assign is_active 	= false %}
					{% assign delay_step 	= delay_step | plus: 0.25 %}

					{% if forloop.index == active_tab %}
						{% assign is_active = true %}
					{% endif %}

					<li>
						<button
							class="banner-with-tabs__button need-animate tr-dur-0-5 js-tab-button {% if is_active %}banner-with-tabs__button--active{% endif %}"
							style="transition-delay: {{ delay_step | append: 's' }}"
						>
							{{- heading -}}
						</button>
					</li>
				{% endfor %}
			</ul>
		</div>

		{% for block in section.blocks %}
			{% assign image_desktop      = block.settings.image_desktop %}
			{% assign image_mobile       = block.settings.image_mobile | default: image_desktop %}
			{% assign html_video_desktop = block.settings.html_video_desktop %}
			{% assign html_video_mobile  = block.settings.html_video_mobile | default: html_video_desktop %}
			{% assign video_url_desktop  = block.settings.video_url_desktop %}
			{% assign video_url_mobile   = block.settings.video_url_mobile | default: video_url_desktop %}
			{% assign media_type         = block.settings.media_type %}
			{% assign is_active          = false %}

			{% if forloop.index == active_tab %}
				{% assign is_active = true %}
			{% endif %}

			{%- capture img_focal -%}
				--img-desktop-pos: {{ image_desktop.presentation.focal_point }};
				--img-mob-pos: {{ image_mobile.presentation.focal_point }};
			{%- endcapture -%}

			<div
				class="banner-with-tabs__aspect-ratio js-media-container {% unless is_active %}is-hidden{% endunless %}">
				{% if media_type == "image" %}
					{% if image_desktop != blank %}
						<picture class="lazy">
							<source
								srcset="{{ image_mobile | img_url: "10x", crop: "center" }} 1x, {{ image_mobile | img_url: "20x", crop: "center" }} 2x"
								data-srcset="{{ image_mobile | img_url: '375x221', crop: "center" }} 1x, {{ image_mobile | img_url: '750x442', crop: "center" }} 2x"
								media="(max-width: 375px)"
							/>

							<source
								srcset="{{ image_mobile | img_url: "10x", crop: "center" }} 1x, {{ image_mobile | img_url: "20x", crop: "center" }} 2x"
								data-srcset="{{ image_mobile | img_url: '420x247', crop: "center" }} 1x, {{ image_mobile | img_url: '840x494', crop: "center" }} 2x"
								media="(max-width: 420px)"
							/>

							<source
								srcset="{{ image_mobile | img_url: "10x", crop: "center" }} 1x, {{ image_mobile | img_url: "20x", crop: "center" }} 2x"
								data-srcset="{{ image_mobile | img_url: '575x339', crop: "center" }} 1x, {{ image_mobile | img_url: '1150x678', crop: "center" }} 2x"
								media="(max-width: 575px)"
							/>

							<source
								srcset="{{ image_mobile | img_url: "10x", crop: "center" }} 1x, {{ image_mobile | img_url: "20x", crop: "center" }} 2x"
								data-srcset="{{ image_mobile | img_url: '767x452', crop: "center" }} 1x, {{ image_mobile | img_url: '1534x904', crop: "center" }} 2x"
								media="(max-width: 767px)"
							/>

							<source
								srcset="{{ image_desktop | img_url: "10x", crop: "center" }} 1x, {{ image_desktop | img_url: "20x", crop: "center" }} 2x"
								data-srcset="{{ image_desktop | img_url: '991x584', crop: "center" }} 1x, {{ image_desktop | img_url: '1982x1168', crop: "center" }} 2x"
								media="(max-width: 991px)"
							/>

							<source
								srcset="{{ image_desktop | img_url: "10x", crop: "center" }} 1x, {{ image_desktop | img_url: "20x", crop: "center" }} 2x"
								data-srcset="{{ image_desktop | img_url: '1500x645', crop: "center" }} 1x, {{ image_desktop | img_url: '3000x1290', crop: "center" }} 2x"
								media="(max-width: 1500px)"
							/>

							<img
								srcset="{{ image_desktop | img_url: "10x", crop: "center" }} 1x, {{ image_desktop | img_url: "20x", crop: "center" }} 2x"
								src="{{ image_desktop | img_url: "10x", crop: "center" }}"
								class="banner-with-tabs__image"
								data-src="{{ image_desktop | img_url: '1952x839', crop: "center" }}"
								data-srcset="{{ image_desktop | img_url: '1952x839', crop: "center" }} 1x, {{ image_desktop | img_url: '3904x1678', crop: "center" }} 2x"
								{% if img_focal != blank %}
									style="{{ img_focal }}"
								{% endif %}
								alt="{{ image_desktop.alt | escape }}">
						</picture>
					{% else %}
						{{ "lifestyle-2" | placeholder_svg_tag: "banner-with-tabs__image banner-with-tabs__placeholder-background" }}
					{% endif %}
				{% elsif media_type == "html_video" %}
					{% if html_video_desktop != blank %}
						<video data-device="desktop" data-type="html"
							   autoplay muted controls
							   class="banner-with-tabs__media banner-with-tabs__media--desktop js-banner-with-tabs-video js-video"
							   tabindex="-1"
							   playsinline>
							{% for video_source in html_video_desktop.sources %}
								{%- if video_source.mime_type == 'video/mp4' -%}
									<source
										src="{{ video_source.url }}"
										type="{{ video_source.mime_type }}"
									>
								{%- endif -%}
							{% endfor %}
							Your browser doesn't support HTML5 video tag.
						</video>

						<video data-device="mobile" data-type="html" autoplay muted controls
							   class="banner-with-tabs__media banner-with-tabs__media--mobile js-banner-with-tabs-video js-video"
							   tabindex="-1"
							   playsinline>
							{% for video_source in html_video_mobile.sources %}
								{%- if video_source.mime_type == 'video/mp4' -%}
									<source
										src="{{ video_source.url }}"
										type="{{ video_source.mime_type }}"
									>
								{%- endif -%}
							{% endfor %}
							Your browser doesn't support HTML5 video tag.
						</video>
					{% else %}
						{{ "lifestyle-2" | placeholder_svg_tag: "banner-with-tabs__media" }}
					{% endif %}
				{% else %}
					{% if video_url_desktop != blank %}
						{% if video_url_desktop.type == 'youtube' %}
							<div
								class="banner-with-tabs__media banner-with-tabs__media--desktop js-banner-with-tabs-video js-video"
								data-device="desktop"
								data-type="{{ video_url_desktop.type }}"
								data-autoplay="{{ true }}"
							>
								<div
									class="js-video-youtube"
									data-video-id="{{ video_url_desktop.id }}"
									tabindex="-1"
									aria-hidden="true"
								></div>
							</div>
						{% else %}
							<div
								class="banner-with-tabs__media banner-with-tabs__media--desktop js-banner-with-tabs-video js-video"
								data-device="desktop"
								data-video-id="{{ video_url_desktop.id }}"
								data-type="{{ video_url_desktop.type }}"
								aria-hidden="true"
								data-autoplay="{{ true }}"
							></div>
						{% endif %}

						{% if video_url_mobile.type == 'youtube' %}
							<div
								class="banner-with-tabs__media banner-with-tabs__media--mobile js-banner-with-tabs-video js-video"
								data-device="mobile"
								data-type="{{ video_url_mobile.type }}"
								data-autoplay="{{ true }}"
							>
								<div
									class="js-video-youtube"
									data-video-id="{{ video_url_mobile.id }}"
									tabindex="-1"
									aria-hidden="true"
								></div>
							</div>
						{% else %}
							<div
								class="banner-with-tabs__media banner-with-tabs__media--mobile js-banner-with-tabs-video js-video"
								data-device="mobile"
								data-video-id="{{ video_url_mobile.id }}"
								data-type="{{ video_url_mobile.type }}"
								aria-hidden="true"
								data-autoplay="{{ true }}"
							></div>
						{% endif %}
					{% else %}
						{{ "lifestyle-2" | placeholder_svg_tag: "banner-with-tabs__media" }}
					{% endif %}
				{% endif %}
			</div>
		{% endfor %}
	</section>

	{% render 'adastra' with '/src/styles/banner-with-tabs.scss' %}
	{% render 'adastra' with '/src/scripts/banner-with-tabs.js' %}
{% endif %}

{% schema %}
{
	"name": "Banner with thumbnails",
	"disabled_on": {
		"groups": [
			"header",
			"footer"
		]
	},
	"settings": [
		{
			"type": "text",
			"id": "label",
			"label": "Label",
			"default": "Label"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Heading"
		},
		{
			"type": "richtext",
			"id": "text",
			"label": "Text",
			"default": "<p>Text</p>"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background",
			"default": "#000"
		},
		{
			"type": "color",
			"id": "label_color",
			"label": "Label",
			"default": "#4D71F9"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "tab_button_active_background",
			"label": "Tab button background (active)",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "tab_button_active_color",
			"label": "Tab button color (active)",
			"default": "#000"
		},
		{
			"type": "color",
			"id": "tab_button_background",
			"label": "Tab button background",
			"default": "#000"
		},
		{
			"type": "color",
			"id": "tab_button_color",
			"label": "Tab button color",
			"default": "#9D9D9D"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "1952px",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"blocks": [
		{
			"name": "Tab",
			"type": "tab",
			"limit": 6,
			"settings": [
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "Tab"
				},
				{
					"type": "select",
					"id": "media_type",
					"label": "Media type",
					"options": [
						{
							"value": "image",
							"label": "Image"
						},
						{
							"value": "html_video",
							"label": "HTML5 video"
						},
						{
							"value": "youtube_vimeo",
							"label": "YouTube/Vimeo"
						}
					],
					"default": "image"
				},
				{
					"type": "image_picker",
					"id": "image_desktop",
					"label": "Image desktop",
					"info": "Applicable to ‘Image’ media type."
				},
				{
					"type": "image_picker",
					"id": "image_mobile",
					"label": "Image mobile",
					"info": "Applicable to ‘Image’ media type."
				},
				{
					"type": "video",
					"id": "html_video_desktop",
					"label": "HTML5 desktop video",
					"info": "Applicable to 'HTML5 video' media type."
				},
				{
					"type": "video",
					"id": "html_video_mobile",
					"label": "HTML5 mobile video",
					"info": "Applicable to 'HTML5 video' media type."
				},
				{
					"type": "video_url",
					"id": "video_url_desktop",
					"label": "Youtube/Vimeo desktop video url",
					"accept": [
						"youtube",
						"vimeo"
					],
					"info": "Applicable to 'Youtube/Vimeo' media type."
				},
				{
					"type": "video_url",
					"id": "video_url_mobile",
					"label": "Youtube/Vimeo mobile video url",
					"accept": [
						"youtube",
						"vimeo"
					],
					"info": "Applicable to 'Youtube/Vimeo' media type."
				}
			]
		}
	],
	"presets": [
		{
			"name": "Banner with thumbnails",
			"settings": {},
			"blocks": [
				{
					"type": "tab",
					"settings": {
						"heading": "Tab 1"
					}
				},
				{
					"type": "tab",
					"settings": {
						"heading": "Tab 2"
					}
				}
			]
		}
	]
}
{% endschema %}

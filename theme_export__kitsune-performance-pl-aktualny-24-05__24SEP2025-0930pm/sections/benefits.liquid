{%- comment -%}
------------------------------------------------------------------------------
	Section: Benefits
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign heading 					= section.settings.heading -%}
{%- assign enable_cards_indent 		= section.settings.enable_cards_indent -%}
{%- assign container 				= section.settings.container_width -%}
{%- assign background_image     	= section.settings.background_image -%}
{%- assign section_background     	= section.settings.section_background -%}
{%- assign heading_color     		= section.settings.heading_color -%}
{%- assign block_background     	= section.settings.block_background -%}
{%- assign block_heading_color 		= section.settings.block_heading_color -%}
{%- assign block_text_color 		= section.settings.block_text_color -%}
{%- assign block_link_color 		= section.settings.block_link_color -%}
{%- assign block_link_hover_color 	= section.settings.block_link_hover_color -%}

{%- if container == 'inherit' -%}
	{%- assign container_width = settings.container_width -%}
{%- else -%}
	{%- assign container_width = container -%}
{%- endif -%}

{%- assign lazy_load = true -%}

{%- if section.index == 1 -%}
	{%- assign lazy_load = false -%}
{%- endif -%}

{%- capture section_styles -%}
	--container-width: {{ container_width }}; {{-  -}}
	{% unless enable_cards_indent %}
		--section-background: {{ section_background }}; {{-  -}}
		--heading-color: {{ heading_color }}; {{-  -}}
	{% endunless %}
	--block-background: {{ block_background }}; {{-  -}}
	--block-heading-color: {{ block_heading_color }}; {{-  -}}
	--block-text-color: {{ block_text_color }}; {{-  -}}
	--block-link-color: {{ block_link_color }}; {{-  -}}
	--block-link-hover-color: {{ block_link_hover_color }}; {{-  -}}
{%- endcapture -%}

{%- if section.blocks.size > 0 -%}
	{% assign delay_step = 0.25 %}

	{%- capture benefits -%}
		<div class="benefits__row-wrapper swiper js-benefits-slider">
			<ul class="benefits__row swiper-wrapper">
				{%- for block in section.blocks -%}
					{%- assign block_heading 	= block.settings.heading -%}
					{%- assign text			 	= block.settings.text -%}
					{%- assign image		 	= block.settings.image -%}
					{%- assign button_link	 	= block.settings.button_link -%}
					{%- assign button_label	 	= block.settings.button_label -%}
					{%- assign delay_step 		= delay_step | plus: 0.25 -%}

					{%- if block_heading != blank or text != blank -%}
						<li class="benefits__col swiper-slide need-animate tr-dur-0-5 js-benefits-slide" style="transition-delay: {{ delay_step | append: 's' }};">
							{% if image != blank %}
								<div class="benefits__icon-wrapper">
									<img
										class="benefits__icon"
										srcset="{{ image | img_url: '64x' }} 1x, {{ image | img_url: '128x' }} 2x"
										src="{{- image | img_url: '64x' -}}"
										alt="{{- image.alt | escape -}}"
										loading="lazy"
									>
								</div>
							{% endif %}

							{%- if block_heading != blank -%}
								<div class="benefits__column-heading h4">
									{{- block_heading -}}
								</div>
							{%- endif -%}

							{%- if text != blank -%}
								<p class="benefits__column-text">
									{{- text -}}
								</p>
							{%- endif -%}

							{% if button_link != blank and button_label != blank %}
								<a href="{{ button_link }}" class="button-link-chevron benefits__button"

								>
									{{- button_label -}}

									{% render 'icons', icon: 'arrow-right' %}
								</a>
							{% endif %}
						</li>
					{%- endif -%}
				{%- endfor -%}
			</ul>

			<div class="benefits__pagination js-benefits-slider-pagination"></div>
		</div>
	{%- endcapture -%}
{%- endif -%}

{%- if benefits != blank -%}
	{%- render 'adastra' with '/src/styles/benefits.scss' -%}

	{%- style -%}
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_mobile -}}px;
			padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
		}

		@media screen and (min-width: 768px) {
			#shopify-section-{{- section.id -}} {
				padding-top: {{- section.settings.offset_top_desktop -}}px;
				padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
			}
		}
	{%- endstyle -%}

	<section class="benefits{% if request.visual_preview_mode or section.index == 1 %} animated{% endif %}{% unless enable_cards_indent %} benefits--no-indent{% endunless %} js-animate js-benefits-section" style="{{- section_styles -}}">
		{%- if enable_cards_indent == false and background_image != blank -%}
			{%- assign size_image_width 		= 1920 -%}
			{%- assign size_image_height 		= 240 -%}
			{%- assign size_image_width_2x 		= size_image_width | times: 2 -%}
			{%- assign size_image_height_2x 	= size_image_height | times: 2 -%}

			{%- assign size_image_width_1500 		= 1500 -%}
			{%- assign size_image_height_1500 		= 240 -%}
			{%- assign size_image_width_1500_2x 	= size_image_width_1500 | times: 2 -%}
			{%- assign size_image_height_1500_2x 	= size_image_height_1500 | times: 2 -%}

			{%- assign size_image_width_1199 		= 1199 -%}
			{%- assign size_image_height_1199 		= 350 -%}
			{%- assign size_image_width_1199_2x 	= size_image_width_1199 | times: 2 -%}
			{%- assign size_image_height_1199_2x 	= size_image_height_1199 | times: 2 -%}

			{%- assign size_image_width_991 		= 991 -%}
			{%- assign size_image_height_991 		= 350 -%}
			{%- assign size_image_width_991_2x 		= size_image_width_991 | times: 2 -%}
			{%- assign size_image_height_991_2x 	= size_image_height_991 | times: 2 -%}

			{%- assign size_image_width_767 		= 767 -%}
			{%- assign size_image_height_767 		= 538 -%}
			{%- assign size_image_width_767_2x 		= size_image_width_767 | times: 2 -%}
			{%- assign size_image_height_767_2x 	= size_image_height_767 | times: 2 -%}

			{%- assign size_image_width_420 		= 420 -%}
			{%- assign size_image_height_420 		= 241 -%}
			{%- assign size_image_width_420_2x 		= size_image_width_420 | times: 2 -%}
			{%- assign size_image_height_420_2x 	= size_image_height_420 | times: 2 -%}

			{%- assign size_image_width_375 		= 375 -%}
			{%- assign size_image_height_375 		= 241 -%}
			{%- assign size_image_width_375_2x 		= size_image_width_375 | times: 2 -%}
			{%- assign size_image_height_375_2x 	= size_image_height_375 | times: 2 -%}

			{%- capture img_focal -%}
				--img-pos: {{ background_image.presentation.focal_point }};
			{%- endcapture -%}

			<picture {% if lazy_load %}class="lazy"{% endif %}>
				<source
					{% if lazy_load %}
						data-srcset="{{ background_image | image_url: width: size_image_width_375, height: size_image_height_375 }} 1x
							 	 	 {{ background_image | image_url: width: size_image_width_375_2x, height: size_image_height_375_2x }} 2x"
						srcset="{{ background_image | image_url: width: 10, height: 10 }} 1x
							 	{{ background_image | image_url: width: 20, height: 20 }} 2x"
					{% else %}
						srcset="{{ background_image | image_url: width: size_image_width_375, height: size_image_height_375 }} 1x
							 	{{ background_image | image_url: width: size_image_width_375_2x, height: size_image_height_375_2x }} 2x"
					{% endif %}
					media="(max-width: 375px)"
					width="{{- size_image_width_375 -}}"
					height="{{- size_image_height_375 -}}"
				>

				<source
					{% if lazy_load %}
						data-srcset="{{ background_image | image_url: width: size_image_width_420, height: size_image_height_420 }} 1x
							 	 	 {{ background_image | image_url: width: size_image_width_420_2x, height: size_image_height_420_2x }} 2x"
						srcset="{{ background_image | image_url: width: 10, height: 10 }} 1x
							 	{{ background_image | image_url: width: 20, height: 20 }} 2x"
					{% else %}
						srcset="{{ background_image | image_url: width: size_image_width_420, height: size_image_height_420 }} 1x
							 	{{ background_image | image_url: width: size_image_width_420_2x, height: size_image_height_420_2x }} 2x"
					{% endif %}
					media="(max-width: 420px)"
					width="{{- size_image_width_420 -}}"
					height="{{- size_image_height_420 -}}"
				>

				<source
					{% if lazy_load %}
						data-srcset="{{ background_image | image_url: width: size_image_width_767, height: size_image_height_767 }} 1x
							 	 	 {{ background_image | image_url: width: size_image_width_767_2x, height: size_image_height_767_2x }} 2x"
						srcset="{{ background_image | image_url: width: 10, height: 10 }} 1x
							 	{{ background_image | image_url: width: 20, height: 20 }} 2x"
					{% else %}
						srcset="{{ background_image | image_url: width: size_image_width_767, height: size_image_height_767 }} 1x
							 	{{ background_image | image_url: width: size_image_width_767_2x, height: size_image_height_767_2x }} 2x"
					{% endif %}
					media="(max-width: 767px)"
					width="{{- size_image_width_767 -}}"
					height="{{- size_image_height_767 -}}"
				>

				<source
					{% if lazy_load %}
						data-srcset="{{ background_image | image_url: width: size_image_width_991, height: size_image_height_991 }} 1x
							 	 	 {{ background_image | image_url: width: size_image_width_991_2x, height: size_image_height_991_2x }} 2x"
						srcset="{{ background_image | image_url: width: 10, height: 10 }} 1x
							 	{{ background_image | image_url: width: 20, height: 20 }} 2x"
					{% else %}
						srcset="{{ background_image | image_url: width: size_image_width_991, height: size_image_height_991 }} 1x
							 	{{ background_image | image_url: width: size_image_width_991_2x, height: size_image_height_991_2x }} 2x"
					{% endif %}
					media="(max-width: 991px)"
					width="{{- size_image_width_991 -}}"
					height="{{- size_image_height_991 -}}"
				>

				<source
					{% if lazy_load %}
						data-srcset="{{ background_image | image_url: width: size_image_width_1199, height: size_image_height_1199 }} 1x
							 	 	 {{ background_image | image_url: width: size_image_width_1199_2x, height: size_image_height_1199_2x }} 2x"
						srcset="{{ background_image | image_url: width: 10, height: 10 }} 1x
							 	{{ background_image | image_url: width: 20, height: 20 }} 2x"
					{% else %}
						srcset="{{ background_image | image_url: width: size_image_width_1199, height: size_image_height_1199 }} 1x
							 	{{ background_image | image_url: width: size_image_width_1199_2x, height: size_image_height_1199_2x }} 2x"
					{% endif %}
					media="(max-width: 1199px)"
					width="{{- size_image_width_1199 -}}"
					height="{{- size_image_height_1199 -}}"
				>

				<source
					{% if lazy_load %}
						data-srcset="{{ background_image | image_url: width: size_image_width_1500, height: size_image_height_1500 }} 1x
							 	 	 {{ background_image | image_url: width: size_image_width_1500_2x, height: size_image_height_1500_2x }} 2x"
						srcset="{{ background_image | image_url: width: 10, height: 10 }} 1x
							 	{{ background_image | image_url: width: 20, height: 20 }} 2x"
					{% else %}
						srcset="{{ background_image | image_url: width: size_image_width_1500, height: size_image_height_1500 }} 1x
							 	{{ background_image | image_url: width: size_image_width_1500_2x, height: size_image_height_1500_2x }} 2x"
					{% endif %}
					media="(max-width: 1500px)"
					width="{{- size_image_width_1500 -}}"
					height="{{- size_image_height_1500 -}}"
				>

				<img class="benefits__bg-image"
					 {% if lazy_load %}
						 data-src="{{ background_image | image_url: width: size_image_width, height: size_image_height }}"
						 data-srcset="{{ background_image | image_url: width: size_image_width, height: size_image_height }} 1x
							 	 	  {{ background_image | image_url: width: size_image_width_2x, height: size_image_height_2x }} 2x"
						 src="{{ background_image | image_url: width: 10, height: 10 }}"
						 srcset="{{ background_image | image_url: width: 10, height: 10 }} 1x
							 	 {{ background_image | image_url: width: 20, height: 20 }} 2x"
					 {% else %}
						 src="{{ background_image | image_url: width: size_image_width, height: size_image_height }}"
						 srcset="{{ background_image | image_url: width: size_image_width, height: size_image_height }} 1x
							 	 {{ background_image | image_url: width: size_image_width_2x, height: size_image_height_2x }} 2x"
					 {% endif %}
					 alt="{{- background_image.alt | escape -}}"
					 width="{{- size_image_width -}}"
					 height="{{- size_image_height -}}"
					 style="{{ img_focal }}"
				>
			</picture>
		{%- endif -%}

		<div class="benefits__container">
			<h2 class="benefits__heading">
				{{- heading -}}
			</h2>

			{{- benefits -}}
		</div>
	</section>

	{%- render 'adastra' with '/src/scripts/section-benefits.js' -%}
{%- endif -%}

{%- schema -%}
{
	"name": "Our benefits",
	"max_blocks": 4,
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Heading"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "image_picker",
			"id": "background_image",
			"label": "Background image",
			"info": "Image will be shown only if the cards indents are disabled."
		},
		{
			"type": "color",
			"id": "section_background",
			"label": "Section background",
			"default": "#ffffff",
			"info": "The background color will be set only if indents under cards are turned off."
		},
		{
			"type": "color",
			"id": "heading_color",
			"label": "Heading",
			"default": "#000000",
			"info": "The color will be set only if indents under the cards are turned off."
		},
		{
			"type": "color",
			"id": "block_background",
			"label": "Block background",
			"default": "#F1F1F3"
		},
		{
			"type": "color",
			"id": "block_heading_color",
			"label": "Block heading",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "block_text_color",
			"label": "Block text",
			"default": "#535353"
		},
		{
			"type": "color",
			"id": "block_link_color",
			"label": "Block link",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "block_link_hover_color",
			"label": "Block link (hover)",
			"default": "#4d71f9"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "checkbox",
			"id": "enable_cards_indent",
			"label": "Enable cards indents",
			"default": true
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"blocks": [
		{
			"type": "benefits_item",
			"name": "Item",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "Icon",
					"info": "64 x 64px .svg recommended"
				},
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "Heading"
				},
				{
					"type": "inline_richtext",
					"id": "text",
					"label": "Text",
					"default": "Text"
				},
				{
					"type": "text",
					"id": "button_label",
					"label": "Link label",
					"default": "Learn More"
				},
				{
					"type": "url",
					"id": "button_link",
					"label": "Link URL"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Our benefits",
			"settings": {
				"heading": "Heading"
			},
			"blocks": [
				{
					"type": "benefits_item"
				},
				{
					"type": "benefits_item"
				},
				{
					"type": "benefits_item"
				},
				{
					"type": "benefits_item"
				}
			]
		}
	]
}
{%- endschema -%}

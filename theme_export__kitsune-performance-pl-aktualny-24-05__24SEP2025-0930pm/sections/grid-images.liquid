{%- comment -%}
------------------------------------------------------------------------------
	Section: Grid images
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/grid-images.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign blocks             	= section.blocks -%}
{%- assign big_image_position 	= section.settings.big_image_position -%}
{%- assign container 			= section.settings.container_width -%}
{%- assign image_delay 			= 0 -%}
{%- assign text_delay 			= 0 -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{% if container_width != '100%' %}
	{% assign section_class = 'grid-images--limited-width' %}
{% endif %}

<section class="grid-images {{ section_class }} js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}" style="--container-width: {{- container_width -}};">
	{%- if blocks.size > 0 -%}
		{%- for block in blocks -%}
			{%- assign heading         	   	= block.settings.heading -%}
			{%- assign text         	   	= block.settings.text -%}
			{%- assign image_desktop 	   	= block.settings.image_desktop -%}
			{%- assign image_mobile  	   	= block.settings.image_mobile | default: image_desktop -%}
			{%- assign url           	   	= block.settings.url -%}
			{%- assign overlay_color 	   	= block.settings.overlay_color -%}
			{%- assign text_color    	   	= block.settings.text_color -%}
			{%- assign overlay_opacity     	= block.settings.overlay -%}
			{%- assign image_delay 			= image_delay | plus: 0.25 -%}
			{%- assign text_delay 			= text_delay | plus: 0.5 -%}

			{%- capture styles -%}
				--overlay-color: {{- overlay_color -}};
				--overlay-opacity: {{- overlay_opacity -}}%;
				--text-color: {{- text_color -}};
			{%- endcapture -%}

			{%- capture img_focal -%}
				--img-desktop-pos: {{ image_desktop.presentation.focal_point }}; --img-mob-pos: {{ image_mobile.presentation.focal_point }};
			{%- endcapture -%}

			{%- capture grid_images_info -%}
				{%- if label != blank or heading != blank -%}
					<div class="grid-images__info need-animate tr-dur-0-5" style="transition-delay: {{ text_delay | append: 's' }};">
						{%- if heading != blank -%}
							<h2 class="h2 grid-images__heading">
								{{- heading -}}
							</h2>
						{%- endif -%}

						{%- if text != blank -%}
							<p class="grid-images__text">
								{{- text -}}
							</p>
						{%- endif -%}
					</div>
				{%- endif -%}
			{%- endcapture -%}

			{%- if blocks.size == 1 -%}
				{%- if image_desktop != blank -%}
					<div
						class="grid-images__col grid-images__col--full-width"
						style="{{- styles -}}"
					>
						{% if url != blank %}
					<a
						class="grid-images__image-container grid-images__image-container--hover need-animate"
						style="transition-delay: {{ image_delay | append: 's' }};"
						href="{{- url -}}"
						aria-label="{{- heading | escape -}}"
					>
						{% else %}
							<div class="grid-images__image-container need-animate" style="transition-delay: {{ image_delay | append: 's' }};">
						{% endif %}

							<picture class="lazy">
								<source
									data-srcset="{{ image_mobile | img_url: '375x' }} 1x, {{ image_mobile | img_url: '750x' }} 2x"
									srcset="{{ image_mobile | img_url: '10x' }} 1x, {{ image_mobile | img_url: '10x' }} 2x"
									media="(max-width: 375px)"
									width="375"
									height="480"
								/>

								<source
									data-srcset="{{ image_mobile | img_url: '480x' }} 1x, {{ image_mobile | img_url: '960x' }} 2x"
									srcset="{{ image_mobile | img_url: '10x' }} 1x, {{ image_mobile | img_url: '10x' }} 2x"
									media="(max-width: 480px)"
									width="480"
									height="614"
								/>

								<source
									data-srcset="{{ image_mobile | img_url: '575x' }} 1x, {{ image_mobile | img_url: '1150x' }} 2x"
									srcset="{{ image_mobile | img_url: '10x' }} 1x, {{ image_mobile | img_url: '10x' }} 2x"
									media="(max-width: 575px)"
									width="575"
									height="736"
								/>

								<source
									data-srcset="{{ image_mobile | img_url: '767x' }} 1x, {{ image_mobile | img_url: '1534x' }} 2x"
									srcset="{{ image_mobile | img_url: '10x' }} 1x, {{ image_mobile | img_url: '10x' }} 2x"
									media="(max-width: 767px)"
									width="767"
									height="982"
								/>

								<source
									data-srcset="{{ image_desktop | img_url: '991x' }} 1x, {{ image_desktop | img_url: '1982x' }} 2x"
									srcset="{{ image_desktop | img_url: '10x' }} 1x, {{ image_desktop | img_url: '10x' }} 2x"
									media="(max-width: 991px)"
									width="991"
									height="364"
								/>

								<img
									class="grid-images__image"
									data-src="{{- image_desktop | img_url: '1920x' -}}"
									data-srcset="{{ image_desktop | img_url: "1920x" }} 1x, {{ image_desktop | img_url: "3840x" }} 2x"
									srcset="{{ image_desktop | img_url: '10x' }} 1x, {{ image_desktop | img_url: '20x' }} 2x"
									src="{{- image_desktop | img_url: "10x" -}}"
									alt="{{- image_desktop.alt | escape -}}"
									width="1920"
									height="706"
									style="{{ img_focal }}"
								/>
							</picture>

							<noscript>
								<picture>
									<source
										srcset="{{ image_mobile | img_url: '375x' }} 1x, {{ image_mobile | img_url: '750x' }} 2x"
										media="(max-width: 375px)"
										width="375"
										height="480"
									/>

									<source
										srcset="{{ image_mobile | img_url: '480x' }} 1x, {{ image_mobile | img_url: '960x' }} 2x"
										media="(max-width: 480px)"
										width="480"
										height="614"
									/>

									<source
										srcset="{{ image_mobile | img_url: '575x' }} 1x, {{ image_mobile | img_url: '1150x' }} 2x"
										media="(max-width: 575px)"
										width="575"
										height="736"
									/>

									<source
										srcset="{{ image_mobile | img_url: '767x' }} 1x, {{ image_mobile | img_url: '1534x' }} 2x"
										media="(max-width: 767px)"
										width="767"
										height="982"
									/>

									<source
										srcset="{{ image_desktop | img_url: '991x' }} 1x, {{ image_desktop | img_url: '1982x' }} 2x"
										media="(max-width: 991px)"
										width="991"
										height="364"
									/>

									<img
										class="grid-images__image"
										srcset="{{ image_desktop | img_url: '1920x' }} 1x, {{ image_desktop | img_url: '3840x' }} 2x"
										src="{{- image_desktop | img_url: "10x" -}}"
										alt="{{- image_desktop.alt | escape -}}"
										width="1920"
										height="706"
										style="{{ img_focal }}"
									/>
								</picture>
							</noscript>

							{{- grid_images_info -}}
						{% if url != blank %}
							</a>
						{% else %}
							</div>
						{% endif %}

					</div>
				{% else %}
					<div class="grid-images__col grid-images__col--full-width" style="{{- styles -}}">
						<div class="grid-images__image-container need-animate" style="transition-delay: {{ image_delay | append: 's' }};">
							{{- "lifestyle-1" | placeholder_svg_tag: "grid-images__image" -}}

							{{- grid_images_info -}}
						</div>
					</div>
				{%- endif -%}

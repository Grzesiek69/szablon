{%- assign currency_code_enabled	= settings.is_currency_code_enabled -%}
{%- assign show_unit_price			= settings.is_show_unit_price -%}

{%- assign preview_4_product 		= section.settings.preview_4_product  -%}
{%- assign label 			        = section.settings.label -%}
{%- assign heading 			        = section.settings.heading -%}
{%- assign text 			        = section.settings.text -%}
{%- assign button_text 		        = section.settings.button_text -%}
{%- assign button_url 		        = section.settings.button_url -%}
{%- assign button_style 	        = section.settings.button_style -%}
{%- assign container 		        = section.settings.container_width -%}
{%- assign blocks 			        = section.blocks -%}

{%- assign min	= 1 -%}
{%- assign max	= 6 -%}
{%- assign diff	= max | minus: min -%}

{%- if button_text != blank and button_url != blank -%}
	{%- assign show_button = true -%}
{%- endif -%}

{%- if label != blank or heading != blank or text != blank or show_button -%}
	{%- assign show_sidebar = true -%}
{%- endif -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{% if container_width != '100%' %}
	{% assign section_class = 'compare-slider--limited-width' %}
{% endif %}

{% assign compare_items_count = blocks.size %}

{%- if compare_items_count > 1 -%}
	{%- render 'adastra' with '/src/styles/compare-slider.scss' -%}

	{%- style -%}
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_mobile -}}px;
			padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
		}

		@media screen and (min-width: 768px) {
			#shopify-section-{{- section.id -}} {
				padding-top: {{- section.settings.offset_top_desktop -}}px;
				padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
			}
		}
	{%- endstyle -%}

	<section class="compare-slider {{ section_class }} js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}"
			 style="--container-width: {{ container_width }}; --compare-items-count: {{- compare_items_count -}};"
	>
		<div class="compare-slider__container">
			{%- if show_sidebar -%}
				<div class="compare-slider__col compare-slider__col--sidebar">
					<div class="compare-slider__sidebar need-animate tr-dur-0-75">
						{%- if label != blank -%}
							<p class="compare-slider__label">
								{{- label -}}
							</p>
						{%- endif -%}

						{%- if heading != blank -%}
							<h2 class="compare-slider__title">
								{{- heading -}}
							</h2>
						{%- endif -%}

						{% if text != blank %}
							<div class="compare-slider__text rte">
								{{- text -}}
							</div>
						{%- endif -%}

						{%- if show_button -%}
							<a class="compare-slider__button button button--{{- button_style -}}"
							   href="{{- button_url -}}">
								{{- button_text -}}
							</a>
						{%- endif -%}
					</div>
				</div>
			{%- endif -%}

			<div class="compare-slider__col compare-slider__col--main {% unless show_sidebar %}compare-slider__col--main--full-width{%- endunless -%}">
				<div class="compare-slider__main">
					<div class="compare-slider__items compare-slider-item {% if preview_4_product and compare_items_count >= 4 %}compare-slider__items--with-next{% endif %} {% if compare_items_count == 2 %}compare-slider__items--small{%- endif -%}">
						{% assign delay_image = 0.15 %}

						{%- for block in blocks -%}
							{%- assign product = block.settings.product -%}
							{%- assign image = product.featured_image | default: product.featured_image | default: settings.product_default_image -%}
							{% assign delay_image = delay_image | plus: 0.25 %}

							<div class="compare-slider-item__image-container need-animate" style="transition-delay: {{ delay_image | append: 's' }};">
								{%- if product == blank -%}
									{%- assign random_number = "now" | date: "%N" | modulo: diff | plus: min -%}
									{%- assign placeholer_svg_name = 'product-' | append: random_number -%}

									<div class="compare-slider-item__image-wrapper">
										{{- placeholer_svg_name | placeholder_svg_tag: 'product-card__image' -}}
									</div>
								{%- else -%}
									<a class="compare-slider-item__image-wrapper"
									   href="{{- product.url -}}"
									   aria-label="{{- product.title | escape -}}"
									>
										{%- if compare_items_count == 2 -%}
											{%- assign size				= 478 -%}
										{%- else -%}
											{%- assign size				= 376 -%}
										{%- endif -%}

										{%- assign tablet_size		= 352 -%}
										{%- assign mobile_size		= 240 -%}

										{%- render 'product-card-image',
											product: product,
											image: image,
											is_hover_image: false,
											is_lazy: false,
											size: size,
											tablet_size: tablet_size,
											mobile_size: mobile_size
										-%}
									</a>
								{%- endif -%}
							</div>
						{%- endfor -%}

						{%- for block in blocks -%}
							{%- assign product = block.settings.product -%}

							<div class="compare-slider-item__title need-animate">
								{%- if product != blank -%}
									{{- product.title -}}
								{%- else -%}
									{{- 'products.product_card.product_title' | t -}}
								{%- endif -%}
							</div>
						{%- endfor -%}

						{%- for block in blocks -%}
							{%- assign product = block.settings.product -%}

							<div class="compare-slider-item__info need-animate">
								<span class="visually-hidden">
									{%- if product != blank -%}
										{{- 'products.compare_slider.product_title' | t }} {{ product.title -}}
									{%- else -%}
										{{- 'products.compare_slider.product_title' | t }} {{ 'products.product_card.product_title' | t -}}
									{%- endif -%}
								</span>

								<div class="compare-slider-item__price">
									{%- render 'price', product: product, show_unit_price: show_unit_price, currency_code_enabled: currency_code_enabled -%}
								</div>

								<button
									class="button button--secondary focus-visible-outline js-add-to-cart compare-slider-item__button"
									type="button"
									data-product-handle="{{- product.handle -}}"
									data-min-quantity="{{- product.selected_or_first_available_variant.quantity_rule.min -}}"
									{% if product.has_only_default_variant or product.variants.size == 1 %}
										data-variant-id="{{- product.variants[0].id -}}"
									{% endif %}
									{% unless product.available %}
										disabled
									{% endunless %}
									aria-label="{%- if product.available -%}{{- 'products.product.add_to_cart' | t -}}{%- else -%}{{- 'products.product.sold_out' | t -}}{%- endif -%}"
								>
									{%- render 'icons', icon: 'cart' -%}
								</button>
							</div>
						{%- endfor -%}

						{%- for i in (1..6) -%}
							{%- assign property_label_key = "property_label_" | append: i -%}
							{%- assign property_label = section.settings[property_label_key] -%}

							{%- if property_label != blank -%}
								<div class="compare-slider__item--full compare-slider-item__property-label need-animate"
									 aria-hidden="true">
									{{- property_label -}}
								</div>

								{%- for block in blocks -%}
									{%- assign product = block.settings.product -%}
									{%- assign property_value_key = "property_value_" | append: i -%}
									{%- assign property_value = block.settings[property_value_key] | default: '-' -%}

									<div class="compare-slider-item__property-value need-animate">
										<span class="visually-hidden">
											{%- if product != blank -%}
												{{- 'products.compare_slider.product_title' | t }} {{ product.title -}}
											{%- else -%}
												{{- 'products.compare_slider.product_title' | t }} {{ 'products.product_card.product_title' | t -}}
											{%- endif -%}

											<br>

											{{- 'products.compare_slider.property_label' | t }} {{ property_label -}}

											<br>

											{{- 'products.compare_slider.property_value' | t -}}
										</span>

										<span>
											{{- property_value -}}
										</span>
									</div>
								{% endfor %}
							{%- endif -%}
						{%- endfor -%}
					</div>
				</div>
			</div>
		</div>
	</section>
{%- endif -%}

{%- schema -%}
{
	"name": "Compare slider",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "preview_4_product",
			"label": "Enable 4th product preview",
			"default": false,
			"info": "Only desktop"
		},
		{
			"type": "text",
			"id": "label",
			"label": "Label",
			"default": "Label"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Heading"
		},
		{
			"type": "richtext",
			"id": "text",
			"label": "Text",
			"default": "<p>Text</p>"
		},
		{
			"type": "text",
			"id": "button_text",
			"label": "Button label",
			"default": "Button label"
		},
		{
			"type": "url",
			"id": "button_url",
			"label": "Button link",
			"default": "/"
		},
		{
			"type": "select",
			"id": "button_style",
			"label": "Button style",
			"options": [
				{
					"value": "primary",
					"label": "Primary"
				},
				{
					"value": "secondary",
					"label": "Secondary"
				},
				{
					"value": "primary-border",
					"label": "Primary with border"
				},
				{
					"value": "secondary-border",
					"label": "Secondary with border"
				}
			],
			"default": "secondary-border"
		},
		{
			"type": "text",
			"id": "property_label_1",
			"label": "Property first label",
			"default": "First property"
		},
		{
			"type": "text",
			"id": "property_label_2",
			"label": "Property second label",
			"default": "Second property"
		},
		{
			"type": "text",
			"id": "property_label_3",
			"label": "Property third label",
			"default": "Third property"
		},
		{
			"type": "text",
			"id": "property_label_4",
			"label": "Property fourth label",
			"default": "Fourth property"
		},
		{
			"type": "text",
			"id": "property_label_5",
			"label": "Property fifth label",
			"default": "Fifth property"
		},
		{
			"type": "text",
			"id": "property_label_6",
			"label": "Property sixth label",
			"default": "Sixth property"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"blocks": [
		{
			"name": "Product",
			"type": "product",
			"limit": 6,
			"settings": [
				{
					"type": "product",
					"id": "product",
					"label": "Product"
				},
				{
					"type": "text",
					"id": "property_value_1",
					"label": "Property first value",
					"default": "First property value"
				},
				{
					"type": "text",
					"id": "property_value_2",
					"label": "Property second value",
					"default": "Second property value"
				},
				{
					"type": "text",
					"id": "property_value_3",
					"label": "Property third value",
					"default": "Third property value"
				},
				{
					"type": "text",
					"id": "property_value_4",
					"label": "Property fourth value",
					"default": "Fourth property value"
				},
				{
					"type": "text",
					"id": "property_value_5",
					"label": "Property fifth value",
					"default": "Fifth  property value"
				},
				{
					"type": "text",
					"id": "property_value_6",
					"label": "Property sixth value",
					"default": "Sixth property value"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Compare slider",
			"blocks": [
				{
					"type": "product"
				},
				{
					"type": "product"
				},
				{
					"type": "product"
				},
				{
					"type": "product"
				}
			]
		}
	]
}
{%- endschema -%}

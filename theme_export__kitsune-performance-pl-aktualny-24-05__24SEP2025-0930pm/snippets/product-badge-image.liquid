{% comment %}
------------------------------------------------------------------------------
  Snippet: Product badge logos
------------------------------------------------------------------------------
{% endcomment %}

{%- assign labels_enabled = settings.is_labels_enabled -%}
{%- assign badge_labels   = product.metafields.custom.badge_images -%}

{%- if badge_labels.value.count > 0 and labels_enabled -%}
	{%- capture styles -%}
		--offset-top-desktop: {{ block.settings.offset_top_desktop }}px; {{-  -}}
		--offset-bottom-desktop: {{ block.settings.offset_bottom_desktop }}px; {{-  -}}
		--offset-top-mobile: {{ block.settings.offset_top_mobile }}px; {{-  -}}
		--offset-bottom-mobile: {{ block.settings.offset_bottom_mobile }}px;
	{%- endcapture -%}

	<ul
		class="product-badge-image"
		style="{{- styles -}}"
		aria-label="{{- 'products.product.product_labels' | t | escape -}}"
	>
		{{- labels -}}

		{% for badge_label in badge_labels.value %}
			<li>
				<span class="visually-hidden">
					{{- 'products.product.product_label' | t -}}:
				</span>

				<img
					class="product-badge-image__item"
					src="{{ badge_label | image_url: height: 64 }}"
					srcset="{{ badge_label | image_url: height: 64 }} 1x, {{ badge_label | image_url: height: 128 }} 2x"
					alt="{{ badge_label.alt | escape }}"
				/>
			</li>
		{% endfor %}
	</ul>
{%- endif -%}

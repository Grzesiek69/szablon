{% comment %}
	------------------------------------------------------------------------------
	Snippet: Collection card simple
	- collection: Collection object
	- image: image object
	- menu: Menu object,
	- is_lazy: boolean, enable lazy-load,
	- link_label: text,
	------------------------------------------------------------------------------
{% endcomment %}

{% render "adastra" with '/src/styles/collection-card-simple.scss' %}

{%- capture card_style -%}
	--text-alignment: {{- text_alignment -}}; {{-  -}}
	{% if delay_step %}
		--delay-duration: {{- delay_step | append: "s" -}}; {{-  -}}
	{% endif %}
{%- endcapture -%}

{%- assign min = 1 -%}
{%- assign max = 6 -%}
{%- assign diff = max | minus: min -%}

<div class="collection-card-simple" style="{{- card_style -}}">
	{% if menu != blank or collection == blank %}
		<div class="collection-card-simple__wrapper">
	{% else %}
		<a href="{{- collection.url -}}" class="collection-card-simple__wrapper">
	{% endif %}
			<div class="collection-card-simple__box-image">
				{% if image != blank %}
					<picture class="{% if is_lazy %}lazy{% endif %}">
						<source
							{% if is_lazy %}
								src="{{ image | img_url: '10x10' }}"
								srcset="{{ image | img_url: '10x10' }} 1x,
										{{ image | img_url: '20x20' }} 2x"
								data-src="{{ image | img_url: '316x316', crop: 'center' }}"
								data-srcset="{{ image | img_url: '316x316', crop: 'center' }} 1x,
											{{ image | img_url: '632x632', crop: 'center' }} 2x"
							{% else %}
								src="{{ image | img_url: '316x316', crop: 'center' }}"
								srcset="{{ image | img_url: '316x316', crop: 'center' }} 1x,
											{{ image | img_url: '632x632', crop: 'center' }} 2x"
							{% endif %}
							width="316"
							height="316"
							media="(max-width: 380px)">

						<source
							{% if is_lazy %}
								src="{{ image | img_url: '10x10' }}"
								srcset="{{ image | img_url: '10x10' }} 1x,
										{{ image | img_url: '20x20' }} 2x"
								data-src="{{ image | img_url: '356x356', crop: 'center' }}"
								data-srcset="{{ image | img_url: '356x356', crop: 'center' }} 1x,
											{{ image | img_url: '712x712', crop: 'center' }} 2x"
							{% else %}
								src="{{ image | img_url: '356x356', crop: 'center' }}"
								srcset="{{ image | img_url: '356x356', crop: 'center' }} 1x,
											{{ image | img_url: '712x712', crop: 'center' }} 2x"
							{% endif %}
							width="356"
							height="356"
							media="(max-width: 420px)">

						<source
							{% if is_lazy %}
								src="{{ image | img_url: '10x10' }}"
								srcset="{{ image | img_url: '10x10' }} 1x,
										{{ image | img_url: '20x20' }} 2x"
								data-src="{{ image | img_url: '328x328', crop: 'center' }}"
								data-srcset="{{ image | img_url: '328x328', crop: 'center' }} 1x,
											{{ image | img_url: '656x656', crop: 'center' }} 2x"
							{% else %}
								src="{{ image | img_url: '328x328', crop: 'center' }}"
								srcset="{{ image | img_url: '328x328', crop: 'center' }} 1x,
											{{ image | img_url: '656x656', crop: 'center' }} 2x"
							{% endif %}
							width="328"
							height="328"
							media="(max-width: 767px)">

						<source
							{% if is_lazy %}
								src="{{ image | img_url: '10x10' }}"
								srcset="{{ image | img_url: '10x10' }} 1x,
										{{ image | img_url: '20x20' }} 2x"
								data-src="{{ image | img_url: '440x440', crop: 'center' }}"
								data-srcset="{{ image | img_url: '440x440', crop: 'center' }} 1x,
											{{ image | img_url: '880x880', crop: 'center' }} 2x"
							{% else %}
								src="{{ image | img_url: '440x440', crop: 'center' }}"
								srcset="{{ image | img_url: '440x440', crop: 'center' }} 1x,
											{{ image | img_url: '880x880', crop: 'center' }} 2x"
							{% endif %}
							width="440"
							height="440"
							media="(max-width: 991px)">

						<source
							{% if is_lazy %}
								src="{{ image | img_url: '10x10' }}"
								srcset="{{ image | img_url: '10x10' }} 1x,
										{{ image | img_url: '20x20' }} 2x"
								data-src="{{ image | img_url: '249x249', crop: 'center' }}"
								data-srcset="{{ image | img_url: '249x249', crop: 'center' }} 1x,
											{{ image | img_url: '498x498', crop: 'center' }} 2x"
							{% else %}
								src="{{ image | img_url: '249x249', crop: 'center' }}"
								srcset="{{ image | img_url: '249x249', crop: 'center' }} 1x,
										{{ image | img_url: '498x498', crop: 'center' }} 2x"
							{% endif %}
							width="249"
							height="249"
							media="(max-width: 1500px)">

						<img class="collection-card-simple__image"
							{% if is_lazy %}
								src="{{ image | img_url: '10x10' }}"
								srcset="{{ image | img_url: '10x10' }} 1x,
										{{ image | img_url: '20x20' }} 2x"
								data-src="{{ image | img_url: '333x333', crop: 'center' }}"
								data-srcset="{{ image | img_url: '333x333', crop: 'center' }} 1x,
											{{ image | img_url: '666x666', crop: 'center' }} 2x"
							{% else %}
								src="{{ image | img_url: '333x333', crop: 'center' }}"
								srcset="{{ image | img_url: '333x333', crop: 'center' }} 1x,
										{{ image | img_url: '666x666', crop: 'center' }} 2x"
							{% endif %}
							 alt="{{ image.alt | escape }}"
							 width="333"
							 height="333"
						>
					</picture>
				{% else %}
					<span aria-hidden="true">
						{%- assign random_number = "now" | date: "%N" | modulo: diff | plus: min -%}
						{%- assign placeholder_svg_name = 'collection-' | append: random_number -%}

						{{- placeholder_svg_name | placeholder_svg_tag: 'collection-card-simple__image' -}}
					</span>
				{% endif %}
			</div>
			<div class="collection-card-simple__title">
				{%- if collection != blank -%}
					{{- collection.title -}}
				{%- else -%}
					{{ 'sections.collection_list.card_title' | t }}
				{%- endif -%}
			</div>

			{% if menu != blank %}
				<div class="collection-card-simple__box-links">
					<ul class="collection-card-simple__list">
						{% for link in menu.links %}
							<li class="collection-card-simple__item">
								<a class="collection-card-simple__link" href="{{ link.url }}">{{ link.title }}</a>
							</li>
						{% endfor %}
					</ul>

					{% if link_label != blank %}
						<a href="{{- collection.url -}}" class="button-link-chevron">
							{{- link_label -}}
							{% render 'icons', icon: 'arrow-right' %}
						</a>
					{% endif %}
				</div>
			{% endif %}
	{% if menu != blank or collection == blank %}
		</div>
	{% else %}
		</a>
	{% endif %}
</div>

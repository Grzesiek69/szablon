{%- comment -%}
	------------------------------------------------------------------------------
	Snippet: Header burger menu item
	Render header burger menu item
	- has_nested: has nested menu (true/fasle);
	- link: link object;
	- link_id: link id;
	- level: menu level (1-3);
	- has_brands_mega_menu: has brands mega menu (true/false);
	- wide_drawer: enable wide drawer (true/false);
	- aria_controls: aria controls;
	- badge_text: badge text;
	- badge_text_color: badge text color;
	- badge_background_color: badge background color.

	Usage:
	{%- render 'header-burger-menu-item' -%}
	------------------------------------------------------------------------------
{%- endcomment -%}

{%- if has_nested -%}
	<button
		class="header-burger-menu-item js-multi-drawer-toggle"
		type="button"
		data-drawer-level="{{- level | plus: 1 -}}"
		data-drawer-content="{{- link_id -}}"
		aria-controls="{{- aria_controls -}}"
		aria-expanded="false"
		{%- if has_brands_mega_menu == true %} data-mega-menu-drawer {% endif -%}
		{%- if wide_drawer == true %} data-wide-drawer {% endif -%}
	>
		{% assign item_icon = link.object.metafields.custom.menu_icon %}

		{%- if item_icon != blank -%}
			<span class="header-burger-menu-item__icon-wrapper">
				<picture>
					<img
						class="header-burger-menu-item__icon"
						src="{{ item_icon | image_url: width: 40, height: 40 }}"
						srcset="{{ item_icon | image_url: width: 40, height: 40 }} 1x, {{ item_icon | image_url: width: 80, height: 80 }} 2x"
						alt="{{- item_icon.alt -}}"
					>
				</picture>
			</span>
		{%- endif -%}

		<span class="header-burger-menu-item__text">
			{{- link.title | escape -}}
		</span>

		{%- if badge_text != blank -%}
			<span
				class="header-burger-menu-item__badge"
				style="--header-background: {{ header_bg -}}; --badge-text-color: {{ badge_text_color }}; --badge-background-color: {{ badge_background_color }};"
			>
				{{- badge_text -}}
			</span>
		{%- endif -%}

		<span class="header-burger-menu-item__toggle-icon">
			{%- render 'icons', icon: 'arrow-down' -%}
		</span>
	</button>
{%- else -%}
	<a
		class="header-burger-menu-item"
		href="{{- link.url -}}"
	>
		{% assign item_icon = link.object.metafields.custom.menu_icon %}

		{%- if item_icon != blank -%}
			<span class="header-burger-menu-item__icon-wrapper">
				<picture>
					<img
						class="header-burger-menu-item__icon"
						src="{{ item_icon | image_url: width: 40, height: 40 }}"
						srcset="{{ item_icon | image_url: width: 40, height: 40 }} 1x, {{ item_icon | image_url: width: 80, height: 80 }} 2x"
						alt="{{- item_icon.alt -}}"
					>
				</picture>
			</span>
		{%- endif -%}

		<span class="header-burger-menu-item__text">
			{{- link.title | escape -}}
		</span>
	</a>
{%- endif -%}

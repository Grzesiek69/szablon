						{% else %}
							srcset="{{ image | img_url: '311x460', crop: 'center' }} 1x,
										{{ image | img_url: '622x920', crop: 'center' }} 2x"
						{% endif %}
						media="(max-width: 380px)">

					<source
						{% if is_lazy %}
							data-srcset="{{ image | img_url: '344x508', crop: 'center' }} 1x,
										{{ image | img_url: '688x1016', crop: 'center' }} 2x"
							srcset="{{ image | img_url: '10x' }} 1x,
									{{ image | img_url: '10x' }} 2x"
						{% else %}
							srcset="{{ image | img_url: '344x508', crop: 'center' }} 1x,
										{{ image | img_url: '688x1016', crop: 'center' }} 2x"
						{% endif %}
						media="(max-width: 420px)">

					<source
						{% if is_lazy %}
							data-srcset="{{ image | img_url: '629x928', crop: 'center' }} 1x,
										{{ image | img_url: '1258x1856', crop: 'center' }} 2x"
							srcset="{{ image | img_url: '10x' }} 1x,
									{{ image | img_url: '10x' }} 2x"
						{% else %}
							srcset="{{ image | img_url: '629x928', crop: 'center' }} 1x,
										{{ image | img_url: '1258x1856', crop: 'center' }} 2x"
						{% endif %}
						media="(max-width: 767px)">

					<source
						{% if is_lazy %}
							data-srcset="{{ image | img_url: x1_991, crop: 'center' }} 1x,
										{{ image | img_url: x2_991, crop: 'center' }} 2x"
							srcset="{{ image | img_url: '10x' }} 1x,
									{{ image | img_url: '10x' }} 2x"
						{% else %}

{%- comment -%}
  renders carousel card on section templates
  usage
    {%- render 'carousel-card', card: block, index: forloop.index, height: section_height_class, prefix_class -%}
{%- endcomment -%}
{% liquid
  assign block_scheme_class = card.settings.block_color_scheme | prepend: 'scheme scheme--'
  
  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture

  capture placeholder_image
    if index > 3
      echo 'hero-apparel-1'
      else
        echo 'hero-apparel-' | append: index
    endif
  endcapture

  capture block_heading_size
    case card.settings.heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture block_caption_text_size
    case card.settings.caption_text_size
      when 'heading_medium'
        echo 'h4'
      when 'heading_small'
        echo 'h5'
      when 'heading_x_small'
        echo 'h6'
      else
        echo 'h'
    endcase
  endcapture

  capture content_alignment
    case card.settings.block_content_position
      when 'top_left'
        echo 'tleft'
      when 'top_right'
        echo 'tright'
      when 'centered'
        echo 'mcenter'
      when 'middle_left'
        echo 'mleft'
      when 'middle_right'
        echo 'mright'
      when 'bottom_left'
        echo 'bleft'
      when 'bottom_right'
        echo 'bright'
    endcase
  endcapture

  capture q_justify_mobile
    case card.settings.block_mobile_text_alignment
      when 'left'
        echo 'flex-start'
      when 'center'
        echo 'center'
      when 'right'
        echo 'flex-end'
    endcase
  endcapture

  capture q_justify_desktop
    case card.settings.block_text_alignment
      when 'left'
        echo 'flex-start'
      when 'center'
        echo 'center'
      when 'right'
        echo 'flex-end'
    endcase
  endcapture

  capture max_content_size
    echo settings.page_width | times: card.settings.max_content_size | divided_by: 100
  endcapture

  capture container_class
    if card.settings.container_full
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture

  capture buttons_alignment
    case card.settings.block_text_alignment
      when 'left'
        echo 'desktop-left'
      when 'center'
        echo 'desktop-center'
      when 'right'
        echo 'desktop-right'
    endcase
  endcapture

  capture buttons_alignment_mobile
    case card.settings.block_mobile_text_alignment
      when 'left'
        echo 'mobile-left'
      when 'center'
        echo 'mobile-center'
      when 'right'
        echo 'mobile-right'
    endcase
  endcapture
%}
{%- style -%}
  .{{ prefix_class }}-{{ card.id }}-{{section.id}}{
    --mobile-q-align: {{ card.settings.block_mobile_text_alignment }};
    --mobile-justify-align: {{ q_justify_mobile }};
    --desktop-q-align: {{ card.settings.block_text_alignment }};
    --desktop-justify-align: {{ q_justify_desktop }};
  }
{%- endstyle -%}
<article class="carousel-card {{ prefix_class }}-{{ card.id }}-{{section.id}} --q-align">
  <div class="{{ container_class }} {% if card.settings.increase_container_spaces %}container-spaces{% endif %}">
    <div class="carousel-height {{ height }}">
      <div class="align-holder align-holder--{{ content_alignment }}">
        <div class="align-holder_wrapper {% if section.settings.show_navigation %}align-holder_wrapper--no-padding{% endif %}" style="--max-content: {{ max_content_size }}px;">
          <div class="carousel-card_wrapper {{ block_scheme_class }} {% unless card.settings.enable_container %}carousel-card--no-box{% endunless %}">
            {%- if card.settings.heading != blank or card.settings.description != blank or card.settings.caption != blank -%}
              <header class="heading-head">
                {%- if card.settings.caption != blank -%}
                  <strong class="carousel-card_caption {{ block_caption_text_size }} --word-break mty">
                    {{- card.settings.caption -}}
                  </strong>
                {%- endif -%}
                {%- if card.settings.heading != blank -%}
                  <h2 class="carousel-card_heading {{ block_heading_size }} --h-anchor-none mty">{{- card.settings.heading -}}</h2>
                {%- endif -%}
                {%- if card.settings.description != blank -%}
                  <div class="carousel-card_description text-size--{{ card.settings.text_size }} --word-break mty">
                    <p>{{- card.settings.description -}}</p>
                  </div>
                {%- endif -%}
              </header>
            {%- endif -%}
            {%- if card.settings.first_button_heading != blank or card.settings.second_button_heading != blank -%}
              <div class="carousel-card_btn mty {% if card.settings.btn_wrap %}carousel-card_btn--wrap{% endif %} --q-align-justify {{ buttons_alignment }} {{ buttons_alignment_mobile }}">
                {%- if card.settings.first_button_heading != blank -%}
                  <a
                    {% if card.settings.first_url != blank %}href="{{ card.settings.first_url -}}"{% else %}aria-disabled="true"{% endif %}
                    {% if card.settings.first_open_new_window %}target="_blank"{% endif %}
                    class="button button--{{ card.settings.first_btn_type }}"
                  >
                    {{- card.settings.first_button_heading -}}
                  </a>
                {%- endif -%}
                {%- if card.settings.second_button_heading != blank -%}
                  <a
                    {% if card.settings.second_url != blank %}href="{{ card.settings.second_url -}}"{% else %}aria-disabled="true"{% endif %}
                    {% if card.settings.second_open_new_window %}target="_blank"{% endif %}
                    class="button button--{{ card.settings.second_btn_type }}"
                  >
                    {{- card.settings.second_button_heading -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="carousel-card_bg-wrapper">
    {%- if card.settings.image -%}
      <div class="carousel-card_image">
        {{- card.settings.image | image_url: width: 3840 | image_tag: class: 'object-fit object-fit--absolute', loading: loading_attr, widths: '992, 3840', sizes: '(max-width: 767px) 992vw, 3840vw', alt: 'Image' -}}
      </div>
      {% else %}
        <div class="carousel-card_image">
          {{- placeholder_image | placeholder_svg_tag: 'object-fit object-fit--absolute' -}}
        </div>
    {%- endif -%}
  </div>
</article>
              <a href="{{- settings.social_tumblr_link -}}" class="list-social_link--tumblr {% unless social_icons_enable == false %}list-social_link{% else %}list-social_text-link{% endunless %}">
                {%- liquid
                  unless social_icons_enable == false
                    render 'icons-data', width: 17, height: 17, use_icon: true, icon_reference: 'tumblr'
                  endunless

{%- comment -%}
  renders socials widget
  usage
    {%- render 'socials-widget' -%}
{%- endcomment -%}

{%- liquid

  capture widget_position
    case settings.widget_position
      when 'bottom_left'
        echo '--bottom-left'
      when 'bottom_right'
        echo '--bottom-right'
    endcase
  endcapture
-%}

<div class="socials-widget scheme scheme--{{ settings.widget_color_scheme }}">
  <div class="dropdown-component --word-break {{ widget_position }}">
    <dropdown-component data-sorting="true">
      <button
        type="button"
        class="dropdown-component_opener btn-icn-ixi"
        data-tooltip="{{ 'socials_widgets.contact' | t }}"
        aria-expanded="false"
      >
        <span class="visually-hidden">{{- 'socials_widgets.contact' | t -}}</span>
        <i class="dropdown-componenet_icn-caret btn-icn-ixi_wrapper dropdown-componenet_icn-caret--open" >
          {%- render 'icons-data', width: 20, height: 20, use_icon: true, icon_reference: 'chat' -%}
        </i>
        <i class="dropdown-componenet_icn-caret btn-icn-ixi_wrapper dropdown-componenet_icn-caret--close" >
          {%- render 'icons-data', width: 20, height: 20, use_icon: true, icon_reference: 'cross' -%}
        </i>
      </button>
      <div class="dropdown-component_wrapper">
        <ul class="socials-widget_socials-list socials-list list-unstyled">
          {%- if settings.social_instagram_link != blank -%}
            <li>
              <a href="{{- settings.social_instagram_link -}}" class="list-social_link--insta {% unless social_icons_enable == false %}list-social_link{% else %}list-social_text-link{% endunless %}">
                {%- liquid
                  unless social_icons_enable == false
                    render 'icons-data', width: 17, height: 17, use_icon: true, icon_reference: 'instagram'
                  endunless
                -%}
                <span class="{% unless social_icons_enable == false %}visually-hidden{% endunless %}">{{- 'socials.instagram' | t -}}</span>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_linkedin_link != blank -%}
            <li>
              <a href="{{- settings.social_linkedin_link -}}" class="list-social_link--linkedin {% unless social_icons_enable == false %}list-social_link{% else %}list-social_text-link{% endunless %}">
                {%- liquid
                  unless social_icons_enable == false
                    render 'icons-data', width: 17, height: 17, use_icon: true, icon_reference: 'linkedin'
                  endunless
                -%}
                <span class="{% unless social_icons_enable == false %}visually-hidden{% endunless %}">{{- 'socials.linkedin' | t -}}</span>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <li>
              <a href="{{- settings.social_facebook_link -}}" class="list-social_link--facebook {% unless social_icons_enable == false %}list-social_link{% else %}list-social_text-link{% endunless %}">
                {%- liquid
                  unless social_icons_enable == false
                    render 'icons-data', width: 17, height: 17, use_icon: true, icon_reference: 'facebook'
                  endunless
                -%}
                <span class="{% unless social_icons_enable == false %}visually-hidden{% endunless %}">{{- 'socials.facebook' | t -}}</span>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <li>
              <a href="{{- settings.social_youtube_link -}}" class="list-social_link--youtube {% unless social_icons_enable == false %}list-social_link{% else %}list-social_text-link{% endunless %}">
                {%- liquid
                  unless social_icons_enable == false
                    render 'icons-data', width: 17, height: 17, use_icon: true, icon_reference: 'youtube'
                  endunless
                -%}

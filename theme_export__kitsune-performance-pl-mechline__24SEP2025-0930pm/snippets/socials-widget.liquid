          {%- if settings.social_phone_number != blank -%}
            <li>
              <a href="tel:{{- settings.social_phone_number -}}" class="list-social_link--phone-number {% unless social_icons_enable == false %}list-social_link{% else %}list-social_text-link{% endunless %}">
                {%- liquid
                  unless social_icons_enable == false
                    render 'icons-data', width: 17, height: 17, use_icon: true, icon_reference: 'phone'
                  endunless
                -%}
                <span class="{% unless social_icons_enable == false %}visually-hidden{% endunless %}">
                  {{- 'socials.phone_number' | t -}}
                </span>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_messenger != blank -%}
            <li>
              <a href="{{- settings.social_messenger -}}" class="list-social_link--messenger {% unless social_icons_enable == false %}list-social_link{% else %}list-social_text-link{% endunless %}">
                {%- liquid
                  unless social_icons_enable == false
                    render 'icons-data', width: 17, height: 17, use_icon: true, icon_reference: 'messenger'
                  endunless
                -%}
                <span class="{% unless social_icons_enable == false %}visually-hidden{% endunless %}">
                  {{- 'socials.messenger' | t -}}
                </span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </dropdown-component>
  </div>
</div>
{%- comment -%}
  renders breadcrumb on page templates
  usage
    {%- render 'breadcrumb', prefix_class: 'section_prefix_class', scheme: 'section.settings.breadcrumb_color_scheme' -%}
{%- endcomment -%}

{%- unless template == 'index' -%}
  {%- liquid
    assign breadcrumb_scheme_class = scheme | prepend: 'scheme scheme--'
    assign t = template | split: '.' | first
  -%}
  <nav class="breadcrumb-nav {{ prefix_class }}_breadcrumb-nav {% if section.settings.show_top_bdr %}breadcrumb-nav--bdr-top{% endif %} {% if section.settings.show_bottom_bdr %}breadcrumb-nav--bdr-bottom{% endif %} {{ breadcrumb_scheme_class }}" aria-label="{{- 'breadcrumb.title' | t -}}">
    <div class="container">
      <ol class="breadcrumb-list list-unstyled">
        <li class="breadcrumb-list_item">
          <a class="breadcrumb-list_link" href="{{- routes.root_url -}}">
            {{- 'breadcrumb.home' | t -}}
          </a>
          <i class="breadcrumb-list_separator">
            {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
          </i>
        </li>
        {%- case t -%}
          {%- when 'page' -%}
            <li class="breadcrumb-list_item">
              <span class="breadcrumb-list_link" aria-current="{{- 'breadcrumb.current_page_label' | t -}}">
                {{- page.title -}}
              </span>
              <i class="breadcrumb-list_separator">
                {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
              </i>
            </li>
          {%- when 'product' -%}
            {%- assign product_collections = product.collections -%}
            {%- if product_collections.size > 0 -%}
              {%- assign product_collection = product_collections.first -%}
              <li class="breadcrumb-list_item">
                <a class="breadcrumb-list_link" href="{{- product_collection.url -}}">
                  {{- product_collection.title -}}
                </a>
                <i class="breadcrumb-list_separator">
                  {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
                </i>
              </li>
            {%- endif -%}
            <li class="breadcrumb-list_item">
              <span class="breadcrumb-list_link" aria-current="{{- 'breadcrumb.current_page_label' | t -}}">
                {{- product.title -}}
              </span>
              <i class="breadcrumb-list_separator">
                {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
              </i>
            </li>
          {%- when 'collection' and collection.handle -%}
            {%- if current_tags -%}
              <li class="breadcrumb-list_item">
                {{- collection.title | link_to: collection.url -}}
                <i class="breadcrumb-list_separator">
                  {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
                </i>
              </li>
              <li class="breadcrumb-list_item">
                {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+" }}{%- endcapture -%}
                <span class="breadcrumb-list_link" aria-current="{{- 'breadcrumb.current_page_label' | t -}}">
                  <span>
                    {{- current_tags | join: " + " -}}
                  </span>
                </span>
                <i class="breadcrumb-list_separator">
                  {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
                </i>
              </li>
            {%- else -%}
              <li class="breadcrumb-list_item">
                <span class="breadcrumb-list_link" aria-current="{{- 'breadcrumb.current_page_label' | t -}}">
                  {{- collection.title -}}
                </span>
                <i class="breadcrumb-list_separator">
                  {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
                </i>
              </li>
            {%- endif -%}
          {%- when 'blog' -%}
            {%- if current_tags -%}
              <li class="breadcrumb-list_item">
                {{- blog.title | link_to: blog.url -}}
                <i class="breadcrumb-list_separator">
                  {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
                </i>
              </li>
              <li class="breadcrumb-list_item">
                {%- capture tag_url -%}{{ blog.url }}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
                <span class="breadcrumb-list_link" aria-current="{{- 'breadcrumb.current_page_label' | t -}}">
                  {{- current_tags | join: " + " -}}
                </span>
                <i class="breadcrumb-list_separator">
                  {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
                </i>
              </li>
            {%- else -%}
              <li class="breadcrumb-list_item">
                <span class="breadcrumb-list_link" aria-current="{{- 'breadcrumb.current_page_label' | t -}}">
                  {{- blog.title -}}
                </span>
                <i class="breadcrumb-list_separator">
                  {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
                </i>
              </li>
            {%- endif -%}
          {%- when 'article' -%}
            <li class="breadcrumb-list_item">
              <a class="breadcrumb-list_link" href="{{- blog.url -}}">
                {{- blog.title -}}
              </a>
              <i class="breadcrumb-list_separator">
                {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
              </i>
            </li>
            <li class="breadcrumb-list_item">
              <span class="breadcrumb-list_link" aria-current="{{- 'breadcrumb.current_page_label' | t -}}">
                {{- article.title -}}
              </span>
              <i class="breadcrumb-list_separator">
                {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
              </i>
            </li>
          {%- else -%}
            <li class="breadcrumb-list_item">
              <span class="breadcrumb-list_link" aria-current="{{- 'breadcrumb.current_page_label' | t -}}">
                {{- page_title -}}
              </span>
              <i class="breadcrumb-list_separator">
                {%- render 'icons-data', width: 16, height: 16, use_icon: true, icon_reference: 'slash' -%}
              </i>
            </li>
        {%- endcase -%}
      </ol>
    </div>
  </nav>
{%- endunless -%}
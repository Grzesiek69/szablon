{%- comment -%}
  Recursive renderer for multi-level navigation dropdown items.
  Parameters:
    - node: link object to render.
    - level: current dropdown level (1-based inside the dropdown panel).
    - path: unique identifier path from parent items.
    - index: index of the current node within its siblings (1-based).
{%- endcomment -%}
{%- liquid
  assign node_handle = node.title | handle
  assign current_index = index | default: forloop.index
  capture current_path
    if path
      echo path
      echo '-'
    endif
    echo current_index
    echo '-'
    echo node_handle
  endcapture
  assign current_path = current_path | strip | replace: ' ', '-' | replace: '--', '-'
  assign heading_id = current_path | append: '-heading-l' | append: level
  assign controls_id = current_path | append: '-lvl' | append: level
  assign dropdown_link_title = 'navigation.dropdown_link' | t: link: node.title | escape
  assign next_level = level | plus: 1
  assign max_level = 4
  assign has_children = node.links != blank and level < max_level and node.links.size > 0
  assign list_class = 'main-navigation_dropdown-list--inner'
  if level == 1
    assign list_class = 'main-navigation_dropdown-list--simple'
  endif
-%}
<li class="main-navigation_dropdown-item{% if has_children %} --has-dropdown{% endif %}">
  {%- if has_children -%}
    <strong id="{{- heading_id -}}" class="visually-hidden">{{- dropdown_link_title -}}</strong>
    <dropdown-component data-dropdown-level="{{ next_level }}">
      <button
        type="button"
        class="dropdown-component_opener main-navigation_dropdown-link main-navigation_dropdown-link--level{{ level }} main-navigation_dropdown-link--opener"
        aria-expanded="false"
        aria-controls="{{- controls_id -}}"
        aria-describedby="{{- heading_id -}}"
        data-level="{{ level }}"
      >
        {{- node.title | escape -}}
        <i class="dropdown-component_opener-icn dropdown-component_opener--icn-open">
          {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'plus' -%}
        </i>
        <i class="dropdown-component_opener-icn dropdown-component_opener--icn-close">
          {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'minus' -%}
        </i>
      </button>
      <div
        class="dropdown-component_wrapper main-navigation_dropdown-wrapper main-navigation_dropdown-wrapper--level{{ next_level }} main-navigation_dropdown--inner-wrapper"
        id="{{- controls_id -}}"
      >
        <ul class="list-unstyled main-navigation_dropdown-list {{ list_class }} main-navigation_dropdown-list--level{{ next_level }}">
          {%- for child in node.links -%}
            {%- render 'menu-dropdown-node', node: child, level: next_level, path: current_path, index: forloop.index -%}
          {%- endfor -%}
        </ul>
      </div>
    </dropdown-component>
  {%- else -%}
    <a
      class="main-navigation_dropdown-link main-navigation_dropdown-link--level{{ level }}{% if node.current %} main-navigation_link--active{% endif %}"
      href="{{- node.url -}}"
      data-level="{{ level }}"
      {% if node.current %}aria-current="{{- 'navigation.current_page_label' | t -}}"{% endif %}
    >
      {{- node.title | escape -}}
    </a>
  {%- endif -%}
</li>

{%- comment -%}
  renders shopify enabled payment gateway icons
  usage
    {%- render 'payment-icons' | prefix_class: 'section_prefix_class' -%}
{%- endcomment -%}
<ul class="{{ prefix_class }}_payments-list payments-list list-unstyled">
  {%- for type in shop.enabled_payment_types -%}
    <li>
      {{ type | payment_type_svg_tag }}
    </li>
  {%- endfor -%}
</ul>
{%- comment -%}
  renders product price from
  usage
    {%- render 'product-price-from', product: product, prefix_class: section_prefix_class, price_tag: true -%}
{%- endcomment -%}
{%- liquid
  assign target = product
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999

  assign onsale = false
  if compare_at_price > price
    assign onsale = true
  endif

  assign money_price = price | money
  if settings.show_currency_code
    assign money_price = price | money_with_currency
  endif

  if target == product and product.price_varies
    assign money_price = money_price
  endif
-%}

<span class="{% if price_tag %}price-tag{% endif %} {{ prefix_class }}_price-from price-from --word-break">
  {%- if onsale -%}
    {{- 'product.price_from.from_price_html' | t: price: money_price -}}
    {%- else -%}
      <span class="visually-hidden">
        {{- 'product.price_from.regular_price' | t -}}
      </span>
      <span class="regular-price_from main-price">
        {{- money_price -}}
      </span>
  {%- endif -%}
</span>
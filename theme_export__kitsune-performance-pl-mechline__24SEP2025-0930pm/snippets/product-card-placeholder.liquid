{%- comment -%}
  renders product card placeholder purpose
  usage
    {%- render 'product-card-placeholder', prefix_class: 'section_prefix_class', index: forloop.index -%}
{%- endcomment -%}
{%- liquid
  capture placeholder_image
    if index > 4
      echo 'product-apparel-1'
      else
        echo 'product-apparel-' | append: index
    endif
  endcapture

  if media != blank
    capture image_alt
      echo media.preview_image.alt | default: product.title
    endcapture
  endif

  capture height_ratio
    assign case_var = section.settings.card_media_size
    case case_var
      when 'small'
        echo '0.8'
      when 'medium'
        echo '0.6'
      when 'large'
        echo '0.4'
    endcase
  endcapture
-%}

<div class="product-card product-card--placeholder --align-left">
  <div class="product-card_image --media-size-adapt" style="--media-ratio: {{ height_ratio }};">
    {{- placeholder_image | placeholder_svg_tag: 'object-fit object-fit--absolute' -}}
  </div>
  <div class="product-card_description">
    <div class="product-card_align">
      <h3 class="mty product-card_text product-card_heading text-size--{{ section.settings.card_text_size }}">{{- 'product.title' | t -}}</h3>
      {%- if section.settings.show_vendor -%}
        <h4 class="mty product-card_text product-card_category text-size--small">{{- 'product.vendor' | t -}}</h4>
      {%- endif -%}
      {%- if section.settings.card_show_price -%}
        <h5 class="mty product-card_text product-card_price">
          <strong class="product-card_price-title text-size--medium">{{- 'product.price' | t -}}:</strong>
          <strong class="product-card_price-description">
            {%- render 'product-price-from', product: product, prefix_class: section_prefix_class, price_tag: true -%}
          </strong>
        </h5>
      {%- endif -%}
    </div>
  </div>
</div>
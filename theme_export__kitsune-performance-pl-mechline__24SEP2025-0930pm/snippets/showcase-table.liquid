{%- comment -%}
  renders table data of product
  usage
    {%- render 'showcase-table', product: block.settings.product, prefix_class: section_prefix_class -%}
{%- endcomment -%}
{%- liquid
  if product.selected_or_first_available_variant.featured_media != null
    assign media = product.selected_or_first_available_variant.featured_media

    else
      for media in product.media
        assign media = media
        break
      endfor
  endif

  capture product_link
    if product != blank
      echo product.url
      else
        echo ''
    endif
  endcapture

  capture product_title
    if product != blank
      echo product.title | escape
      else
        echo 'product.title' | t
    endif
  endcapture

  capture product_vendor
    if product != blank
      echo product.vendor | escape
      else
        echo 'product.table_box.vendor' | t
    endif
  endcapture
-%}
<table class="record-table widget--styles">
  <caption>
    <div class="caption-inner-wrap">
      <div class="caption-title-wrap">
        <h3 class="record-table_title mty">
          <a {% if product.title != blank %}href="{{- product.url -}}"{% else %}aria-disabled="true"{% endif %} class="--hover-underline">
            {{- product_title -}}
          </a>
        </h3>
      </div>
      <div class="caption-link-wrap">
        <a class="--hover-underline" {% if product_link != '' %}href="{{ product_link }}"{% else %}aria-disabled="true"{% endif %}>{{- 'product.table_box.view_button_label' | t -}}</a>
      </div>
    </div>
  </caption>
  <thead>
    <tr>
      <th class="--align-left">{{- 'product.table_box.table_title' | t -}}</th>
      <th class="--align-right">{{- 'product.table_box.table_description_title' | t -}}</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th data-title="{{- 'product.table_box.table_title' | t -}}" class="--align-left">
        <div class="record-table_text-wrap">
          {{- 'product.price' | t -}}
        </div>
      </th>
      <td data-title="{{- 'product.table_box.table_description_title' | t -}}" class="--align-right">
        <div class="record-table_text-wrap">
          {%- render 'product-price', product: product, use_variant: false, show_unit_price: false -%}
        </div>
      </td>
    </tr>
    <tr>
      <th data-title="{{- 'product.table_box.table_title' | t -}}" class="--align-left">
        <div class="record-table_text-wrap">
          {{- 'product.table_box.vendor' | t -}}
        </div>
      </th>
      <td data-title="{{- 'product.table_box.table_description_title' | t -}}" class="--align-right">
        <div class="record-table_text-wrap">
          {{- product_vendor -}}
        </div>
      </td>
    </tr>
    {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
      <tr>
        <th data-title="{{- 'product.table_box.table_title' | t -}}" class="--align-left">
          <div class="record-table_text-wrap">
            {{- 'product.table_box.stock.label' | t -}}
          </div>
        </th>
        <td data-title="{{- 'product.table_box.table_description_title' | t -}}" class="--align-right">
          <div class="record-table_text-wrap">
            {%- render 'product-stock', product: product, prefix_class: section_prefix_class -%}
          </div>
        </td>
      </tr>
    {%- endif -%}
    {%- if product != null -%}
      {%- unless product.has_only_default_variant -%}
        <tr>
          <th data-title="{{- 'product.table_box.table_title' | t -}}" class="--align-left">
            <div class="record-table_text-wrap">
              {{- 'product.table_box.variation' | t -}}
            </div>
          </th>
          <td data-title="{{- 'product.table_box.table_description_title' | t -}}" class="--align-right">
            <div class="record-table_text-wrap">
              {%- render 'product-variant-count', product: product, prefix_class: section_prefix_class -%}
            </div>
          </td>
        </tr>
      {%- endunless -%}
    {%- endif -%}
  </tbody>
</table>
{{- 'component-testimonial-card.css' | asset_url | stylesheet_tag -}}
{{- 'testimonials.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'testimonials'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture max_header_size
    echo settings.page_width | times: section.settings.max_header_size | divided_by: 100
  endcapture

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture container_class
    if section.settings.section_full_width
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 20px;
    --section-slider-radius: 8px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --mobile-q-align: {{ section.settings.section_mobile_text_alignment }};
    --desktop-q-align: {{ section.settings.section_text_alignment }};
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} {% if section.settings.section_full_width and section.settings.section_behavior_layout == 'scroll' %}{{ section_prefix_class }}--full-width{% endif %}">
  <div class="{{ section_prefix_class }}_wrapper">
    {%- if section.settings.heading != blank or section.settings.section_description != blank -%}
      <div class="container --q-align" style="--cp-width: {{ max_header_size }}">
        <header class="heading-head">
          {%- if section.settings.heading != blank-%}
            <h2 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">{{- section.settings.heading -}}</h2>
          {%- endif -%}
          {%- if section.settings.section_description != blank -%}
            <div class="{{ section_prefix_class }}_description text-size--{{ section.settings.section_text_size }} --word-break mty">
              <p>{{- section.settings.section_description -}}</p>
            </div>
          {%- endif -%}
        </header>
      </div>
    {%- endif -%}
    <div class="{{ container_class }}">
      {%- if section.settings.section_behavior_layout == 'scroll' -%}
        {%- liquid
          capture marquee_direction
            if section.settings.marquee_direction == 'marquee_forward'
              echo 'forward'
              else
                echo 'backward'
            endif
          endcapture
        -%}
        <marquee-component data-direction="{{ marquee_direction }}" data-pause-on-hover="{{ section.settings.marquee_on_hover }}" data-speed="{{ section.settings.marquee_speed }}">
          <div class="marquee-component">
            {%- for block in section.blocks -%}
              <div class="{{ section_prefix_class }}_col marquee-component_col" style="--slide-desktop-width: {{ section.settings.desktop_width | plus: 18 }}px; --slide-mob-width: {{ section.settings.mob_width | plus: 18 }}px;">
                {%- render 'testimonial-card', card: block, prefix_class: section_prefix_class -%}
              </div>
            {%- endfor -%}
          </div>
        </marquee-component>
        {%- else -%}
        {%- liquid
          assign desktop_width = section.settings.desktop_width | append: 'px'
          assign mob_width = section.settings.mob_width | append: 'px'
        -%}
          <div class="{{ section_prefix_class }}_slider-wrapper">
            <splide-slider
              data-drag="true"
              data-autoplay="{{- section.settings.auto_play -}}"
              data-rewind="true"
              data-pause-on-hover="true"
              data-gap="18px"
              data-per-move="1"
              data-arrows="{{- section.settings.show_navigation -}}"
              data-pagination="{{- section.settings.show_pagination -}}"
              data-per-page="1"
              data-interval="{{- section.settings.change_slides_every | times: 1000 -}}"
              data-fixed-width="{{ mob_width }}"
              {% if request.design_mode == false %}
                data-type="loop"
                {% else %}
                  data-type="slide"
              {% endif %}
              data-breakpoints='{"responsive": {"768": {"fixedWidth": "{{ desktop_width }}"}}}'
            >
              <div class="splide">
                <div class="splide__track">
                  <div class="splide__list">
                    {%- for block in section.blocks -%}
                      <div class="splide__slide" {{ block.shopify_attributes }}>
                        {%- render 'testimonial-card', card: block, prefix_class: section_prefix_class -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
                {%- if section.settings.show_navigation or section.settings.show_pagination -%}
                  <div class="container">
                    <div class="splide-controls --justify-center">
                      {%- if section.settings.show_navigation -%}
                        <button class="splide__arrow splide__arrow--prev btn-icn-ixi">
                          <span class="btn-icn-ixi_wrapper">
                            <span class="visually-hidden">{{- 'accessibility.slider.previous' | t -}}</span>
                            {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'left-arrow' -%}
                          </span>
                        </button>
                      {%- endif -%}
                      <ul class="splide__pagination" role="tablist" aria-label="{{- 'accessibility.slider.pagination_label' | t -}}"></ul>
                      {%- if section.settings.show_navigation -%}
                        <button class="splide__arrow splide__arrow--next btn-icn-ixi">
                          <span class="btn-icn-ixi_wrapper">
                            <span class="visually-hidden">{{- 'accessibility.slider.next' | t -}}</span>
                            {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'right-arrow' -%}
                          </span>
                        </button>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </splide-slider>
          </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Testimonials"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "Inspiring testimonials and success stories that illuminate the path to achievements."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "max_header_size",
      "label": "t:sections.product_showcase.settings.max_header_size.label",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.common.grid.content"
    },
    {
      "type": "range",
      "id": "desktop_width",
      "label": "t:sections.testimonials.settings.desktop_width.label",
      "min": 320,
      "max": 680,
      "step": 5,
      "default": 330
    },
    {
      "type": "range",
      "id": "mob_width",
      "label": "t:sections.testimonials.settings.mob_width.label",
      "min": 250,
      "max": 290,
      "step": 5,
      "default": 280,
      "info": "t:sections.common.grid.settings.mobile.num_cols.query.info"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "select",
      "id": "section_behavior_layout",
      "label": "t:sections.testimonials.settings.layout_type.label",
      "options": [
        {
          "value": "slideshow",
          "label": "t:sections.testimonials.settings.layout_type.options.opt_1.label"
        },
        {
          "value": "scroll",
          "label": "t:sections.testimonials.settings.layout_type.options.opt_2.label"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "t:sections.common.full_width.label",
      "default": true
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.testimonials.settings.text_alignment.desktop.label",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "section_mobile_text_alignment",
      "label": "t:sections.testimonials.settings.text_alignment.mobile.label",
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme2",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.scroll.content"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.common.scroll.settings.speed.label",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 15,
      "unit": "sec"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "t:sections.common.scroll.settings.direction.label",
      "options": [
        {
          "value": "marquee_backward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_1.label"
        },
        {
          "value": "marquee_forward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_2.label"
        }
      ],
      "default": "marquee_backward"
    },
    {
      "type": "checkbox",
      "label": "t:sections.common.scroll.settings.on_hover.label",
      "id": "marquee_on_hover",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.slideshow.content"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "t:sections.common.slideshow.auto_play.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.common.slideshow.show_arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:sections.common.slideshow.show_nav.label",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_every",
      "label": "t:sections.common.slideshow.interval.label",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 5,
      "unit": "s",
      "info": "t:sections.common.slideshow.interval.info"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "type": "testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.testimonials.blocks.testimonial.settings.image.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author_name.label",
          "default": "Author's name"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author_caption.label",
          "default": "Author's caption"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "t:sections.common.description.label",
          "default": "Add customer reviews and testimonials to showcase your store's happy customers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
          }
        },
        {
          "type": "testimonial",
          "settings": {
          }
        },
        {
          "type": "testimonial",
          "settings": {
          }
        },
        {
          "type": "testimonial",
          "settings": {
          }
        }
      ]
    }
  ]
}
{% endschema %}
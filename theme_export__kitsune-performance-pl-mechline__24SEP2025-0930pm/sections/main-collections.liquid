{{- 'component-breadcrumb.css' | asset_url | stylesheet_tag -}}
{{- 'component-pagination.css' | asset_url | stylesheet_tag -}}
{{- 'component-collection-card.css' | asset_url | stylesheet_tag -}}
{{- 'main-collections.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'main-collections'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture max_header_size
    echo settings.page_width | times: section.settings.max_header_size | divided_by: 100
  endcapture

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  case section.settings.sort
    when 'products_high', 'products_low'
      assign collections = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign collections = collections | sort: 'published_at'
  endcase

  if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
    assign collections = collections | reverse
  endif

  assign moduloResult = 28 | modulo: section.settings.number_of_columns_on_desktop
  assign paginate_by = 30
  if moduloResult == 0
    assign paginate_by = 28
  endif
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 20px;
    --section-slider-radius: 8px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --columns-count: {{ section.settings.number_of_columns_on_desktop }};
    --columns-count-mobile: {{ section.settings.number_of_columns_on_mobile }};
  }
{%- endstyle -%}
{%- liquid
  if section.settings.show_breadcrumb
    render 'breadcrumb', prefix_class: section_prefix_class, scheme: section.settings.breadcrumb_color_scheme
  endif
-%}
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --align-{{ section.settings.section_text_alignment }}">
  <div class="container">
    <div class="{{ section_prefix_class }}_wrapper">
      {%- if section.settings.heading != blank or section.settings.section_description != blank -%}
        <div class="container" style="--cp-width: {{ max_header_size }}">
          <header class="heading-head">
            {%- if section.settings.heading != blank -%}
              <h1 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">{{- section.settings.heading -}}</h1>
            {%- endif -%}
            {%- if section.settings.section_description != blank -%}
              <div class="{{ section_prefix_class }}_description text-size--{{ section.settings.section_text_size }} mty">
                <p>{{- section.settings.section_description -}}</p>
              </div>
            {%- endif -%}
          </header>
        </div>
      {%- endif -%}
      {%- paginate collections by paginate_by -%}
        <div class="grid {{ section_prefix_class }}_grid">
          {%- for collection in collections -%}
            <div class="grid_col">
              {%- render 'collection-card', card: collection, show_counts: section.settings.show_products_count, prefix_class: section_prefix_class, heading_tag: 'h2' -%}
            </div>
          {%- endfor -%}
        </div>
        {%- render 'pagination', paginate: paginate, prefix_class: section_prefix_class -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.main_collections.name",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Collections"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "Display product collections with images, customizable for seasonal highlights or promotions."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "max_header_size",
      "label": "t:sections.product_showcase.settings.max_header_size.label",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.common.breadcrumb.content"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.common.breadcrumb.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_top_bdr",
      "label": "t:sections.common.breadcrumb.top_bdr.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_bdr",
      "label": "t:sections.common.breadcrumb.bottom_bdr.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "breadcrumb_color_scheme",
      "default": "scheme2",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.grid.content"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "t:sections.main_collections.settings.sort_by.label",
      "options": [
        {
          "value": "alphabetical",
          "label": "t:sections.main_collections.settings.sort_by.options.opt_1.label"
        },
        {
          "value": "alphabetical_reversed",
          "label": "t:sections.main_collections.settings.sort_by.options.opt_2.label"
        },
        {
          "value": "date_reversed",
          "label": "t:sections.main_collections.settings.sort_by.options.opt_3.label"
        },
        {
          "value": "date",
          "label": "t:sections.main_collections.settings.sort_by.options.opt_4.label"
        },
        {
          "value": "products_high",
          "label": "t:sections.main_collections.settings.sort_by.options.opt_5.label"
        },
        {
          "value": "products_low",
          "label": "Product count, low to high"
        }
      ],
      "default": "alphabetical"
    },
    {
      "type": "range",
      "id": "number_of_columns_on_desktop",
      "label": "t:sections.common.grid.settings.desktop.num_cols.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "number_of_columns_on_mobile",
      "label": "t:sections.common.grid.settings.mobile.num_cols.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.common.grid.settings.mobile.num_cols.options.opt_1.label"
        },
        {
          "value": "2",
          "label": "t:sections.common.grid.settings.mobile.num_cols.options.opt_2.label"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:sections.main_collections.settings.card.content"
    },
    {
      "type": "select",
      "id": "card_media_size",
      "label": "t:sections.common.media_size.settings.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.common.media_size.settings.options.opt_1.label"
        },
        {
          "value": "square",
          "label": "t:sections.common.media_size.settings.options.opt_2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.common.media_size.settings.options.opt_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.common.media_size.settings.options.opt_4.label"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_products_count",
      "label": "t:sections.main_collections.settings.card.count.label",
      "default": true
    },
    {
      "type": "text_alignment",
      "id": "card_text_alignment",
      "label": "t:sections.main_collections.settings.card.heading.alignment.label",
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "checkbox",
      "id": "remove_radius",
      "label": "t:sections.collection_list.settings.remove_radius.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "t:sections.collection_list.settings.enable_border.label",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.common.text.settings.alignment.label",
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ]
}
{% endschema %}
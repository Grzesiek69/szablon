{{- 'component-breadcrumb.css' | asset_url | stylesheet_tag -}}
{{- 'main-login.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'main-login'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture main_heading
    if section.settings.heading != blank
      echo section.settings.heading
      else
        echo 'main_login.main_heading' | t
    endif
  endcapture

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture
-%}

<script src="{{ 'login-component.js' | asset_url }}" defer="defer"></script>
{%- liquid
  if section.settings.show_breadcrumb
    render 'breadcrumb', prefix_class: section_prefix_class, scheme: section.settings.breadcrumb_color_scheme
  endif
-%}
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }}">
  <div class="container-fluid">
    <div class="{{ section_prefix_class }}_wrapper">
      {%- if section.settings.image != blank -%}
        <div class="{{ section_prefix_class }}_column {{ section_prefix_class }}_column--image">
          <div class="{{ section_prefix_class }}_img">
            {{- section.settings.image | image_url: width: 1944 | image_tag: class: 'object-fit object-fit--absolute', loading: loading_attr, alt: main_heading, widths: '972, 1944', sizes: '(max-width: 767px) 972vw, 1944vw' -}}
          </div>
        </div>
      {%- endif -%}
      <div class="{{ section_prefix_class }}_column {{ section_prefix_class }}_column--form align-holder align-holder--mcenter">
        <div class="{{ section_prefix_class }}_form-align align-holder_wrapper">
          <login-component>
            <div id="access-element1" class="transit transit--in">
              {%- if section.settings.heading != blank -%}
                <header class="{{ section_prefix_class }}_heading-head --align-center">
                  <h1 class="{{ section_prefix_class }}_heading --h-anchor-none {{ section_heading_size }} mty">
                    {{- main_heading -}}
                  </h1>
                  <div class="{{ section_prefix_class }}_description text-size--medium mty">
                    <p>{{- 'main_login.req_fields_text' | t -}}</p>
                  </div>
                </header>
                {%- else -%}
                  <header class="visually-hidden --align-center">
                    <h1>
                      {{- main_heading -}}
                    </h1>
                  </header>
                  <div class="{{ section_prefix_class }}_description text-size--medium mty">
                    <p>{{- 'main_login.req_fields_text' | t -}}</p>
                  </div>
              {%- endif -%}
              {%- form 'customer_login', novalidate: 'novalidate' -%}
                {%- if form.errors != blank -%}
                  <strong class="form__message mty" role="alert" tabindex="-1" autofocus>
                    {%- render 'icons-data', width: 22, height: 22, use_icon: true, icon_reference: 'error' -%}
                    {{- 'main_login.error.heading' | t -}}
                  </strong>
                  {{- form.errors | default_errors -}}
                {%- endif -%}
                <div class="{{ section_prefix_class }}_form-group">
                  <label for="loginemailaddress" class="{{ section_prefix_class }}_form-input-lable">
                    {{- 'main_login.email_label' | t -}}
                  </label>
                  <input
                    type="email"
                    name="customer[email]"
                    id="loginemailaddress"
                    autocomplete="email"
                    autocapitalize="off"
                    {% if form.errors contains 'form' %}
                      aria-invalid="true"
                    {% endif %}
                    placeholder="{{- 'main_login.email_label' | t -}}"
                  >
                </div>
                {%- if form.password_needed -%}
                  <div class="{{ section_prefix_class }}_form-group">
                    <label for="loginpassword" class="{{ section_prefix_class }}_form-input-lable">
                      {{- 'main_login.pass_label' | t -}}
                    </label>
                    <input
                      type="password"
                      name="customer[password]"
                      id="loginpassword"
                      autocomplete="current-password"
                      autocapitalize="off"
                      value=""
                      {% if form.errors contains 'form' %}
                        aria-invalid="true"
                      {% endif %}
                      placeholder="{{- 'main_login.pass_label' | t -}}"
                    >
                  </div>
                {%- endif -%}
                <div class="{{ section_prefix_class }}_btn-wrapper mty">
                  <button type="submit" class="button button--primary {{ section_prefix_class }}_form-btn">
                    <i class="button_icn">
                      {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'right-arrow' -%}
                    </i>
                    {{- 'main_login.btn_label' | t -}}
                  </button>
                </div>
                <div class="{{ section_prefix_class }}_foot-wrapper text-size--large mty --align-center">
                  {%- if form.password_needed -%}
                    <button class="button button--link {{ section_prefix_class }}_forget-btn" type="button" data-target-id="access-element2">
                      {{- 'main_login.forgot_btn_label' | t -}}
                    </button>
                  {%- endif -%}
                  <p>
                    {{- 'main_login.create_account' | t }} <a href="{{- routes.account_register_url -}}" class="button button--link {{ section_prefix_class }}_register-link">{{- 'main_login.sign_up' | t -}}</a>
                  </p>
                </div>
              {%- endform -%}
            </div>
            <div id="access-element2" class="transit transit--out">
              <header class="{{ section_prefix_class }}_heading-head --align-center">
                <h2 class="{{ section_prefix_class }}_heading --h-anchor-none {{ section_heading_size }} mty">
                  {{- 'main_login.reset_heading' | t -}}
                </h2>
                <div class="{{ section_prefix_class }}_description text-size--medium mty">
                  <p>{{- 'main_login.req_fields_text' | t -}}</p>
                </div>
              </header>
              {%- form 'recover_customer_password' -%}
                {% assign recover_success = form.posted_successfully? %}
                <div class="{{ section_prefix_class }}_form-group">
                  <label for="recoveremail" class="{{ section_prefix_class }}_form-input-lable">
                    {{- 'main_login.email_label' | t -}}
                  </label>
                  <input
                    type="email"
                    value=""
                    name="email"
                    id="recoveremail"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      aria-invalid="true"
                      aria-describedby="recoveremail-email-error"
                      autofocus
                    {% endif %}
                    placeholder="{{ 'main_login.email_label' | t }}"
                  >
                  {%- if form.errors -%}
                    <div id="recoveremail-email-error" class="{{ section_prefix_class }}_error-wrapper" role="status">
                      <i class="{{ section_prefix_class }}_role-icn">
                        {%- render 'icons-data', width: 22, height: 22, use_icon: true, icon_reference: 'error' -%}
                      </i>
                      {{- form.errors.messages.form -}}
                    </div>
                  {%- endif -%}
                </div>
                <div class="{{ section_prefix_class }}_btn-wrapper text-size--large mty --align-center">
                  <button type="submit" class="button button--primary {{ section_prefix_class }}_form-btn">
                    <i class="button_icn">
                      {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'right-arrow' -%}
                    </i>
                    {{- 'main_login.reset_btn_label' | t -}}
                  </button>
                  <button class="button button--link {{ section_prefix_class }}_cancel-btn" type="button" data-target-id="access-element1">
                    {{- 'main_login.cancel_btn_label' | t -}}
                  </button>
                </div>
                {%- if recover_success == true -%}
                  <div id="recoveremail-email-success" class="success-message" role="alert" tabindex="-1" autofocus>
                    <i class="success-message_icn">
                      {%- render 'icons-data', width: 54, height: 54, use_icon: true, icon_reference: 'smile' -%}
                    </i>
                    <p>{{- 'main_login.recover_success' | t -}}</p>
                  </div>
                {%- endif -%}
              {%- endform -%}
            </div>
          </login-component>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_login.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Customer Login"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "header",
      "content": "t:sections.common.breadcrumb.content"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.common.breadcrumb.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_top_bdr",
      "label": "t:sections.common.breadcrumb.top_bdr.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_bdr",
      "label": "t:sections.common.breadcrumb.bottom_bdr.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "breadcrumb_color_scheme",
      "default": "scheme2",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.main_login.settings.banner.label",
      "info": "t:sections.main_login.settings.banner.info"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    }
  ]
}
{% endschema %}
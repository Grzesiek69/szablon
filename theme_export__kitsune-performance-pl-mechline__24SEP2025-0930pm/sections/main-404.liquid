{{- 'main-404.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'main-404'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture btn_label
    if section.settings.button_label != blank
      echo section.settings.button_label | escape
      else
        echo 'main_404.button_label' | t
    endif
  endcapture

  capture btn_url
    echo section.settings.button_link | default: routes.root_url
  endcapture

  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture

  capture heading_alt
    echo 'main_404.label' | t
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --align-center">
  <div class="container" style="--cp-width: 520">
    <div class="{{ section_prefix_class }}_wrapper">
      <strong class="{{ section_prefix_class }}_heading h1">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 412 | image_tag: loading: loading_attr, widths: '412', sizes: '(min-width: 50px) 412px', alt: heading_alt -}}
          {%- else -%}
            {{- heading_alt -}}
        {%- endif -%}
      </strong>
      {%- if section.settings.heading != blank -%}
        <h1 class="mty {{ section_heading_size }} {{ section_prefix_class }}_subheading">
          {{- section.settings.heading -}}
        </h1>
        {%- else -%}
          <h1 class="{{ section_heading_size }} visually-hidden">
            {{- 'main_404.heading' | t -}}
          </h1>
      {%- endif -%}
      {%- if section.settings.section_description != blank -%}
        <div class="{{ section_prefix_class }}_description text-size--{{ section.settings.section_text_size }} mty">
          <p>
            {{- section.settings.section_description -}}
          </p>
        </div>
        {%- else -%}
          <div class="text-size--{{ section.settings.section_text_size }} visually-hidden">
            <p>
              {{- 'main_404.description' | t -}}
            </p>
          </div>
      {%- endif -%}
      <footer class="{{ section_prefix_class }}_foot --justify-self mty">
        <a
          href="{{- btn_url -}}" 
          class="button button--{{ section.settings.button_type }}"
          {% if section.settings.open_new_window %}target="_blank"{% endif %}
        >
          {{- btn_label -}}
        </a>
      </footer>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.main_404.settings.image.label",
      "info": "t:sections.main_404.settings.image.info"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Something is wrong"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "The page you are looking for was moved, removed, renamed or may have never existed!"
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.main_404.settings.button.label",
      "default": "BACK TO HOMEPAGE"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "t:sections.main_404.settings.button.type.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.common.button.settings.options.opt_1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.common.button.settings.options.opt_2.label"
        }
      ],
      "default": "primary"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.main_404.settings.button.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_new_window",
      "label": "t:sections.common.target_blank.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 94,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 94,
      "unit": "px"
    }
  ]
}
{% endschema %}
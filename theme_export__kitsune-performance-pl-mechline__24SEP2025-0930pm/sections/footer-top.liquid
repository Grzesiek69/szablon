{{ 'component-menu-strip.css' | asset_url | stylesheet_tag }}
{{ 'component-socials-list.css' | asset_url | stylesheet_tag }}
{{ 'footer-top.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_prefix_class = 'footer-top'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture container_class
    if section.settings.section_full_width
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture

  capture show_social_list
    if settings.social_instagram_link != blank
      echo 'true'
      elsif settings.social_linkedin_link != blank
        echo 'true'
      elsif settings.social_facebook_link != blank
        echo 'true'
      elsif settings.social_youtube_link != blank
        echo 'true'
      elsif settings.social_twitter_link != blank
        echo 'true'
      elsif settings.social_snapchat_link != blank
        echo 'true'
      elsif settings.social_pinterest_link != blank
        echo 'true'
      elsif  settings.social_tiktok_link != blank
        echo 'true'
      elsif settings.social_tumblr_link != blank
        echo 'true'
      elsif settings.social_vimeo_link != blank
        echo 'true'
      else
        echo 'false'
    endif
  endcapture
  
  capture strip_menu_layout_class
    if section.settings.section_menu_layout == 'menu_vertical'
      echo 'menu-strip--vertical'
      else
        echo ''
    endif
  endcapture

  capture show_socials_wrapper_col
    if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop
      echo 'true'
      elsif show_social_list == 'true' and section.settings.show_social_links
        echo 'true'
      else
        echo 'false'
    endif
  endcapture

  capture q_justify_mobile
    case section.settings.section_mobile_text_alignment
      when 'left'
        echo 'flex-start'
      when 'center'
        echo 'center'
      when 'right'
        echo 'flex-end'
    endcase
  endcapture

  capture q_justify_desktop
    case section.settings.section_text_alignment
      when 'left'
        echo 'flex-start'
      when 'center'
        echo 'center'
      when 'right'
        echo 'flex-end'
    endcase
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --mobile-q-align: {{ section.settings.section_mobile_text_alignment }};
    --mobile-justify-align: {{ q_justify_mobile }};
    --desktop-q-align: {{ section.settings.section_text_alignment }};
    --desktop-justify-align: {{ q_justify_desktop }};
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --q-align">
  <div class="{{ container_class }}">
    <div class="{{ section_prefix_class }}_wrapper">
      <div class="{{ section_prefix_class }}_menu-strip {{ strip_menu_layout_class }} menu-strip --q-align-justify">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <div class="menu-strip_col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="menu-strip_heading text-size--small mty">{{- block.settings.heading -}}</h2>
                {%- endif -%}
                {%- if block.settings.menu.links != blank -%}
                  <ul class="list-unstyled --q-align-justify {{ section_prefix_class }}--modify">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="--hover-underline">{{- link.title | escape -}}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      {%- if show_socials_wrapper_col == 'true' -%}
        <div class="{{ section_prefix_class }}_follow-wrap --q-align-justify --v-align-middle">
          {%- liquid
            if section.settings.show_social_links and show_social_list == 'true'
              render 'social-icons' | prefix_class: section_prefix_class | social_icons_enable: true | social_extra_class: '--q-align-justify'
            endif
          -%}
          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="{{ section_prefix_class }}_follow-link">
              {% # theme-check-disable %}
                {{- shop | login_button: action: 'follow' -}}
              {% # theme-check-enable %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.footer_top.name",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer_top.settings.show_social_list.content",
      "info": "t:sections.header.settings.show_social_list.info"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "t:sections.footer_top.settings.show_social_list.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer_top.settings.follow_shop.content",
      "info": "t:sections.footer_top.settings.follow_shop.info"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "label": "t:sections.footer_top.settings.follow_shop.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.footer_top.settings.text_alignment.desktop.label",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "section_mobile_text_alignment",
      "label": "t:sections.footer_top.settings.text_alignment.mobile.label",
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_menu_layout",
      "label": "t:sections.footer_top.settings.menu.layout.label",
      "info": "Only works if there are multiple menu blocks",
      "options": [
        {
          "value": "menu_horizontal",
          "label": "t:sections.footer_top.settings.menu.layout.options.opt_1.label"
        },
        {
          "value": "menu_vertical",
          "label": "t:sections.footer_top.settings.menu.layout.options.opt_2.label"
        }
      ],
      "default": "menu_vertical"
    },
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "t:sections.common.full_width.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.footer_top.blocks.menu.name",
      "type": "menu",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.common.heading.label",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer_top.blocks.menu.label",
          "info": "t:sections.footer_top.blocks.menu.info",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer_top.name",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Quick links"
          }
        }
      ]
    }
  ]
}
{% endschema %}
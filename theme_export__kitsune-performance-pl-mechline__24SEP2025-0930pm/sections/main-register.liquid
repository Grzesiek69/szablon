{{- 'component-breadcrumb.css' | asset_url | stylesheet_tag -}}
{{- 'main-register.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'main-register'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture main_heading
    if section.settings.heading != blank
      echo section.settings.heading
      else
        echo 'main_register.main_heading' | t
    endif
  endcapture

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture
-%}

{%- liquid
  if section.settings.show_breadcrumb
    render 'breadcrumb', prefix_class: section_prefix_class, scheme: section.settings.breadcrumb_color_scheme
  endif
-%}
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }}">
  <div class="container-fluid">
    <div class="{{ section_prefix_class }}_wrapper">
      {%- if section.settings.image != blank -%}
        <div class="{{ section_prefix_class }}_column {{ section_prefix_class }}_column--image">
          <div class="{{ section_prefix_class }}_img">
            {{- section.settings.image | image_url: width: 1944 | image_tag: class: 'object-fit object-fit--absolute', loading: loading_attr, alt: main_heading, widths: '972, 1944', sizes: '(max-width: 767px) 972vw, 1944vw' -}}
          </div>
        </div>
      {%- endif -%}
      <div class="{{ section_prefix_class }}_column {{ section_prefix_class }}_column--form align-holder align-holder--mcenter">
        <div class="{{ section_prefix_class }}_form-align align-holder_wrapper">
          {%- if section.settings.heading != blank -%}
            <header class="{{ section_prefix_class }}_heading-head --align-center">
              <h1 class="{{ section_prefix_class }}_heading --h-anchor-none {{ section_heading_size }} mty">
                {{- main_heading -}}
              </h1>
              <div class="{{ section_prefix_class }}_description text-size--medium mty">
                <p>{{- 'main_register.req_fields_text' | t -}}</p>
              </div>
            </header>
            {%- else -%}
              <header class="visually-hidden --align-center">
                <h1>
                  {{- main_heading -}}
                </h1>
              </header>
              <div class="{{ section_prefix_class }}_description text-size--medium mty">
                <p>{{- 'main_register.req_fields_text' | t -}}</p>
              </div>
          {%- endif -%}
          {%- form 'create_customer', novalidate: 'novalidate' -%}
            {%- if form.errors != blank -%}
              <strong class="form__message mty" role="alert" tabindex="-1" autofocus>
                {%- render 'icons-data', width: 22, height: 22, use_icon: true, icon_reference: 'error' -%}
                {{- 'main_register.error.heading' | t -}}
              </strong>
              <ul class="errors-list list-unstyled">
                {%- for field in form.errors -%}
                  <li class="errors-list_item">
                    {%- if field == 'form' -%}
                      {{- form.errors.messages[field] -}}
                      {%- else -%}
                        <smooth-anchor data-offset=".sticky-header-wrapper">
                          <a class="errors-list_link" href="#Registerform-{{ field }}">
                            {{- form.errors.translated_fields[field] | capitalize }}
                            {{ form.errors.messages[field] -}}
                          </a>
                        </smooth-anchor>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="{{ section_prefix_class }}_form-group">
              <label for="Registerform-firstname" class="{{ section_prefix_class }}_form-input-lable">
                {{- 'main_register.first_name' | t -}}
              </label>
              <input
                type="text"
                name="customer[first_name]"
                id="Registerform-firstname"
                {% if form.first_name %}
                  value="{{ form.first_name }}"
                {% endif %}
                autocomplete="given-name"
                placeholder="{{- 'main_register.first_name' | t -}}"
              >
            </div>
            <div class="{{ section_prefix_class }}_form-group">
              <label for="Registerform-lastname" class="{{ section_prefix_class }}_form-input-lable">
                {{- 'main_register.last_name' | t -}}
              </label>
              <input
                type="text"
                name="customer[last_name]"
                id="Registerform-lastname"
                {% if form.last_name %}
                  value="{{ form.last_name }}"
                {% endif %}
                autocomplete="family-name"
                placeholder="{{- 'main_register.last_name' | t -}}"
              >
            </div>
            <div class="{{ section_prefix_class }}_form-group">
              <label for="Registerform-email" class="{{ section_prefix_class }}_form-input-lable">
                {{- 'main_register.email_label' | t -}}
              </label>
              <input
                type="email"
                name="customer[email]"
                id="Registerform-email"
                {% if form.email %}
                  value="{{ form.email }}"
                {% endif %}
                spellcheck="false"
                autocapitalize="off"
                autocomplete="email"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="registerform-email-error"
                {% endif %}
                placeholder="{{ 'main_register.email_label' | t }}"
              >
              {%- if form.errors contains 'email'-%}
                <div id="Registerform-email-error" class="{{ section_prefix_class }}_error-wrapper" role="status">
                  <i class="{{ section_prefix_class }}_role-icn">
                    {%- render 'icons-data', width: 22, height: 22, use_icon: true, icon_reference: 'error' -%}
                  </i>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}.
                </div>
              {%- endif -%}
            </div>
            <div class="{{ section_prefix_class }}_form-group">
              <label for="Registerform-password" class="{{ section_prefix_class }}_form-input-lable">
                {{- 'main_register.pass_label' | t -}}
              </label>
              <input
                type="password"
                name="customer[password]"
                id="Registerform-password"
                aria-required="true"
                {% if form.errors contains 'password' %}
                  aria-invalid="true"
                  aria-describedby="registerform-password-error"
                {% endif %}
                placeholder="{{- 'main_register.pass_label' | t -}}"
              >
              {%- if form.errors contains 'password'-%}
                <div id="Registerform-password-error" class="{{ section_prefix_class }}_error-wrapper" role="status">
                  <i class="{{ section_prefix_class }}_role-icn">
                    {%- render 'icons-data', width: 22, height: 22, use_icon: true, icon_reference: 'error' -%}
                  </i>
                  {{- form.errors.translated_fields.password | capitalize }}
                  {{ form.errors.messages.password -}}.
                </div>
              {%- endif -%}
            </div>
            <div class="{{ section_prefix_class }}_btn-wrapper mty --align-center">
              <button type="submit" class="button button--primary {{ section_prefix_class }}_form-btn">
                <i class="button_icn">
                  {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'right-arrow' -%}
                </i>
                {{- 'main_register.btn_label' | t -}}
              </button>
            </div>
          {%- endform -%}
          <div class="{{ section_prefix_class }}_foot-wrapper text-size--large mty --align-center">
            <p>
              {{- 'main_register.already_account' | t }}
              <a href="{{- routes.account_login_url -}}" class="button button--link {{ section_prefix_class }}_register-link">
                {{- 'customer.login_account_label' | t -}}
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_register.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Create an account"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "header",
      "content": "t:sections.common.breadcrumb.content"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.common.breadcrumb.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_top_bdr",
      "label": "t:sections.common.breadcrumb.top_bdr.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_bdr",
      "label": "t:sections.common.breadcrumb.bottom_bdr.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "breadcrumb_color_scheme",
      "default": "scheme2",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.main_register.settings.banner.label",
      "info": "t:sections.main_register.settings.banner.info"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    }
  ]
}
{% endschema %}
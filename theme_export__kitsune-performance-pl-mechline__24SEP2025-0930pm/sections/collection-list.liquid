{{ 'component-collection-card.css' | asset_url | stylesheet_tag }}
{{ 'collection-list.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_prefix_class = 'collection-list'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture max_header_size
    echo settings.page_width | times: section.settings.max_header_size | divided_by: 100
  endcapture

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture container_class
    if section.settings.section_full_width
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 20px;
    --section-slider-radius: 8px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --align-{{ section.settings.section_text_alignment }}">
  <div class="{{ section_prefix_class }}_wrapper">
    {%- if section.settings.heading != blank or section.settings.section_description != blank -%}
      <div class="{{ container_class }}" style="--cp-width: {{ max_header_size }}">
        <header class="heading-head">
          {%- if section.settings.heading != blank-%}
            <h2 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">{{- section.settings.heading -}}</h2>
          {%- endif -%}
          {%- if section.settings.section_description != blank -%}
            <div class="{{ section_prefix_class }}_description text-size--{{ section.settings.section_text_size }} mty --word-break">
              <p>{{- section.settings.section_description -}}</p>
            </div>
          {%- endif -%}
        </header>
      </div>
    {%- endif -%}
    <div class="{{ container_class }}">
      {%- if section.settings.section_behavior_layout == 'scroll' -%}
        {%- liquid
          capture marquee_direction
            if section.settings.marquee_direction == 'marquee_forward'
              echo 'forward'
              else
                echo 'backward'
            endif
          endcapture
        -%}
        <marquee-component data-direction="{{ marquee_direction }}" data-pause-on-hover="{{ section.settings.marquee_on_hover }}" data-speed="{{ section.settings.marquee_speed }}">
          <div class="marquee-component">
            {%- if section.settings.section_collections != blank -%}
              {%- for card in section.settings.section_collections -%}
                <div class="{{ section_prefix_class }}_col marquee-component_col">
                  {%- render 'collection-card', card: card, prefix_class: section_prefix_class -%}
                </div>
              {%- endfor -%}
              {%- else -%}
                {%- for placeholder_card in (1..4) -%}
                  <div class="{{ section_prefix_class }}_col marquee-component_col">
                    {%- render 'collection-card-placeholder', prefix_class: section_prefix_class, index: forloop.index -%}
                  </div>
                {%- endfor -%}
            {%- endif -%}
          </div>
        </marquee-component>
        {%- else -%}
          <div class="{{ section_prefix_class }}_slider-wrapper">
            <splide-slider
              data-drag="true"
              data-autoplay="{{- section.settings.auto_play -}}"
              data-rewind="true"
              data-pause-on-hover="true"
              data-gap="18px"
              data-per-move="1"
              data-arrows="{{- section.settings.show_navigation -}}"
              data-pagination="{{- section.settings.show_pagination -}}"
              data-per-page="1"
              data-interval="{{- section.settings.change_slides_every | times: 1000 -}}"
              data-type="loop"
              data-padding="18px"
              data-breakpoints='{"responsive": {"414": {"perPage": 2},"640": {"perPage": 3},"992": {"perPage": 4},"1200": {"perPage": 6}}}'
            >
              <div class="splide">
                <div class="splide__track">
                  <div class="splide__list">
                    {%- if section.settings.section_collections != blank -%}
                      {%- for card in section.settings.section_collections -%}
                        <div class="splide__slide">
                          {%- render 'collection-card', card: card, prefix_class: section_prefix_class -%}
                        </div>
                      {%- endfor -%}
                      {%- else -%}
                        {%- for placeholder_card in (1..4) -%}
                          <div class="splide__slide">
                            {%- render 'collection-card-placeholder', prefix_class: section_prefix_class, index: forloop.index -%}
                          </div>
                        {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
                {%- if section.settings.show_navigation or section.settings.show_pagination -%}
                  <div class="container">
                    <div class="splide-controls --justify-center">
                      {%- if section.settings.show_navigation -%}
                        <button class="splide__arrow splide__arrow--prev btn-icn-ixi">
                          <span class="btn-icn-ixi_wrapper">
                            <span class="visually-hidden">{{- 'accessibility.slider.previous' | t -}}</span>
                            {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'left-arrow' -%}
                          </span>
                        </button>
                      {%- endif -%}
                      <ul class="splide__pagination" role="tablist" aria-label="{{- 'accessibility.slider.pagination_label' | t -}}"></ul>
                      {%- if section.settings.show_navigation -%}
                        <button class="splide__arrow splide__arrow--next btn-icn-ixi">
                          <span class="btn-icn-ixi_wrapper">
                            <span class="visually-hidden">{{- 'accessibility.slider.next' | t -}}</span>
                            {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'right-arrow' -%}
                          </span>
                        </button>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </splide-slider>
          </div>
      {%- endif -%}
    </div>
    {%- if section.settings.view_more_label != blank -%}
      <div class="container">
        <footer class="{{ section_prefix_class }}_foot --align-center">
          <a
            {% if section.settings.view_more_link != blank -%}href="{{ section.settings.view_more_link }}"{% else %}aria-disabled="true"{% endif %}
            class="button button--{{ section.settings.view_more_type }}"
            {% if section.settings.open_new_window %}target="_blank"{% endif %}
          >
            {{- section.settings.view_more_label -}}
          </a>
        </footer>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "collection_list",
      "label": "t:sections.common.lists.settings.collections.label",
      "id": "section_collections"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Collection list"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "Display a customizable list of collections with accompanying images to represent each category."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "max_header_size",
      "label": "t:sections.product_showcase.settings.max_header_size.label",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "t:sections.collection_list.settings.view_more_button.label"
    },
    {
      "type": "select",
      "id": "view_more_type",
      "label": "t:sections.common.button.settings.options.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.common.button.settings.options.opt_1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.common.button.settings.options.opt_2.label"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "url",
      "id": "view_more_link",
      "label": "t:sections.collection_list.settings.view_more_button.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_new_window",
      "label": "t:sections.common.target_blank.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.card.content"
    },
    {
      "type": "select",
      "id": "card_media_size",
      "label": "t:sections.common.media_size.settings.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.common.media_size.settings.options.opt_1.label"
        },
        {
          "value": "square",
          "label": "t:sections.common.media_size.settings.options.opt_2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.common.media_size.settings.options.opt_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.common.media_size.settings.options.opt_4.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "text_alignment",
      "id": "card_text_alignment",
      "label": "t:sections.collection_list.settings.heading_alignment.alignment.label",
      "default": "left"
    },
    {
      "type": "select",
      "id": "card_text_size",
      "label": "t:sections.collection_list.settings.heading_size.size.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:sections.collection_list.settings.show_product_count.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_radius",
      "label": "t:sections.collection_list.settings.remove_radius.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "t:sections.collection_list.settings.enable_border.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "t:sections.common.full_width.label",
      "default": true
    },
    {
      "type": "select",
      "id": "section_behavior_layout",
      "label": "t:sections.collection_list.settings.layout_type.label",
      "options": [
        {
          "value": "slideshow",
          "label": "t:sections.collection_list.settings.layout_type.options.opt_1.label"
        },
        {
          "value": "scroll",
          "label": "t:sections.collection_list.settings.layout_type.options.opt_2.label"
        }
      ],
      "default": "slideshow"
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.collection_list.settings.text.alignment.label",
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.scroll.content"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.common.scroll.settings.speed.label",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 10,
      "unit": "sec"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "t:sections.common.scroll.settings.direction.label",
      "options": [
        {
          "value": "marquee_backward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_1.label"
        },
        {
          "value": "marquee_forward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_2.label"
        }
      ],
      "default": "marquee_backward"
    },
    {
      "type": "checkbox",
      "label": "t:sections.common.scroll.settings.on_hover.label",
      "id": "marquee_on_hover",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.slideshow.content"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "t:sections.common.slideshow.auto_play.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.common.slideshow.show_arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:sections.common.slideshow.show_nav.label",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_every",
      "label": "t:sections.common.slideshow.interval.label",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 5,
      "unit": "s",
      "info": "t:sections.common.slideshow.interval.info"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name"
    }
  ]
}
{% endschema %}
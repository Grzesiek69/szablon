{{ 'password-footer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_prefix_class = 'password-footer'
-%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} scheme --align-center">
  <div class="container-fluid">
    <div class="{{ section_prefix_class }}_wrapper">
      <div class="password-footer_text text-size--large mty">
        <p>
          {{- 'password.footer.admin_link_html' | t -}}
        </p>
      </div> 
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.password.footer.name",
  "tag": "footer",
  "settings": [
  ]
}
{% endschema %}
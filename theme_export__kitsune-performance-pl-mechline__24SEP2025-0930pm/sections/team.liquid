{{ 'team.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_prefix_class = 'team'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture container_class
    if section.settings.section_full_width
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else 
        echo 'h'
    endcase
  endcapture

  capture marquee_direction
    if section.settings.marquee_direction == 'forward'
      echo 'forward'
      else
        echo 'backward'
    endif
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 100px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --columns-count: {{ section.settings.number_of_columns_on_desktop }};
    --mobile-columns-count: {{ section.settings.number_of_columns_on_mobile }};
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --align-{{ section.settings.section_text_alignment }}">
  <div class="{{ container_class }} {% if section.settings.section_full_width and section.settings.enable_marquee %}{{ section_prefix_class }}--full-width{% endif %}">
    <div class="{{ section_prefix_class }}_wrapper">
      {%- if section.settings.heading != blank or section.settings.section_description != blank -%}
        <header class="heading-head">
          {%- if section.settings.heading != blank -%}
            <h2 class="{{ section_prefix_class }}_heading --word-break {{ section_heading_size }} --h-anchor-none mty">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.section_description != blank -%}
            <div class="{{ section_prefix_class }}_description --word-break text-size--{{ section.settings.section_text_size }} mty">
              <p>{{- section.settings.section_description -}}</p>
            </div>
          {%- endif -%}
        </header>
      {%- endif -%}
      {%- if section.settings.enable_marquee -%}
        <marquee-component data-direction="{{ marquee_direction }}" data-pause-on-hover="{{ section.settings.marquee_on_hover }}" data-speed="{{ section.settings.marquee_speed }}">
          <div class="marquee-component">
            {%- for block in section.blocks -%}
              <div class="marquee-component_col">
                {%- render 'team-card', member: block, index: forloop.index -%}
              </div>
            {%- endfor -%}
          </div>
        </marquee-component>
        {%- else -%}
          <div class="grid {{ section_prefix_class }} --justify-center">
            {%- for block in section.blocks -%}
              <div class="grid_col" {{ block.shopify_attributes }}>
                {%- render 'team-card', member: block, index: forloop.index -%}
              </div>
            {%- endfor -%}
          </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.team.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Team"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label"
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "t:sections.common.full_width.label",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.common.text.settings.alignment.label",
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.scroll.content"
    },
    {
      "type": "checkbox",
      "label": "t:sections.common.scroll.label",
      "id": "enable_marquee",
      "default": false
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.common.scroll.settings.speed.label",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 15,
      "unit": "sec"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "t:sections.common.scroll.settings.direction.label",
      "options": [
        {
          "value": "backward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_1.label"
        },
        {
          "value": "forward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_2.label"
        }
      ],
      "default": "backward"
    },
    {
      "type": "checkbox",
      "label": "t:sections.common.scroll.settings.on_hover.label",
      "id": "marquee_on_hover",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.team.blocks.member.name",
      "type": "member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.team.blocks.member.settings.image.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.common.heading.label",
          "default": "Member name"
        },
        {
          "type": "text",
          "id": "designation",
          "label": "t:sections.common.designation.label",
          "default": "Designation"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.common.button.url"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "t:sections.common.target_blank.label",
          "default": true
        },
        {
          "type": "color_scheme",
          "id": "block_color_scheme",
          "default": "scheme3",
          "label": "t:sections.common.clr_scheme.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.team.name",
      "blocks": [
        {
          "type": "member",
          "settings": {
          }
        },
        {
          "type": "member",
          "settings": {
            "block_color_scheme": "scheme2"
          }
        },
        {
          "type": "member",
          "settings": {
          }
        },
        {
          "type": "member",
          "settings": {
            "block_color_scheme": "scheme2"
          }
        }
      ]
    }
  ]
}
{% endschema %}
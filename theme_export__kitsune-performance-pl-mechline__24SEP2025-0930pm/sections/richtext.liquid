{{ 'richtext.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_prefix_class = 'richtext'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture max_content_size
    echo settings.page_width | times: section.settings.max_content_size | divided_by: 100
  endcapture

  capture container_class
    if section.settings.section_full_width
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --align-{{ section.settings.section_text_alignment }}">
  <div class="{{ container_class }}" style="--cp-width: {{ max_content_size }}">
    <div class="{{ section_prefix_class }}_wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'caption' -%}
            {%- liquid
              capture block_text_size
                case block.settings.text_size
                  when 'heading_small'
                    echo 'h5'
                  when 'heading_x_small'
                    echo 'h6'
                  else
                    echo 'h'
                endcase
              endcapture
            -%}
            <strong class="{{ section_prefix_class }}_{{ block.type }} {{ block.type }} {{ block_text_size }} mty" style="--block-spacing: {{ block.settings.block_spacing }}px;" {{ block.shopify_attributes }}>{{- block.settings.heading -}}</strong>
          {%- when 'heading' -%}
            {%- liquid
              capture block_heading_size
                case block.settings.heading_size
                  when 'heading_xx_large'
                    echo 'h1'
                  when 'heading_x_large'
                    echo 'h2'
                  when 'heading_large'
                    echo 'h3'
                  when 'heading_medium'
                    echo 'h4'
                  else
                    echo 'h'
                endcase
              endcapture
            -%}
            <h2 class="{{ section_prefix_class }}_{{ block.type }} {{ block.type }} {{ block_heading_size }} --h-anchor-none mty" style="--block-spacing: {{ block.settings.block_spacing }}px;" {{ block.shopify_attributes }}>{{- block.settings.heading -}}</h2>
          {%- when 'description' -%}
            <div class="{{ section_prefix_class }}_{{ block.type }} {{ block.type }} text-size--{{ block.settings.text_size }} mty" style="--block-spacing: {{ block.settings.block_spacing }}px;" {{ block.shopify_attributes }}>{{- block.settings.heading -}}</div>
          {%- when 'button' -%}
            <div class="{{ section_prefix_class }}_{{ block.type }} mty" style="--block-spacing: {{ block.settings.block_spacing }}px;" {{ block.shopify_attributes }}>
              <a
                {% if block.settings.url != blank %}href="{{ block.settings.url -}}"{% else %}aria-disabled="true"{% endif %}
                {% if block.settings.open_new_window %}target="_blank"{% endif %}
                class="button button--{{ block.settings.type }}"
              >
                {{- block.settings.heading -}}
              </a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.richtext.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "range",
      "id": "max_content_size",
      "label": "t:sections.richtext.settings.max_content_size.label",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.common.text.settings.alignment.label",
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.richtext.blocks.caption.name",
      "type": "caption",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.common.text.label",
          "default": "Add a tagline"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "t:sections.common.text.settings.fz_sizes.label",
          "options": [
            {
              "value": "heading_x_small",
              "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
            },
            {
              "value": "heading_small",
              "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
            }
          ],
          "default": "heading_x_small"
        },
        {
          "type": "range",
          "id": "block_spacing",
          "label": "t:sections.common.blocks.settings.mb_margin.label",
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 25,
          "unit": "px"
        }
      ]
    },
    {
      "name": "t:sections.common.heading.name",
      "type": "heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.common.text.label",
          "default": "Talk about your brand"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.common.heading.size.label",
          "options": [
            {
              "value": "heading_xx_large",
              "label": "t:sections.common.heading.size.options.opt_1.label"
            },
            {
              "value": "heading_x_large",
              "label": "t:sections.common.heading.size.options.opt_2.label"
            },
            {
              "value": "heading_large",
              "label": "t:sections.common.heading.size.options.opt_3.label"
            },
            {
              "value": "heading_medium",
              "label": "t:sections.common.heading.size.options.opt_4.label"
            }
          ],
          "default": "heading_xx_large"
        },
        {
          "type": "range",
          "id": "block_spacing",
          "label": "t:sections.common.blocks.settings.mb_margin.label",
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 25,
          "unit": "px"
        }
      ]
    },
    {
      "name": "t:sections.common.description.name",
      "type": "description",
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "label": "t:sections.common.description.label",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "t:sections.common.text.settings.fz_sizes.label",
          "options": [
            {
              "value": "small",
              "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
            },
            {
              "value": "medium",
              "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
            },
            {
              "value": "large",
              "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
            }
          ],
          "default": "large"
        },
        {
          "type": "range",
          "id": "block_spacing",
          "label": "t:sections.common.blocks.settings.mb_margin.label",
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 50,
          "unit": "px"
        }
      ]
    },
    {
      "name": "t:sections.common.button.name",
      "type": "button",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.common.button.label",
          "default": "BUTTON LABEL"
        },
        {
          "type": "select",
          "id": "type",
          "label": "t:sections.common.button.settings.options.label",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.common.button.settings.options.opt_1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.common.button.settings.options.opt_2.label"
            }
          ],
          "default": "primary"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.common.button.url"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "t:sections.common.target_blank.label",
          "default": false
        },
        {
          "type": "range",
          "id": "block_spacing",
          "label": "t:sections.common.blocks.settings.mb_margin.label",
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 14,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.richtext.name",
      "blocks": [
        {
          "type": "caption",
          "settings": {
            "heading": "Add a tagline"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Talk about your brand"
          }
        },
        {
          "type": "description",
          "settings": {
            "heading": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
          }
        },
        {
          "type": "button",
          "settings": {
            "heading": "BUTTON LABEL"
          }
        },
        {
          "type": "button",
          "settings": {
            "heading": "BUTTON LABEL",
            "type": "secondary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
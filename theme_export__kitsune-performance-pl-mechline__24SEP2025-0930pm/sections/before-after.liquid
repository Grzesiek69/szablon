{{- 'before-after.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'before-after'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture loading_attr
    if section.index > 1
      echo 'lazy'
    else
      echo 'eager'
    endif
  endcapture

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  assign image_width = settings.page_width | minus: 30
  assign image_height = image_width | divided_by: 2
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
  }
{%- endstyle -%}
<script src="{{ 'before-after.js' | asset_url }}" defer="defer"></script>
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }}">
  <div class="container">
    <div class="{{ section_prefix_class }}_wrapper">
      {%- if section.settings.heading != blank or section.settings.section_description != blank -%}
        <header class="heading-head --align-center">
          {%- if section.settings.heading != blank -%}
            <h2 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">
              {{- section.settings.heading -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.section_description != blank -%}
            <div class="{{ section_prefix_class }}_description --word-break text-size--{{ section.settings.section_text_size }} mty">
              <p>{{- section.settings.section_description -}}</p>
            </div>
          {%- endif -%}
        </header>
      {%- endif -%}
      <div class="bf-outer-wrap">
        <before-after class="bf-wrapper" style="--after-placement: {{ section.settings.after_position }}%;">
          {%- if section.blocks.size > 1 -%}
            {%- for block in section.blocks -%}
              {%- assign image_alt = 'before_after.image_alt' | t: index: forloop.index -%}
              {%- case block.type -%}
                {%- when 'before' -%}
                  <div class="bf-wrapper_image bf-wrapper_image--before">
                    {%- if block.settings.image != blank -%}
                      {{- block.settings.image | image_url: width: image_width, height: image_height | image_tag: class: 'object-fit object-fit--absolute', alt: image_alt, loading: loading_attr, widths: '1350, 1920', sizes: '(max-width: 767px) 675vw, 1350vw' -}}
                      {%- else -%}
                        {{- 'hero-apparel-1' | placeholder_svg_tag: 'object-fit object-fit--absolute' -}}
                    {%- endif -%}
                  </div>
                {%- when 'after' -%}
                  <div class="bf-wrapper_image bf-wrapper_image--after">
                    {%- if block.settings.image != blank -%}
                      {{- block.settings.image | image_url: width: image_width, height: image_height | image_tag: class: 'object-fit object-fit--absolute', alt: image_alt, loading: loading_attr, widths: '1350, 1920', sizes: '(max-width: 767px) 675vw, 1350vw' -}}
                      {%- else -%}
                        {{- 'hero-apparel-2' | placeholder_svg_tag: 'object-fit object-fit--absolute' -}}
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
            <div class="bf-wrapper_pointer">
              <span class="bf-wrapper_point"></span>
              <input type="range" title="{{- section.settings.heading | strip_html | escape -}}" value="{{- section.settings.after_position -}}">
            </div>
            {%- else -%}
              <div class="bf-wrapper_error-text mty text-size--small --align-center">
                <p>{{- 'before_after.error_text' | t -}}</p>
              </div>
          {%- endif -%}
        </before-after>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.before_after.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Before/After"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "Showcase your product benefit by using before/after image comparison."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "t:sections.before_after.settings.cursor.content"
    },
    {
      "type": "range",
      "id": "after_position",
      "label": "t:sections.before_after.settings.cursor.position.label",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.before_after.blocks.before.name",
      "type": "before",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.before_after.settings.block_image.info"
        }
      ]
    },
    {
      "name": "t:sections.before_after.blocks.after.name",
      "type": "after",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.before_after.settings.block_image.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.before_after.name",
      "blocks": [
        {
          "type": "before",
          "settings": {
          }
        },
        {
          "type": "after",
          "settings": {
          }
        }
      ]
    }
  ]
}
{% endschema %}
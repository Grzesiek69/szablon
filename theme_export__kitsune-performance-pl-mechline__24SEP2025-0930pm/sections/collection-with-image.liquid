{{- 'collection-with-image.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'collection-with-image'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture cols_order_class
    if section.settings.section_text_order == 'row_reverse'
      echo '--row-reverse'
    endif
  endcapture

  capture cols_block_class
    if section.settings.block_text_order == 'row_reverse'
      echo '--row-reverse'
    endif
  endcapture

  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 20px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --mobile-q-align: {{ section.settings.section_mobile_text_alignment }};
    --desktop-q-align: {{ section.settings.section_text_alignment }};
  }
{%- endstyle -%}
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} {% if section.settings.show_bdr_bottom %}{{ section_prefix_class }}--bdr-bottom{% endif %} {% if section.settings.show_bdr_top %}{{ section_prefix_class }}--bdr-top{% endif %}">
  <div class="container">
    <div class="{{ section_prefix_class }}_wrapper {% unless section.settings.enable_separator %}reduce-gap{% endunless %} {% if section.settings.remove_radius %}remove-radius{% endif %} {{ cols_order_class }}">
      <div class="{{ section_prefix_class }}_col {{ section_prefix_class }}_col-description">
        {%- if section.settings.heading != blank or section.settings.section_description != blank -%}
          <header class="heading-head {% if section.settings.enable_separator %}heading-head_separator{% endif %} --q-align">
            {%- if section.settings.heading != blank-%}
              <h2 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">
                {{- section.settings.heading -}}
              </h2>
            {%- endif -%}
            {%- if section.settings.section_description != blank -%}
              <div class="{{ section_prefix_class }}_description --word-break text-size--{{ section.settings.section_text_size }} mty">
                <p>{{- section.settings.section_description -}}</p>
              </div>
            {%- endif -%}
          </header>
        {%- endif -%}
      </div>
      <div class="{{ section_prefix_class }}_col {{ section_prefix_class }}_col-collection">
        <div class="modern-design_detail {{ cols_block_class }}">
          <div class="modern-design_media">
            <div id="{{ section.id }}_image-wrapper" class="modern-design_img --media-size-{{ section.settings.section_media_size }}">
              {% comment %} template image placed here by javascript {% endcomment %}
            </div>
          </div>
          <div class="modern-design_outlet">
            <ul class="list-unstyled">
              {%- for block in section.blocks -%}
                {%- liquid
                  capture collection_title
                    if block.settings.collection == null
                      echo 'collection.title' | t
                      else
                        echo block.settings.collection.title
                    endif
                  endcapture
                -%}
                <li class="modern-design_list-item">
                  {%- liquid
                    capture aspect_ratio
                      if block.settings.image != null
                        echo block.settings.image.aspect_ratio
                        else
                          if block.settings.collection.featured_image != null
                            echo block.settings.collection.featured_image.aspect_ratio
                            else
                              echo '0.8'
                          endif
                      endif
                    endcapture
                  -%}
                  <hover-component data-desktop-only="true" data-ref-parent=".{{ section_prefix_class }}-{{ section.id }}" {% if request.design_mode %}data-enable-editor-mode="true"{% endif %} data-aspect-ratio="{{- aspect_ratio -}}" data-reference="{{ section.id }}_image-wrapper">
                    <a {% if block.settings.collection != blank %}href="{{- block.settings.collection.url -}}"{% else %}aria-disabled="true"{% endif %} class="modern-design_link --word-break --align-left {% if forloop.first %}modern-design_link--active{% endif %}" {{ block.shopify_attributes }}>
                      <span>{{- collection_title -}}</span>
                      {%- render 'icons-data', width: 13, height: 13, use_icon: true, icon_reference: 'arrow-pointer' -%}
                      <template>
                        {%- if block.settings.image != null -%}
                          {%- liquid
                            capture image_alt
                              if block.settings.image.alt == blank
                                echo 'accessibility.image.label' | t: index: forloop.index
                                else
                                  echo block.settings.image.alt
                              endif
                            endcapture 
                          -%}
                          {{- block.settings.image | image_url: width: 1920 | image_tag: class: 'object-fit object-fit--absolute', loading: loading_attr, alt: '', widths: '1920', sizes: '(min-width: 50px) 1920px' -}}
                          {%- else -%}
                            {%- if block.settings.collection.featured_image != null -%}
                              {%- liquid
                                capture image_alt
                                  if block.settings.collection.featured_image.alt == blank
                                    echo 'accessibility.image.label' | t: index: forloop.index
                                    else
                                      echo block.settings.collection.featured_image.alt
                                  endif
                                endcapture 
                              -%}
                              {{- block.settings.collection.featured_image | image_url: width: 1920 | image_tag: class: 'object-fit object-fit--absolute', alt: '', loading: loading_attr, widths: '1920', sizes: '(min-width: 50px) 1920px' -}}
                              {%- else -%}
                                {%- liquid
                                  capture placeholder_image
                                    if forloop.index > 4
                                      echo 'collection-apparel-1'
                                      else
                                        echo 'collection-apparel-' | append: forloop.index
                                    endif
                                  endcapture
                                -%}
                                {{- placeholder_image | placeholder_svg_tag: 'object-fit object-fit--absolute' -}}
                            {%- endif -%}
                        {%- endif -%}
                      </template>
                    </a>
                  </hover-component>
                </li>
              {%- endfor -%}
            </ul>
            {%- if section.settings.view_more_label != blank -%}
              <footer class="{{ section_prefix_class }}_foot">
                <a
                  {% if section.settings.view_more_link != blank %}href="{{ section.settings.view_more_link }}"{% else %}aria-disabled="true"{% endif %}
                  class="button button--{{ section.settings.view_more_type }} modern-design_btn"
                  {% if section.settings.open_new_window %}target="_blank"{% endif %}
                >
                  {{- section.settings.view_more_label -}}
                </a>
              </footer>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_with_image.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Collection list with image"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "Display product collections with images, customizable for seasonal highlights or promotions."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "t:sections.collection_with_image.settings.view_more_button.label",
      "default": "BUTTON LABEL"
    },
    {
      "type": "select",
      "id": "view_more_type",
      "label": "t:sections.collection_with_image.settings.view_more_button.type.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.common.button.settings.options.opt_1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.common.button.settings.options.opt_2.label"
        }
      ],
      "default": "primary"
    },
    {
      "type": "url",
      "id": "view_more_link",
      "label": "t:sections.collection_with_image.settings.view_more_button.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_new_window",
      "label": "t:sections.common.target_blank.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "select",
      "id": "section_text_order",
      "label": "t:sections.collection_with_image.settings.collection_order.label",
      "options": [
        {
          "value": "row",
          "label": "t:sections.collection_with_image.settings.collection_order.options.opt_1.label"
        },
        {
          "value": "row_reverse",
          "label": "t:sections.collection_with_image.settings.collection_order.options.opt_2.label"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "block_text_order",
      "label": "t:sections.collection_with_image.settings.block_order.label",
      "options": [
        {
          "value": "row",
          "label": "t:sections.collection_with_image.settings.block_order.options.opt_1.label"
        },
        {
          "value": "row_reverse",
          "label": "t:sections.collection_with_image.settings.block_order.options.opt_2.label"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "section_media_size",
      "label": "t:sections.common.media_size.settings.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.common.media_size.settings.options.opt_1.label"
        },
        {
          "value": "square",
          "label": "t:sections.common.media_size.settings.options.opt_2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.common.media_size.settings.options.opt_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.common.media_size.settings.options.opt_4.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.collection_with_image.settings.text_alignment.desktop.label",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "section_mobile_text_alignment",
      "label": "t:sections.collection_with_image.settings.text_alignment.mobile.label",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_bdr_top",
      "label": "t:sections.product_showcase.settings.show_bdr_top.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bdr_bottom",
      "label": "t:sections.product_showcase.settings.show_bdr_bottom.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_separator",
      "label": "t:sections.collection_with_image.settings.enable_separator.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_radius",
      "label": "t:sections.collection_with_image.settings.remove_radius.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.collection_with_image.blocks.collection.name",
      "type": "collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_with_image.blocks.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_with_image.blocks.collection.settings.image.label",
          "info": "t:sections.collection_with_image.blocks.collection.settings.image.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_with_image.name",
      "blocks": [
        {
          "type": "collection",
          "settings": {
          }
        },
        {
          "type": "collection",
          "settings": {
          }
        },
        {
          "type": "collection",
          "settings": {
          }
        },
        {
          "type": "collection",
          "settings": {
          }
        },
        {
          "type": "collection",
          "settings": {
          }
        }
      ]
    }
  ]
}
{% endschema %}
{{- 'logo-list.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'logo-list'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture container_class
    if section.settings.section_full_width
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture

  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture

  capture logo_height_class
    case section.settings.logo_height
      when 'small'
        echo '--small-height'
      when 'medium'
        echo '--medium-height'
      when 'large'
        echo '--large-height'
    endcase
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --cp-spacer-right: 10px;
    --cp-spacer-left: 10px;
    /* --cp-spacer-right: 17px;
    --cp-spacer-left: 17px; */
  }
{%- endstyle -%}
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --align-center {% if section.settings.reduce_spacing %}--reduce-spacing{% endif %} {% if section.settings.section_border_top %}--border-top{% endif %} {% if section.settings.section_border_bottom %}--border-bottom{% endif %}">
  <div class="{{ container_class }}">
    <div class="{{ section_prefix_class }}_wrapper">
      {%- if section.settings.heading != blank -%}
        <header class="{{ section_prefix_class }}_heading-wrapper {{ section_prefix_class }}_col">
            <h2 class="{{ section_prefix_class }}_heading --h-anchor-none">{{- section.settings.heading -}}</h2>
          </header>
      {%- endif -%}
      <div class="{{ section_prefix_class }}_col {{ section_prefix_class }}_list-wrapper">
        {%- if section.settings.enable_marquee -%}
          {%- liquid
            capture marquee_direction
              if section.settings.marquee_direction == 'marquee_forward'
                echo 'forward'
                else
                  echo 'backward'
              endif
            endcapture
          -%}
          <marquee-component data-direction="{{ marquee_direction }}" data-pause-on-hover="{{ section.settings.marquee_on_hover }}" data-speed="{{ section.settings.marquee_speed }}">
            <div class="marquee-component">
              {%- for block in section.blocks -%}
                <div class="marquee-component_col {{ logo_height_class }}">
                  <span class="{{ section_prefix_class }}_list-logo">
                    {%- if block.settings.image != blank -%}
                      {%- liquid
                        capture image_alt
                          if block.settings.image.alt == blank
                            echo 'accessibility.image.label' | t: index: forloop.index
                            else
                              echo block.settings.image.alt
                          endif
                        endcapture 
                      -%}
                      {{- block.settings.image | image_url: width: 350 | image_tag: sizes: '(min-width: 50px) 350px', alt: image_alt, widths: '350', loading: loading_attr -}}
                      {%- else -%}
                        {{- 'lifestyle-1' | placeholder_svg_tag: 'img-placeholder' -}}
                    {%- endif -%}
                  </span>
                </div>
              {%- endfor -%}
            </div>
          </marquee-component>
          {%- else -%}
            <ul class="list-unstyled {{ section_prefix_class }}_list">
              {%- for block in section.blocks -%}
                <li class="{{ logo_height_class }}" {{ block.shopify_attributes }}>
                  <span class="{{ section_prefix_class }}_list-logo">
                    {%- if block.settings.image != blank -%}
                      {%- liquid
                       capture image_alt
                        if block.settings.image.alt == blank
                          echo 'accessibility.image.label' | t: index: forloop.index
                          else
                            echo block.settings.image.alt
                        endif
                       endcapture 
                      -%}
                      {{- block.settings.image | image_url: width: 350 | image_tag: sizes: '(min-width: 50px) 350px', alt: image_alt, widths: '350', loading: loading_attr -}}
                      {%- else -%}
                        {{- 'lifestyle-1' | placeholder_svg_tag: 'img-placeholder' -}}
                    {%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.logo_list.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "LOGO LIST"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "select",
      "id": "logo_height",
      "label": "t:sections.logo_list.settings.logo_height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.logo_list.settings.logo_height.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.logo_list.settings.logo_height.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.logo_list.settings.logo_height.options.opt_3.label"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "section_border_top",
      "label": "Show Border Top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "section_border_bottom",
      "label": "Show Border Bottom",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "t:sections.common.full_width.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme2",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.scroll.content"
    },
    {
      "type": "checkbox",
      "label": "t:sections.common.scroll.label",
      "id": "enable_marquee",
      "default": true
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.common.scroll.settings.speed.label",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 15,
      "unit": "sec"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "t:sections.common.scroll.settings.direction.label",
      "options": [
        {
          "value": "marquee_backward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_1.label"
        },
        {
          "value": "marquee_forward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_2.label"
        }
      ],
      "default": "marquee_backward"
    },
    {
      "type": "checkbox",
      "label": "t:sections.common.scroll.settings.on_hover.label",
      "id": "marquee_on_hover",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.logo_list.blocks.logo.name",
      "type": "logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.logo_list.blocks.logo.settings.image.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo_list.name",
      "blocks": [
        {
          "type": "logo",
          "settings": {}
        },
        {
          "type": "logo",
          "settings": {}
        },
        {
          "type": "logo",
          "settings": {}
        },
        {
          "type": "logo",
          "settings": {}
        },
        {
          "type": "logo",
          "settings": {}
        },
        {
          "type": "logo",
          "settings": {}
        },
        {
          "type": "logo",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
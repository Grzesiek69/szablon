{{- 'scrolling-banner.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'scrolling-banner'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture container_class
    if section.settings.section_full_width
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture

  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture

  assign marquee_direction = 'backward'
  if section.settings.marquee_direction == 'marquee_forward'
    assign marquee_direction = 'forward'
  endif
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius-small: 10px;
    --section-radius-large: 999px;
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }}">
  <div class="{{ container_class }}">
    <div class="{{ section_prefix_class }}_wrapper">
      <marquee-component data-direction="{{ marquee_direction }}" data-pause-on-hover="{{ section.settings.marquee_on_hover }}" data-speed="{{ section.settings.marquee_speed }}">
        <div class="marquee-component {% unless section.settings.show_separator %}marquee-component--seperator{% endunless %}">
          {%- for block in section.blocks -%}
            {%- liquid
              capture block_color_scheme
                echo block.settings.block_color_scheme | prepend: 'scheme scheme--'
              endcapture

              capture a11y_text
                echo block.settings.subheading | default: block.settings.heading
              endcapture
            -%}
            <div class="marquee-component_col">
              {%- if block.settings.link_url != blank -%}
                <a href="{{ block.settings.link_url }}" {% if block.settings.open_new_window %}target="_blank"{% endif %} class="{{ section_prefix_class }}_column {{ block_color_scheme }}">
                {% else %}
                  <div class="{{ section_prefix_class }}_column {{ block_color_scheme }} {% if block.settings.enable_custom_radius %}--custom-radius{% endif %}" {% if block.settings.enable_custom_radius %}style="--custom-radius: {{ block.settings.custom_radius }}px;"{% endif %}>
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <div class="{{ section_prefix_class }}_image-wrap">
                    {{- block.settings.image | image_url: width: 350 | image_tag: sizes: '350vw', alt: '', class: 'object-fit object-fit--cover object-fit--absolute', loading: loading_attr -}}
                  </div>
                {%- endif -%}
                <div class="{{ section_prefix_class }}_text-wrap">
                  {%- if block.settings.heading != blank -%}
                    <strong class="{{ section_prefix_class }}_heading">{{- block.settings.heading | escape -}}</strong>
                  {%- endif -%}
                  {%- if block.settings.subheading != blank -%}
                    <strong class="{{ section_prefix_class }}_subheading">{{- block.settings.subheading | escape -}}</strong>
                  {%- endif -%}
                </div>
                {%- if block.settings.link_url != blank -%}
                    <span class="visually-hidden">
                      {{- a11y_text -}}
                    </span>
                  </a>
                {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </marquee-component>
    </div>
  </div>
</div>

{% schema %}

{
  "name": "t:sections.scrolling_banner.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "t:sections.common.scroll.settings.show_separator.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "t:sections.common.full_width.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.scroll.content"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.common.scroll.settings.speed.label",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 15,
      "unit": "sec"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "t:sections.common.scroll.settings.direction.label",
      "options": [
        {
          "value": "marquee_backward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_1.label"
        },
        {
          "value": "marquee_forward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_2.label"
        }
      ],
      "default": "marquee_backward"
    },
    {
      "type": "checkbox",
      "label": "t:sections.common.scroll.settings.on_hover.label",
      "id": "marquee_on_hover",
      "default": false
    }
  ],
  "blocks": [
    {
      "name": "t:sections.scrolling_banner.blocks.banner.name",
      "type": "banner",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_custom_radius",
          "label": "t:sections.common.scroll.blocks.settings.enable_custom_radius.label",
          "default": false
        },
        {
          "type": "range",
          "id": "custom_radius",
          "label": "t:sections.common.scroll.blocks.settings.custom_radius.label",
          "min": 0,
          "max": 99,
          "step": 1,
          "default": 10,
          "unit": "px",
          "visible_if": "{{ block.settings.enable_custom_radius == true }}"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.scrolling_banner.blocks.banner.settings.image.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.common.heading.label",
          "default": "Your scrolling text here"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:sections.common.subheading.label",
          "default": "Subheading"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:sections.scrolling_banner.blocks.banner.settings.url.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "t:sections.common.target_blank.label",
          "default": false
        },
        {
          "type": "color_scheme",
          "id": "block_color_scheme",
          "default": "scheme2",
          "label": "t:sections.common.clr_scheme.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.scrolling_banner.name",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "block_color_scheme": "scheme2"
          }
        },
        {
          "type": "banner",
          "settings": {
            "block_color_scheme": "scheme3"
          }
        },
        {
          "type": "banner",
          "settings": {
            "block_color_scheme": "scheme2"
          }
        },
        {
          "type": "banner",
          "settings": {
            "block_color_scheme": "scheme3"
          }
        },
        {
          "type": "banner",
          "settings": {
            "block_color_scheme": "scheme2"
          }
        },
        {
          "type": "banner",
          "settings": {
            "block_color_scheme": "scheme3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
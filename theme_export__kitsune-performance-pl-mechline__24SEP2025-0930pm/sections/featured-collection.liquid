{{- 'component-product-featured-card.css' | asset_url | stylesheet_tag -}}
{{- 'featured-collection.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'featured-collection'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture cols_order_class
    if section.settings.section_text_order == 'row_reverse'
      echo '--row-reverse'
    endif
  endcapture

  capture show_more_button
    if section.settings.section_collection.all_products_count > section.settings.products_to_show
      echo 'true'
      else
        echo 'false'
    endif
  endcapture

  capture description_hidden
    if section.settings.heading != blank
      echo 'false'
      elsif section.settings.section_description != blank
        echo 'false'
      else
        echo 'true'
    endif
  endcapture

  capture splide_arrows_orientation
    if description_hidden == 'false'
      echo '--justify-start'
      else
        echo '--justify-center'
    endif
  endcapture

  capture slider_direction
    if description_hidden == 'false' and section.settings.section_text_order == 'row_reverse'
      echo 'rtl'
    endif
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 20px;
    --section-slider-radius: 8px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --mobile-q-align: {{ section.settings.section_mobile_text_alignment }};
    --desktop-q-align: {{ section.settings.section_text_alignment }};
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --q-align {% if description_hidden == 'true' %}--featured-only{% endif %}">
  <div class="{% unless description_hidden == 'false' %}container{% else %}container-fluid{% endunless %}">
    <div class="{{ section_prefix_class }}_wrapper {{ cols_order_class }}">
      {%- if description_hidden == 'false' -%}
        <div class="{{ section_prefix_class }}_col {{ section_prefix_class }}_col-description">
          <header class="heading-head">
            {%- if section.settings.heading != blank -%}
              <h2 class="{{ section_prefix_class }}_heading --h-anchor-none {{ section_heading_size }} mty">
                {{- section.settings.heading -}}
              </h2>
            {%- endif -%}
            {%- if section.settings.section_description != blank -%}
              <div class="{{ section_prefix_class }}_description --word-break text-size--{{ section.settings.section_text_size }} mty">
                <p>{{- section.settings.section_description -}}</p>
              </div>
            {%- endif -%}
            {%- if section.settings.enable_show_more_button and show_more_button == 'true' -%}
              <a
                href="{{- section.settings.section_collection.url -}}"
                class="button button--{{ section.settings.view_more_type }} mty {{ section_prefix_class }}_btn-more"
              >
                {%- if section.settings.view_more_label != blank -%}
                  {{- section.settings.view_more_label | escape -}}
                  {%- else -%}
                    {{- 'collection.view_all_button_label' | t -}}
                {%- endif -%}
              </a>
            {%- endif -%}
          </header>
        </div>
      {%- endif -%}
      <div class="{{ section_prefix_class }}_col {{ section_prefix_class }}_col-slider {% if slider_direction == 'rtl' %}{{ section_prefix_class }}_slider--reversed{% endif %}">
        <div class="{{ section_prefix_class }}_slider-wrapper widget--styles">
          <splide-slider
            data-drag="true"
            data-autoplay="{{- section.settings.auto_play -}}"
            data-rewind="true"
            data-pause-on-hover="true"
            data-gap="0"
            data-per-move="1"
            data-arrows="{{- section.settings.show_navigation -}}"
            data-pagination="false"
            data-per-page="1"
            data-fixed-width="282px"
            data-focus="center"
            data-interval="{{- section.settings.change_slides_every | times: 1000 -}}"
            {% if description_hidden == 'false' %}
              {% if section.settings.section_text_order == 'row_reverse' %}
                data-breakpoints='{"responsive": {"768": {"fixedWidth": "282px", "focus": "", "direction": "{{ slider_direction }}"}}}'
                {% else %}
                  data-breakpoints='{"responsive": {"768": {"fixedWidth": "282px", "focus": ""}}}'
              {% endif %}
              {% else %}
                data-breakpoints='{"responsive": {"768": {"fixedWidth": "282px", "focus": "center"}}}'
            {% endif %}
            data-type="slide"
          >
            <div class="splide">
              <div class="splide__track">
                <div class="splide__list">
                  {%- if section.settings.section_collection != blank and section.settings.section_collection.products != blank -%}
                    {%- for product in section.settings.section_collection.products limit: section.settings.products_to_show -%}
                      <div class="splide__slide">
                        {%- render 'product-featured-card', product: product, index: forloop.index, show_sec_image: section.settings.show_sec_image -%}
                      </div>
                    {%- endfor -%}
                    {%- else -%}
                      {%- for placeholder_card in (1..4) -%}
                        <div class="splide__slide">
                          {%- render 'product-featured-card-placeholder', index: forloop.index -%}
                        </div>
                      {%- endfor -%}
                  {%- endif -%}
                </div>
              </div>
              {%- if section.settings.show_navigation -%}
                {%- if section.settings.section_text_order == 'row_reverse' -%}
                  {%- if description_hidden == 'true' -%}
                    <div class="splide-controls {{ splide_arrows_orientation }}">
                      <button class="splide__arrow splide__arrow--prev btn-icn-ixi">
                        <span class="btn-icn-ixi_wrapper">
                          <span class="visually-hidden" style="background-color: var(--a11y-bg-sparrow); color: var(--a11y-clr-sparrow);">{{- 'accessibility.slider.previous' | t -}}</span>
                          {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'left-arrow' -%}
                        </span>
                      </button>
                      <button class="splide__arrow splide__arrow--next btn-icn-ixi">
                        <span class="btn-icn-ixi_wrapper">
                          <span class="visually-hidden" style="background-color: var(--a11y-bg-sparrow); color: var(--a11y-clr-sparrow);">{{- 'accessibility.slider.next' | t -}}</span>
                          {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'right-arrow' -%}
                        </span>
                      </button>
                    </div>
                    {%- else -%}
                      <div class="splide-controls {{ splide_arrows_orientation }}">
                        <button class="splide__arrow splide__arrow--prev btn-icn-ixi">
                          <span class="btn-icn-ixi_wrapper">
                            <span class="visually-hidden" style="background-color: var(--a11y-bg-sparrow); color: var(--a11y-clr-sparrow);">{{- 'accessibility.slider.previous' | t -}}</span>
                            {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'right-arrow' -%}
                          </span>
                        </button>
                        <button class="splide__arrow splide__arrow--next btn-icn-ixi">
                          <span class="btn-icn-ixi_wrapper">
                            <span class="visually-hidden" style="background-color: var(--a11y-bg-sparrow); color: var(--a11y-clr-sparrow);">{{- 'accessibility.slider.next' | t -}}</span>
                            {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'left-arrow' -%}
                          </span>
                        </button>
                      </div>
                    {%- endif -%}
                  {%- else -%}
                    <div class="splide-controls {{ splide_arrows_orientation }}">
                      <button class="splide__arrow splide__arrow--prev btn-icn-ixi">
                        <span class="btn-icn-ixi_wrapper">
                          <span class="visually-hidden" style="background-color: var(--a11y-bg-sparrow); color: var(--a11y-clr-sparrow);">{{- 'accessibility.slider.previous' | t -}}</span>
                          {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'left-arrow' -%}
                        </span>
                      </button>
                      <button class="splide__arrow splide__arrow--next btn-icn-ixi">
                        <span class="btn-icn-ixi_wrapper">
                          <span class="visually-hidden" style="background-color: var(--a11y-bg-sparrow); color: var(--a11y-clr-sparrow);">{{- 'accessibility.slider.next' | t -}}</span>
                          {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'right-arrow' -%}
                        </span>
                      </button>
                    </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </splide-slider>
        </div>
      </div>
    </div>
    {%- if description_hidden == 'true' and section.settings.enable_show_more_button and show_more_button == 'true' -%}
      <footer class="{{ section_prefix_class }}_foot --align-center mty">
        <a
          href="{{- section.settings.section_collection.url -}}"
          class="button button--{{ section.settings.view_more_type }} {{ section_prefix_class }}_btn-more"
        >
          {%- if section.settings.view_more_label != blank -%}
            {{- section.settings.view_more_label | escape -}}
            {%- else -%}
              {{- 'collection.view_all_button_label' | t -}}
          {%- endif -%}
        </a>
      </footer>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "collection",
      "label": "t:sections.featured_collection.settings.collection.label",
      "id": "section_collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "t:sections.featured_collection.settings.products_to_show.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "Highlight a special range with imagery, perfect for showcasing new or featured items."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "enable_show_more_button",
      "label": "t:sections.featured_collection.settings.view_more_button.label",
      "default": false
    },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "t:sections.featured_collection.settings.view_more_button.button_label.label"
    },
    {
      "type": "select",
      "id": "view_more_type",
      "label": "t:sections.common.button.settings.options.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.common.button.settings.options.opt_1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.common.button.settings.options.opt_2.label"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "t:sections.common.card.content"
    },
    {
      "type": "select",
      "id": "card_text_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "card_show_price",
      "label": "t:sections.featured_collection.settings.price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sec_image",
      "label": "t:sections.featured_collection.settings.show_sec_image.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "select",
      "id": "section_text_order",
      "label": "t:sections.featured_collection.settings.collection_order.label",
      "options": [
        {
          "value": "row",
          "label": "t:sections.featured_collection.settings.collection_order.options.opt_1.label"
        },
        {
          "value": "row_reverse",
          "label": "t:sections.featured_collection.settings.collection_order.options.opt_2.label"
        }
      ],
      "default": "row"
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.featured_collection.settings.text_alignment.desktop.label",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "section_mobile_text_alignment",
      "label": "t:sections.featured_collection.settings.text_alignment.mobile.label",
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.slideshow.content"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "t:sections.common.slideshow.auto_play.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.common.slideshow.show_arrows.label",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_every",
      "label": "t:sections.common.slideshow.interval.label",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 5,
      "unit": "s",
      "info": "t:sections.common.slideshow.interval.info"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
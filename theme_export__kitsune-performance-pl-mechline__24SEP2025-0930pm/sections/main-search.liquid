{{- 'component-breadcrumb.css' | asset_url | stylesheet_tag -}}
{{- 'component-blog-card.css' | asset_url | stylesheet_tag -}}
{{- 'component-pagination.css' | asset_url | stylesheet_tag -}}
{{- 'component-facets.css' | asset_url | stylesheet_tag -}}
{{- 'component-collection-grid.css' | asset_url | stylesheet_tag -}}
{{- 'componenet-product-column-card.css' | asset_url | stylesheet_tag -}}
{{- 'collection-products-grid.css' | asset_url | stylesheet_tag -}}
{%- if section.settings.bt_btns_layout == 'enable_atc_guick_view' or section.settings.bt_btns_layout == 'enable_quick_view' -%}
  {{- 'component-product-quick-view.css' | asset_url | stylesheet_tag -}}
{%- endif -%}
{{- 'main-search.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'collection-products'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      when 'heading_small'
        echo 'h5'
      when 'heading_x_small'
        echo 'h6'
      else
        echo 'h'
    endcase
  endcapture

  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture

  assign sort_by = search.sort_by | default: search.default_sort_by
  if search.url
    assign results_url = search.url
    else
      assign terms = search.terms | escape
      assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif

  capture sort_value
    for option in search.sort_options
      if option.value == sort_by
        echo option.value
      endif
    endfor
  endcapture

  capture max_results_to_show
    echo section.settings.number_of_columns_on_desktop | times: section.settings.number_of_rows_on_desktop
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 20px;
    --section-slider-radius: 8px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --columns-count: {{ section.settings.number_of_columns_on_desktop }};
  }

  {%- assign query = section.settings.mob_cols_query | append: 'px' -%}
  @media (min-width: {{ query }}) and (max-width: 767px){
    .{{ section_prefix_class }}-{{ section.id }}{
      --desktop-columns-count: {{ section.settings.number_of_columns_on_mobile }};
    }
  }
{%- endstyle -%}
<script src="{{ 'filters.js' | asset_url }}" defer="defer"></script>
{%- liquid
  if section.settings.show_breadcrumb
    render 'breadcrumb', prefix_class: section_prefix_class, scheme: section.settings.breadcrumb_color_scheme
  endif
-%}
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --align-{{ section.settings.section_text_alignment }} {% if section.settings.remove_radius %}remove-radius{% endif %}">
  <div class="container" style="--cp-width: 940;">
    <div class="{{ section_prefix_class }}_wrapper">
      <header class="heading-head --align-center">
        <h1 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">
          {{- 'main_search.heading' | t -}}
        </h1>
        {%- if section.settings.section_description != blank -%}
          <div class="{{ section_prefix_class }}_description text-size--{{ section.settings.section_text_size }} mty">
            <p>{{- section.settings.section_description -}}</p>
          </div>
        {%- endif -%}
        <div class="{{ section_prefix_class }}_search-wrap">
          {%- render 'search-bar', predictive: false, prefix_class: section_scheme_class, search_value: search.terms, reset_btn: false -%}
        </div>
        <div class="{{ section_prefix_class }}_results-wrap mty text-size--large">
          {%- liquid
            capture results_text
              if search.performed
                echo 'main_search.results_with_count_and_term' | t: count: search.results_count, terms: search.terms
                else
                  echo 'main_search.s_for' | t
              endif
            endcapture
          -%}
          <p>
            {{- results_text -}}
          </p>
        </div>
      </header>
    </div>
  </div>
  {%- if search.performed -%}
    <div class="container">
      {%- if section.settings.enable_filtering -%}
        {%- assign active_filters_size = 0 -%}
        <div data-render-active-facets="">
          <div class="facets-active --v-align-middle">
            <div class="facets-active_wrapper">
              {%- for filter in search.filters -%}
                {%- for value in filter.active_values -%}
                  {%- assign active_filters_size = active_filters_size | plus: 1 -%}
                  <facet-remove-button data-form-selector="filters-form[data-section='{{- section.id -}}'] form" data-for="Filter-{{ filter.label | replace: ' ', '' | escape }}-{{ value.label | replace: ' ', '' }}">
                    <button type="button" class="facet-remove-btn button button--facet --v-align-middle">
                      {{- value.label | escape -}}
                      <i class="facet-remove_icn">
                        {%- render 'icons-data', width: 8, height: 8, use_icon: true, icon_reference: 'cross' -%}
                      </i>
                    </button>
                  </facet-remove-button>
                {%- endfor -%}
                {%- if filter.type == 'price_range' -%}
                  {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                    {%- assign active_filters_size = active_filters_size | plus: 1 -%}
                    <facet-remove-button data-form-selector="filters-form[data-section='{{- section.id -}}'] form" data-is-price="true">
                      <button type="button" class="facet-remove-btn button button--facet --v-align-middle">
                        {%- liquid
                          if filter.min_value.value
                            echo filter.min_value.value | money
                            else
                              echo 0 | money
                          endif
                          echo ' - '
                          if filter.max_value.value
                            echo filter.max_value.value | money
                            else
                              echo filter.range_max | money
                          endif
                        -%}
                        <i class="facet-remove_icn">
                          {%- render 'icons-data', width: 8, height: 8, use_icon: true, icon_reference: 'cross' -%}
                        </i>
                      </button>
                    </facet-remove-button>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              <facet-remove-button data-form-selector="filters-form[data-section='{{- section.id -}}'] form" data-clear-all="true">
                <button type="button" class="facets-remove-all button button--link --hover-underline" data-url="{{- results_url -}}">
                  {{- 'products_grid.filters.clear_all' | t -}}
                </button>
              </facet-remove-button>
            </div>
            {%- if section.settings.enable_sorting -%}
              <div class="dropdown-component dropdown-component--sorting" data-render-sort="">
                <strong id="{{ section.id }}-sort-select-heading" class="visually-hidden" role="heading" aria-level="2">
                  {{- 'localization.country_label' | t -}}
                </strong>
                <dropdown-component data-sorting="true" data-input-id="sorting-input">
                  <button
                    type="button"
                    class="dropdown-component_opener --align-left"
                    aria-expanded="false"
                    aria-controls="{{ section.id }}-sort-select-dropdown"
                    aria-describedby="{{ section.id }}-sort-select-heading"
                  >
                    {%- liquid
                      for option in search.sort_options
                        if option.value == sort_by
                          echo option.name | escape
                        endif
                      endfor
                    -%}
                    <i class="dropdown-componenet_icn-caret">
                      {%- render 'icons-data', width: 9, height: 5, use_icon: true, icon_reference: 'chevron-arrow' -%}
                    </i>
                  </button>
                  <div class="dropdown-component_wrapper" id="{{ section.id }}-sort-select-dropdown">
                    <ul class="list-unstyled">
                      {%- for option in search.sort_options -%}
                        <li>
                          <button data-btn-sort="" type="button" class="dropdown-component_btn-submit dropdown-component_btn-submit--sort {% if option.value == sort_by %}active{% endif %}" data-value="{{- option.value | escape -}}">
                            {{- option.name | escape -}}
                            {%- if option.value == sort_by -%}
                              <span class="visually-hidden">{{- 'products_grid.sort.option_selected' | t -}}</span>
                            {%- endif -%}
                          </button>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </dropdown-component>
              </div>
            {%- endif -%}
            {% if search.results_count != null %}
              <em class="filter-header_results-text">
                {% if search.results_count > 0 %}
                  {{ 'main_search.show_results' | t: count: search.results_count }}
                  {% else %}
                    {{ 'main_search.no_res' | t }}
                {% endif %}
              </em>
              {% else %}
                <em class="filter-header_results-text">
                  {% if search.products_count and search.products_count != search.all_products_count %}
                    {{ 'main_search.product_count.other' | t: product_count: search.products_count, count: search.all_products_count }}
                    {% else %}
                      {{ 'main_search.product_count_simple.other' | t: count: search.all_products_count }}
                  {% endif %}
                </em>
            {% endif %}
          </div>
        </div>
        {%- else -%}
          {%- if section.settings.enable_sorting -%}
            <div>
              <div class="facets-active --v-align-middle">
                <div class="dropdown-component dropdown-component--sorting" data-render-sort="">
                  <strong id="{{ section.id }}-sort-select-heading" class="visually-hidden" role="heading" aria-level="2">
                    {{- 'localization.country_label' | t -}}
                  </strong>
                  <dropdown-component data-sorting="true" data-input-id="sorting-input">
                    <button
                      type="button"
                      class="dropdown-component_opener --align-left"
                      aria-expanded="false"
                      aria-controls="{{ section.id }}-sort-select-dropdown"
                      aria-describedby="{{ section.id }}-sort-select-heading"
                    >
                      {%- liquid
                        for option in search.sort_options
                          if option.value == sort_by
                            echo option.name | escape
                          endif
                        endfor
                      -%}
                      <i class="dropdown-componenet_icn-caret">
                        {%- render 'icons-data', width: 9, height: 5, use_icon: true, icon_reference: 'chevron-arrow' -%}
                      </i>
                    </button>
                    <div class="dropdown-component_wrapper" id="{{ section.id }}-sort-select-dropdown">
                      <ul class="list-unstyled">
                        {%- for option in search.sort_options -%}
                          <li>
                            <button data-btn-sort="" type="button" class="dropdown-component_btn-submit dropdown-component_btn-submit--sort {% if option.value == sort_by %}active{% endif %}" data-value="{{- option.value | escape -}}">
                              {{- option.name | escape -}}
                              {%- if option.value == sort_by -%}
                                <span class="visually-hidden">{{- 'products_grid.sort.option_selected' | t -}}</span>
                              {%- endif -%}
                            </button>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </dropdown-component>
                </div>
              </div>
            </div>
          {%- endif -%}
          <filters-form
            data-section="{{- section.id -}}"
            class="visually-hidden"
          >
            <form data-render-facets-form="">
              <input type="hidden" name="sort_by" value="{{- sort_value -}}" id="sorting-input">
              <input type="hidden" name="q" value="{{- search.terms -}}" id="search-terms">
            </form>
          </filters-form>
      {%- endif -%}
      {%- if search.results.size == 0 -%}
        <div class="component-collection-grid">
          <div class="grid" data-render-grid-products="">
            <div class="grid_col grid_col--empty">
              <div class="{{ section_prefix_class }}_empty-content --align-center">
                <i class="{{ section_prefix_class }}_icn">
                  {%- render 'icons-data', width: 38, height: 38, use_icon: true, icon_reference: 'empty-box' -%}
                </i>
                <strong class="h6 {{ section_prefix_class }}_empty-heading mty">
                  {{- 'facets.empty_heading' | t -}}
                </strong>
              </div>
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="component-collection-grid">
          <div class="grid" data-render-grid-products="">
            {%- paginate search.results by max_results_to_show -%}
              {%- for item in search.results -%}
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {%- assign product = item -%}
                    <div class="grid_col" data-render-columns="">
                      {%- liquid
                        render 'product-column-card', product: product, prefix_class: section_prefix_class, loading: loading_attr, show_sec_image: section.settings.show_sec_image
                        if section.settings.bt_btns_layout == 'enable_atc_guick_view' or section.settings.bt_btns_layout == 'enable_quick_view'
                          render 'product-quick-view', product: product
                        endif
                      -%}
                    </div>
                  {%- when 'article' -%}
                    {%- assign article = item -%}
                    <div class="grid_col" data-render-columns="">
                      {%- render 'blog-card', article: article, show_image: section.settings.show_featured_image, show_date: section.settings.show_date, show_author: section.settings.show_author, show_excerpt: section.settings.show_excerpt, show_comments_count: section.settings.show_comments_count, prefix_class: section_prefix_class, blog_heading_size: 'text-size--large', show_tags: section.settings.show_tags -%}
                    </div>
                  {%- when 'page' -%}
                    {%- assign article = item -%}
                    <div class="grid_col">
                      {%- render 'page-card', prefix_class: section_prefix_class, page: item -%}
                    </div>
                {%- endcase -%}
              {%- endfor -%}
              {%- liquid
                case section.settings.paging_type
                  when 'click_load'
                    render 'load-more', paginate: paginate, infinite: false
                  when 'load_more'
                    render 'load-more', paginate: paginate, infinite: true
                  else
                    render 'pagination', paginate: paginate, prefix_class: section_prefix_class
                endcase
              -%}
            {%- endpaginate -%}
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.enable_filtering -%}
        <sticky-block
          class="sticky-facets-wrapper"
          data-spacer="true"
          data-revealed="false"
          data-behavior="observer"
        >
          <aside class="facets_options-wrapper facets--fixed-area facets_options--{{ section.settings.filter_button_position }} --justify-{{ section.settings.filter_button_position }}">
            <div class="facets_container --justify-{{ section.settings.filter_button_position }}">
              <div class="dropdown-component dropdown-component--facets">
                <strong id="facets-dropdown-component-heading" class="visually-hidden">
                  {{- 'facets.drawer_label_heading' | t -}}
                </strong>
                <dropdown-component
                  data-facets="true"
                >
                  <button
                    type="button"
                    class="dropdown-component_opener facets_toggler button button--primary"
                    aria-expanded="false"
                    aria-controls="facets-dropdown-component"
                    aria-describedby="facets-dropdown-component-heading"
                  >
                    {%- render 'icons-data', width: 20, height: 20, use_icon: true, icon_reference: 'filters' -%}
                    <span class="facets_text-wrap" data-filters-count="">
                      {%- if active_filters_size == 0 -%}
                        {{- 'facets.toggler_label' | t -}}
                        {%- else -%}
                          {{- 'facets.toggler_label' | t -}}
                          <span class="facets_count-pan">
                            {{- active_filters_size -}}
                          </span>
                      {%- endif -%}
                    </span>
                  </button>
                  <div class="dropdown-component_wrapper">
                    <div id="facets-dropdown-component">
                      <filters-form
                        data-section="{{- section.id -}}"
                      >
                        <button
                          type="button"
                          class="dropdown-component_opener facets_toggler--close btn-icn-ixi"
                          data-toggle-facets="close"
                        >
                          <span class="btn-icn-ixi_wrapper">
                            {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'cross' -%}
                            <span class="visually-hidden">{{- 'accessibility.close' | t -}}</span>
                          </span>
                        </button>
                        <form data-render-facets-form="">
                          {%- render 'facets', results: search -%}
                          <input type="hidden" name="sort_by" value="{{- sort_value -}}" id="sorting-input">
                          <input type="hidden" name="q" value="{{- search.terms -}}" id="search-terms">
                        </form>
                      </filters-form>
                    </div>
                  </div>
                </dropdown-component>
              </div>
            </div>
          </aside>
        </sticky-block>
      {%- endif -%}
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <div class="facets_loader">
          <span class="loader {{ section_prefix_class }}_loader hidden" data-loader="">
            {%- render 'icons-data', width: 20, height: 20, use_icon: true, icon_reference: 'loader' -%}
            <span class="visually-hidden">
              {{- 'accessibility.loader.label' | t -}}
            </span>
          </span>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        },
        {
          "value": "heading_small",
          "label": "t:sections.common.heading.size.options.opt_5.label"
        },
        {
          "value": "heading_x_small",
          "label": "t:sections.common.heading.size.options.opt_6.label"
        }
      ],
      "default": "heading_small"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "Find products and brands quickly from the latest trends to classics, all in one place."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:sections.common.breadcrumb.content"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.common.breadcrumb.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_top_bdr",
      "label": "t:sections.common.breadcrumb.top_bdr.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_bdr",
      "label": "t:sections.common.breadcrumb.bottom_bdr.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "breadcrumb_color_scheme",
      "default": "scheme2",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.grid.content"
    },
    {
      "type": "range",
      "id": "number_of_columns_on_desktop",
      "label": "t:sections.common.grid.settings.desktop.num_cols.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "number_of_rows_on_desktop",
      "label": "t:sections.common.grid.settings.desktop.num_rows.label",
      "min": 1,
      "max": 7,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "number_of_columns_on_mobile",
      "label": "t:sections.common.grid.settings.mobile.num_cols.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.common.grid.settings.mobile.num_cols.options.opt_1.label"
        },
        {
          "value": "2",
          "label": "t:sections.common.grid.settings.mobile.num_cols.options.opt_2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "mob_cols_query",
      "label": "t:sections.common.grid.settings.mobile.num_cols.query.label",
      "min": 416,
      "max": 640,
      "step": 4,
      "default": 576,
      "info": "t:sections.common.grid.settings.mobile.num_cols.query.info"
    },
    {
      "type": "header",
      "content": "t:sections.main_search.settings.product_card.content"
    },
    {
      "type": "checkbox",
      "id": "variants_position",
      "label": "t:sections.collection_products_grid.settings.variants_position.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "title_top",
      "label": "t:sections.collection_products_grid.settings.show_title.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.main_search.settings.product_card.rating.label",
      "info": "t:sections.main_search.settings.product_card.rating.info",
      "default": true
    },
    {
      "type": "select",
      "id": "bt_btns_layout",
      "label": "t:sections.main_search.settings.product_card.btns_layout.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main_search.settings.product_card.btns_layout.options.opt_1.label"
        },
        {
          "value": "enable_atc_guick_view",
          "label": "t:sections.main_search.settings.product_card.btns_layout.options.opt_2.label"
        },
        {
          "value": "enable_atc",
          "label": "t:sections.main_search.settings.product_card.btns_layout.options.opt_3.label"
        },
        {
          "value": "enable_quick_view",
          "label": "t:sections.main_search.settings.product_card.btns_layout.options.opt_4.label"
        },
        {
          "value": "show_view_detail",
          "label": "t:sections.main_search.settings.product_card.btns_layout.options.opt_5.label"
        }
      ],
      "default": "enable_atc_guick_view"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "t:sections.main_search.settings.product_card.discount.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.main_search.settings.product_card.vendor.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "t:sections.main_search.settings.product_card.compare.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "t:sections.main_search.settings.product_card.quick_view.stock.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sec_image",
      "label": "t:sections.featured_collection.settings.show_sec_image.label",

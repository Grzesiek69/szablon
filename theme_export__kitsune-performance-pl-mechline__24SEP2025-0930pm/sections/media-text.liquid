{{ 'component-video-card.css' | asset_url | stylesheet_tag }}
{{- 'media-text.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'media-text'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'
  

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture section_caption_size
    case section.settings.section_caption_size
      when 'heading_medium'
        echo 'h4'
      when 'heading_small'
        echo 'h5'
      when 'heading_x_small'
        echo 'h6'
      else
        echo 'h'
    endcase
  endcapture

  capture cols_order_class
    if section.settings.section_media_order == 'row_reverse'
      echo '--row-reverse'
    endif
  endcapture

  capture loading_attr
    if section.index > 1
      echo 'lazy'
      else
        echo 'eager'
    endif
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 20px;
    --section-slider-radius: 8px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --mobile-q-align: {{ section.settings.section_mobile_text_alignment }};
    --desktop-q-align: {{ section.settings.section_text_alignment }};
  }
{%- endstyle -%}
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} {{ section_prefix_class }}--bdr-bottom {{ section_prefix_class }}--bdr-top">
  <div class="container">
    <div class="{{ section_prefix_class }}_wrapper {{ cols_order_class }} --v-align-{{ section.settings.content_alignment }}">
      {%- if section.blocks.size > 0 -%}
        <div class="{{ section_prefix_class }}_col {{ section_prefix_class }}_col-media">
          <splide-slider
            data-drag="true"
            data-autoplay="{{- section.settings.auto_play -}}"
            data-rewind="true"
            data-pause-on-hover="true"
            data-gap="30px"
            data-per-move="1"
            data-arrows="{{ section.settings.show_navigation }}"
            data-pagination="{{- section.settings.show_pagination -}}"
            data-per-page="1"
            data-interval="{{- section.settings.change_slides_every | times: 1000 -}}"
            {% if request.design_mode == false %}
              data-type="loop"
              {% else %}
                data-type="slide"
            {% endif %}
          >
            <div class="splide">
              <div class="splide__track">
                <div class="splide__list">
                  {%- for block in section.blocks -%}
                    {%- case block.type -%}
                      {%- when 'video' -%}
                        <div class="splide__slide" {{ block.shopify_attributes }}>
                          {%- render 'video-card', card: block, prefix_class: section_prefix_class, index: forloop.index -%}
                        </div>
                      {%- when 'image' -%}
                        {%- liquid
                          capture placeholder_image
                            if forloop.index > 3
                              echo 'hero-apparel-1'
                              else
                                echo 'hero-apparel-' | append: forloop.index
                            endif
                          endcapture

                          capture image_alt
                            if block.settings.image != blank
                              if block.settings.image.alt != blank
                                echo block.settings.image.alt
                                else
                                  echo 'media_with_text.image_alt' | t: index: forloop.index
                              endif
                            endif
                          endcapture

                          capture section_media_size
                            if section.settings.section_media_size == 'adapt'
                              echo block.settings.image.aspect_ratio | default: '1'
                            else
                              echo '1'
                            endif
                          endcapture
                        -%}
                        <div class="splide__slide" {{ block.shopify_attributes }}>
                          <div class="{{ section_prefix_class }}_image-wrap --media-size-{{ section.settings.section_media_size }}" style="--media-ratio: {{ section_media_size }};">
                            {%- if block.settings.image != blank -%}
                              {{- block.settings.image | image_url: width: 3840 | image_tag: class: 'object-fit object-fit--absolute', loading: loading_attr, widths: '992, 1200, 1350, 1920, 3840', sizes: '(max-width: 767px) 992vw, (min-width: 992px) 1200vw, (max-width: 1349px) 1920vw, 3840vw', alt: image_alt -}}
                              {%- else -%}
                                {{- placeholder_image | placeholder_svg_tag: 'object-fit object-fit--absolute' -}}
                            {%- endif -%}
                          </div>
                        </div>
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              </div>
              {%- if section.settings.show_navigation or section.settings.show_pagination -%}
                <div class="splide-controls --justify-center">
                  {%- if section.settings.show_navigation -%}
                    <button class="splide__arrow splide__arrow--prev btn-icn-ixi">
                      <span class="btn-icn-ixi_wrapper">
                        <span class="visually-hidden">{{- 'accessibility.slider.previous' | t -}}</span>
                        {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'left-arrow' -%}
                      </span>
                    </button>
                  {%- endif -%}
                  <ul class="splide__pagination" role="tablist" aria-label="{{- 'accessibility.slider.pagination_label' | t -}}"></ul>
                  {%- if section.settings.show_navigation -%}
                    <button class="splide__arrow splide__arrow--next btn-icn-ixi">
                      <span class="btn-icn-ixi_wrapper">
                        <span class="visually-hidden">{{- 'accessibility.slider.next' | t -}}</span>
                        {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'right-arrow' -%}
                      </span>
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </splide-slider>
        </div>
      {%- endif -%}
      <div class="{{ section_prefix_class }}_col {{ section_prefix_class }}_col-description --q-align">
        {%- if section.settings.heading != blank or section.settings.section_caption != blank -%}
          <header class="heading-head">
            {%- if section.settings.section_caption != blank -%}
              <strong class="{{ section_caption_size }} {{ section_prefix_class }}_caption-title">
                {{- section.settings.section_caption -}}
              </strong>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">
                {{- section.settings.heading -}}
              </h2>
            {%- endif -%}
          </header>
        {%- endif -%}
        {%- if section.settings.section_description != blank -%}
          <div class="{{ section_prefix_class }}_description --word-break text-size--{{ section.settings.section_text_size }} mty">
            {{- section.settings.section_description -}}
          </div>
        {%- endif -%}
        {%- if section.settings.view_more_label != blank -%}
          <footer class="{{ section_prefix_class }}_foot">
            <a
              {% if section.settings.view_more_link != blank -%}href="{{ section.settings.view_more_link }}"{% else %}aria-disabled="true"{% endif %}
              class="button button--{{ section.settings.view_more_type }}"
              {% if section.settings.open_new_window %}target="_blank"{% endif %}
            >
              {{- section.settings.view_more_label -}}
            </a>
          </footer>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.media_with_text.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "section_caption",
      "label": "t:sections.media_with_text.settings.caption.label",
      "default": "Caption"
    },
    {
      "type": "select",
      "id": "section_caption_size",
      "label": "t:sections.media_with_text.settings.caption.size.label",
      "options": [
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        },
        {
          "value": "heading_small",
          "label": "t:sections.common.heading.size.options.opt_5.label"
        },
        {
          "value": "heading_x_small",
          "label": "t:sections.common.heading.size.options.opt_6.label"
        }
      ],
      "default": "heading_small"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Media with text"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "<p>Pair text with an image or video to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "t:sections.media_with_text.settings.view_more_button.label",
      "default": "BUTTON LABEL"
    },
    {
      "type": "select",
      "id": "view_more_type",
      "label": "t:sections.media_with_text.settings.view_more_button.type.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.common.button.settings.options.opt_1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.common.button.settings.options.opt_2.label"
        }
      ],
      "default": "primary"
    },
    {
      "type": "url",
      "id": "view_more_link",
      "label": "t:sections.media_with_text.settings.view_more_button.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_new_window",
      "label": "t:sections.common.target_blank.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "select",
      "id": "section_media_size",
      "label": "t:sections.common.media_size.settings.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.common.media_size.settings.options.opt_1.label"
        },
        {
          "value": "square",
          "label": "t:sections.common.media_size.settings.options.opt_2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.common.media_size.settings.options.opt_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.common.media_size.settings.options.opt_4.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "section_media_order",
      "label": "t:sections.media_with_text.settings.media_order.label",
      "options": [
        {
          "value": "row",
          "label": "t:sections.media_with_text.settings.media_order.options.opt_1.label"
        },
        {
          "value": "row_reverse",
          "label": "t:sections.media_with_text.settings.media_order.options.opt_2.label"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.media_with_text.settings.alignment.label",
      "options": [
        {
          "value": "top",
          "label": "t:sections.common.v_alignment.settings.alignment.options.top.label"
        },
        {
          "value": "middle",
          "label": "t:sections.common.v_alignment.settings.alignment.options.middle.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.common.v_alignment.settings.alignment.options.bottom.label"
        }
      ],
      "default": "middle"
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.media_with_text.settings.text_alignment.desktop.label",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "section_mobile_text_alignment",
      "label": "t:sections.media_with_text.settings.text_alignment.mobile.label",
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.slideshow.content"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "t:sections.common.slideshow.auto_play.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.common.slideshow.show_arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:sections.common.slideshow.show_nav.label",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_every",
      "label": "t:sections.common.slideshow.interval.label",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 5,
      "unit": "s",
      "info": "t:sections.common.slideshow.interval.info"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.media_with_text.blocks.image.name",
      "type": "image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.media_with_text.blocks.image.settings.info"
        }
      ]
    },
    {
      "name": "t:sections.media_with_text.blocks.video.name",
      "type": "video",
      "settings": [
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "t:sections.common.video.settings.cov_image.label",
          "info": "t:sections.video_list.settings.image.info"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "t:sections.media_with_text.blocks.video.settings.alt_text.label",
          "info": "t:sections.media_with_text.blocks.video.settings.alt_text.info"
        },
        {
          "type": "checkbox",
          "id": "enable_video_looping",
          "default": false,
          "label": "t:sections.common.video.settings.enable_video_looping.label"
        },
        {
          "type": "header",
          "content": "t:sections.common.video.settings.upload.content"
        },
        {
          "type": "video",
          "id": "upload_video",
          "label": "t:sections.common.video.label"
        },
        {
          "type": "header",
          "content": "t:sections.common.video.settings.embed.content",
          "info": "t:sections.common.video.settings.embed.info"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "t:sections.common.video.settings.embed.url.label",
          "accept": [
            "youtube",
            "vimeo"
          ],
          "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.media_with_text.name",
      "blocks": [
        {
          "type": "image",
          "settings": {}
        },
        {
          "type": "video",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
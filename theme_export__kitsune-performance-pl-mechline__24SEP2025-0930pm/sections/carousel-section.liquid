{{- 'component-carousel-card.css' | asset_url | stylesheet_tag -}}
{{- 'carousel-section.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'carousel'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture section_height_class
    case section.settings.section_carousel_height
      when 'small'
        echo '--small-height'
      when 'medium'
        echo '--medium-height'
      when 'window_height'
        echo '--vh-height'
    endcase
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 17px;
    --section-slider-radius: 8px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
  }
{%- endstyle -%}
<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }}">
  <div class="{{ section_prefix_class }}_wrapper">
    <splide-slider
      data-drag='true'
      data-autoplay='{{- section.settings.auto_play -}}'
      data-rewind="true"
      data-gap='30px'
      data-per-move="1"
      data-arrows='{{- section.settings.show_navigation -}}'
      data-pagination='{{ section.settings.show_pagination }}'
      data-per-page='1'
      data-interval="{{- section.settings.change_slides_every | times: 1000 -}}"
      {% if section.settings.type == 'fade' %}
        data-type="fade"
        {% else %}
          data-type="slide"
      {% endif %}
    >
      <div class="splide {{ section_prefix_class }}_slider">
        <div class="splide__track">
          <div class="splide__list">
            {%- for block in section.blocks -%}
              <div class="splide__slide" {{ block.shopify_attributes }}>
                {%- render 'carousel-card', card: block, index: forloop.index, height: section_height_class, prefix_class: section_prefix_class -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if section.settings.show_navigation or section.settings.show_pagination -%}
          <div class="splide-controls arrows-control --justify-center">
            {%- if section.settings.show_navigation -%}
              <button class="splide__arrow splide__arrow--prev btn-icn-ixi">
                <span class="btn-icn-ixi_wrapper">
                  <span class="visually-hidden">{{- 'accessibility.slider.previous' | t -}}</span>
                  {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'left-arrow' -%}
                </span>
              </button>
            {%- endif -%}
            <ul class="splide__pagination" role="tablist" aria-label="{{- 'accessibility.slider.pagination_label' | t -}}"></ul>
            {%- if section.settings.show_navigation -%}
              <button class="splide__arrow splide__arrow--next btn-icn-ixi">
                <span class="btn-icn-ixi_wrapper">
                  <span class="visually-hidden">{{- 'accessibility.slider.next' | t -}}</span>
                  {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'right-arrow' -%}
                </span>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </splide-slider>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.carousel_section.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "select",
      "id": "section_carousel_height",
      "label": "t:sections.carousel_section.settings.size.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.carousel_section.settings.size.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.carousel_section.settings.size.options.opt_2.label"
        },
        {
          "value": "window_height",
          "label": "t:sections.carousel_section.settings.size.options.opt_3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.slideshow.content"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "t:sections.common.slideshow.auto_play.label",
      "default": true
    },
    {
      "type": "select",
      "id": "type",
      "label": "t:sections.carousel_section.settings.slide_type.name",
      "options": [
        {
          "value": "fade",
          "label": "t:sections.carousel_section.settings.slide_type.opt_1.label"
        },
        {
          "value": "slide",
          "label": "t:sections.carousel_section.settings.slide_type.opt_2.label"
        }
      ],
      "default": "fade"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.common.slideshow.show_arrows.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:sections.common.slideshow.show_nav.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_every",
      "label": "t:sections.common.slideshow.interval.label",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 5,
      "unit": "s",
      "info": "t:sections.common.slideshow.interval.info"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.carousel_section.blocks.slide.name",
      "type": "slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.carousel_section.blocks.slide.settings.image.info"
        },
        {
          "type": "header",
          "content": "t:sections.carousel_section.blocks.slide.settings.caption.content"
        },
        {
          "type": "checkbox",
          "id": "container_full",
          "label": "t:sections.carousel_section.blocks.slide.settings.make_container_full.label",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "increase_container_spaces",
          "label": "t:sections.carousel_section.blocks.slide.settings.increase_container_spaces.label",
          "default": false,
          "visible_if": "{{ block.settings.container_full == true }}"
        },
        {
          "type": "checkbox",
          "id": "enable_container",
          "label": "t:sections.carousel_section.blocks.slide.settings.enable_container.label",
          "default": true
        },
        {
          "type": "range",
          "id": "max_content_size",
          "label": "t:sections.carousel_section.blocks.slide.settings.max_content_size.label",
          "min": 50,
          "max": 100,
          "step": 5,
          "default": 55,
          "unit": "%"
        },
        {
          "type": "select",
          "id": "block_content_position",
          "label": "t:sections.carousel_section.blocks.slide.settings.content_position.label",
          "options": [
            {
              "value": "top_left",
              "label": "t:sections.carousel_section.blocks.slide.settings.content_position.options.opt_1.label"
            },
            {
              "value": "top_right",
              "label": "t:sections.carousel_section.blocks.slide.settings.content_position.options.opt_2.label"
            },
            {
              "value": "middle_left",
              "label": "t:sections.banner.settings.content_position.options.opt_4.label"
            },
            {
              "value": "centered",
              "label": "t:sections.carousel_section.blocks.slide.settings.content_position.options.opt_3.label"
            },
            {
              "value": "middle_right",
              "label": "t:sections.banner.settings.content_position.options.opt_6.label"
            },
            {
              "value": "bottom_left",
              "label": "t:sections.carousel_section.blocks.slide.settings.content_position.options.opt_4.label"
            },
            {
              "value": "bottom_right",
              "label": "t:sections.carousel_section.blocks.slide.settings.content_position.options.opt_5.label"
            }
          ],
          "default": "centered"
        },
        {
          "type": "inline_richtext",
          "id": "caption",
          "label": "t:sections.carousel_section.blocks.slide.settings.caption_settings.name"
        },
        {
          "type": "select",
          "id": "caption_text_size",
          "label": "t:sections.carousel_section.blocks.slide.settings.caption_settings.text_size.label",

          "id": "subheading",
          "label": "t:sections.common.subheading.label",
          "default": "1.3k followers"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:sections.common.description.label",
          "default": "<span>Our Inspiration: Capturing Life's Moments</span>"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:sections.links_bar.blocks.link.settings.url.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",

{{- 'component-record-table.css' | asset_url | stylesheet_tag -}}
{{- 'component-hotspot.css' | asset_url | stylesheet_tag -}}
{{- 'component-figure-box.css' | asset_url | stylesheet_tag -}}
{{- 'product-showcase.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_prefix_class = 'product-showcase'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'
  assign marquee_scheme_class = section.settings.marquee_color_scheme | prepend: 'scheme scheme--'

  capture max_header_size
    echo settings.page_width | times: section.settings.max_header_size | divided_by: 100
  endcapture

  assign product = section.settings.product
  if product.selected_or_first_available_variant.featured_media != null
    assign media = product.selected_or_first_available_variant.featured_media
    else
      for media in product.media
        assign media = media
        break
      endfor
  endif

  assign marquee_direction = 'backward'
  if section.settings.marquee_direction == 'marquee_forward'
    assign marquee_direction = 'forward'
  endif

  capture enable_marquee
    assign flag = 'false'
    for block in section.blocks
      if block.type == 'scroll_text'
        assign flag = 'true'
        break
      endif
    endfor
    echo flag
  endcapture

  capture enable_hotspot
    assign flag = 'false'
    for block in section.blocks
      if block.type == 'hotspot'
        assign flag = 'true'
        break
      endif
    endfor
    echo flag
  endcapture

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture

  capture container_class
    if section.settings.section_full_width
      echo 'container-fluid'
      else
        echo 'container'
    endif
  endcapture
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 10px;
    --section-slider-radius: 8px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
  }
{%- endstyle -%}
<div id="{{ section.id }}" class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} --align-{{ section.settings.section_text_alignment }} {% if section.settings.hide_product %}{{ section_prefix_class }}_hide-product{% endif %}">
  <div class="{{ section_prefix_class }}_wrapper">
    {%- if section.settings.heading != blank or section.settings.section_description != blank -%}
      <div class="container" style="--cp-width: {{ max_header_size }}">
        <header class="heading-head">
          {%- if section.settings.heading != blank -%}
            <h2 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">{{- section.settings.heading -}}</h2>
          {%- endif -%}
          {%- if section.settings.section_description != blank -%}
            <div class="{{ section_prefix_class }}_description --word-break text-size--{{ section.settings.section_text_size }} mty">
              <p>{{- section.settings.section_description -}}</p>
            </div>
          {%- endif -%}
        </header>
      </div>
    {%- endif -%}
    <div class="{{ section_prefix_class }}_detail {% if section.settings.remove_spacing %}remove-spacing{% endif %} {% if section.settings.remove_section_radius %}remove-radius{% endif %} {% if section.settings.remove_btn_radius %}remove-btn-radius{% endif %} {% if section.settings.show_bdr_top %} {{ section_prefix_class }}--bdr-top{% endif %} {% if section.settings.show_bdr_bottom %} {{ section_prefix_class }}--bdr-bottom{% endif %}">
      <div class="{{ container_class }}">
        {%- if enable_hotspot == 'true' -%}
          <div class="grid {% if enable_marquee == 'false' %}grid--sp-default{% endif %}">
            <div class="grid_col grid_col--pair grid_col--first">
              {%- liquid
                for block in section.blocks
                  if block.type == 'hotspot'
                    render 'figure-hotspot', figure: block, prefix_class: section_prefix_class, figure_index: forloop.index
                  endif
                endfor
              -%}
            </div>
            {%- unless section.settings.hide_product -%}
              {%- if enable_marquee == 'true' -%}
                <div class="{{ section_prefix_class }}_marquee {{ marquee_scheme_class }}">
                  <div class="{{ section_prefix_class }}_marquee-wrapper">
                    <marquee-component data-rotation="up" data-direction="{{ marquee_direction }}" data-pause-on-hover="{{ section.settings.marquee_on_hover }}" data-speed="{{ section.settings.marquee_speed }}">
                      <div class="marquee-component">
                        {%- for block in section.blocks -%}
                          {%- if block.type == 'scroll_text' -%}
                            <div class="marquee-component_col">
                              {{- block.settings.heading -}}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </marquee-component>
                  </div>
                </div>
              {%- endif -%}
            {%- endunless -%}
            {%- unless section.settings.hide_product -%}
              <div class="grid_col grid_col--pair grid_col--second">
                <div class="{{ section_prefix_class }}_slider-wrapper">
                  <splide-slider
                    data-drag="true"
                    data-gap="0"
                    data-per-move="1"
                    data-arrows="{{ section.settings.show_navigation }}"
                    data-pagination="false"
                    data-per-page="1"
                    data-type="slide"
                    id="slider-ref-{{ section.id }}"
                  >
                    <div class="splide">
                      <div class="splide__track">
                        <div class="splide__list">
                          {%- for block in section.blocks -%}
                            {%- liquid
                              assign product_1 = null
                              assign product_2 = null
                              assign media_1 = null
                              assign media_2 = null
                            -%}
                            {%- if block.type == 'hotspot' -%}
                              {%- liquid
                                assign product_1 = block.settings.block_product_1
                                assign product_2 = block.settings.block_product_2

                                if product_1.selected_or_first_available_variant.featured_media != null
                                  assign media_1 = product_1.selected_or_first_available_variant.featured_media
                                  else
                                    for media in product_1.media
                                      assign media_1 = media
                                      break
                                    endfor
                                endif

                                if product_2.selected_or_first_available_variant.featured_media != null
                                  assign media_2 = product_2.selected_or_first_available_variant.featured_media
                                  else
                                    for media in product_2.media
                                      assign media_2 = media
                                      break
                                    endfor
                                endif
                              -%}
                              {%- if block.settings.enable_spot_first -%}
                                <div class="splide__slide" data-id="slide-ref-{{ section.id }}-{{ block.id }}-1st">
                                  {%- render 'figure-box', figure: media_1, product_url: product_1.url, prefix_class: section_prefix_class -%}
                                  <div class="table-wrapper">
                                    {%- render 'showcase-table', product: product_1, prefix_class: section_prefix_class -%}
                                  </div>
                                </div>
                              {%- endif -%}
                              {%- if block.settings.enable_spot_second -%}
                                <div class="splide__slide" data-id="slide-ref-{{ section.id }}-{{ block.id }}-2nd">
                                  {%- render 'figure-box', figure: media_2, product_url: product_2.url, prefix_class: section_prefix_class -%}
                                  <div class="table-wrapper">
                                    {%- render 'showcase-table', product: product_2, prefix_class: section_prefix_class -%}
                                  </div>
                                </div>
                              {%- endif -%}
                              {%- if block.settings.enable_spot_first == false and block.settings.enable_spot_second == false -%}
                                <div class="splide__slide">
                                  {%- render 'figure-box', figure: null, product_url: null, prefix_class: section_prefix_class -%}
                                  <div class="table-wrapper">
                                    {%- render 'showcase-table', product: null, prefix_class: section_prefix_class -%}
                                  </div>
                                </div>
                              {%- endif -%}
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                      {%- if section.settings.show_navigation -%}
                        <div class="splide-controls --justify-center">
                          {%- if section.settings.show_navigation -%}
                            <button class="splide__arrow splide__arrow--prev btn-icn-ixi">
                              <span class="btn-icn-ixi_wrapper">
                                <span class="visually-hidden">{{- 'accessibility.slider.previous' | t -}}</span>
                                {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'left-arrow' -%}
                              </span>
                            </button>
                          {%- endif -%}
                          <ul class="splide__pagination" role="tablist" aria-label="{{- 'accessibility.slider.pagination_label' | t -}}"></ul>
                          {%- if section.settings.show_navigation -%}
                            <button class="splide__arrow splide__arrow--next btn-icn-ixi">
                              <span class="btn-icn-ixi_wrapper">
                                <span class="visually-hidden">{{- 'accessibility.slider.next' | t -}}</span>
                                {%- render 'icons-data', width: 10, height: 10, use_icon: true, icon_reference: 'right-arrow' -%}
                              </span>
                            </button>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </splide-slider>
                </div>
              </div>
            {%- endunless -%}
          </div>
          {%- else -%}
            <div class="grid {% if enable_marquee == 'false' %}grid--sp-default{% endif %} {% if enable_hotspot == 'false' %}grid--v-center{% endif %}">
              <div class="grid_col grid_col--pair grid_col--first">
                {%- render 'figure-box', figure: media, prefix_class: section_prefix_class, product_url: product.url -%}
              </div>
              {%- unless section.settings.hide_product -%}
                {%- if enable_marquee == 'true' -%}
                  <div class="{{ section_prefix_class }}_marquee {{ marquee_scheme_class }}">
                    <div class="{{ section_prefix_class }}_marquee-wrapper">
                      <marquee-component data-rotation="up" data-direction="{{ marquee_direction }}" data-pause-on-hover="{{ section.settings.marquee_on_hover }}" data-speed="{{ section.settings.marquee_speed }}">
                        <div class="marquee-component">
                          {%- for block in section.blocks -%}
                            {%- if block.type == 'scroll_text' -%}
                              <div class="marquee-component_col">
                                {{- block.settings.heading -}}
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </marquee-component>
                    </div>
                  </div>
                {%- endif -%}
              {%- endunless -%}
              {%- unless section.settings.hide_product -%}
                <div class="grid_col grid_col--pair grid_col--second">
                  <div class="table-wrapper">
                    {%- render 'showcase-table', product: product, prefix_class: section_prefix_class -%}
                  </div>
                </div>
              {%- endunless -%}
            </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.product_showcase.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.product_showcase.settings.product.label",
      "info": "t:sections.product_showcase.settings.product.info"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Our <strong>Lookbook</strong>"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "max_header_size",
      "label": "t:sections.product_showcase.settings.max_header_size.label",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "select",
      "id": "section_media_size",
      "label": "t:sections.common.media_size.settings.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.common.media_size.settings.options.opt_1.label"
        },
        {
          "value": "square",
          "label": "t:sections.common.media_size.settings.options.opt_2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.common.media_size.settings.options.opt_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.common.media_size.settings.options.opt_4.label"
        }
      ],
      "default": "square",
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "text_alignment",
      "id": "section_text_alignment",
      "label": "t:sections.common.text.settings.alignment.label",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "hide_product",
      "label": "t:sections.product_showcase.settings.hide_product.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_title_hover",
      "label": "t:sections.product_showcase.settings.show_title_hover.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_image_bdr",
      "label": "t:sections.product_showcase.settings.remove_image_bdr.label",
      "default": false,
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "checkbox",
      "id": "remove_spacing",
      "label": "t:sections.product_showcase.settings.remove_spacing.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_section_radius",
      "label": "t:sections.product_showcase.settings.remove_radius.label",
      "default": false
    },
    {
      "type": "select",
      "id": "hotspot_icon_style",
      "label": "t:sections.product_showcase.settings.hotspot_icon_style.label",
      "options": [
        {
          "value": "dot",
          "label": "t:sections.product_showcase.settings.hotspot_icon_style.options.opt_1.label"
        },
        {
          "value": "plus",
          "label": "t:sections.product_showcase.settings.hotspot_icon_style.options.opt_2.label"
        }
      ],
      "default": "dot"
    },
    {
      "type": "checkbox",
      "id": "remove_btn_radius",
      "label": "t:sections.product_showcase.settings.remove_btn_radius.label",
      "default": false,
      "visible_if": "{{ section.settings.hotspot_icon_style == 'plus' }}"
    },
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "t:sections.common.full_width.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bdr_top",
      "label": "t:sections.product_showcase.settings.show_bdr_top.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bdr_bottom",
      "label": "t:sections.product_showcase.settings.show_bdr_bottom.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.scroll.content",
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.common.scroll.settings.speed.label",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 12,
      "unit": "sec",
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "t:sections.common.scroll.settings.direction.label",
      "options": [
        
        {
          "value": "marquee_forward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_4.label"
        },
        {
          "value": "marquee_backward",
          "label": "t:sections.common.scroll.settings.direction.options.opt_3.label"
        }
      ],
      "default": "marquee_backward",
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "checkbox",
      "label": "t:sections.common.scroll.settings.on_hover.label",
      "id": "marquee_on_hover",
      "default": true,
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "color_scheme",
      "id": "marquee_color_scheme",
      "default": "scheme3",
      "label": "t:sections.common.clr_scheme.label",
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "header",
      "content": "t:sections.common.slideshow.content",
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.common.slideshow.show_arrows.label",
      "default": true,
      "visible_if": "{{ section.settings.hide_product == false }}"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.product_showcase.blocks.hotspot.name",
      "type": "hotspot",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.product_showcase.blocks.hotspot.settings.image.info"
        },
        {
          "type": "color_scheme",
          "id": "block_color_scheme",
          "default": "scheme1",
          "label": "t:sections.common.clr_scheme.label"
        },
        {
          "type": "header",
          "content": "t:sections.product_showcase.blocks.hotspot.settings.spots.content_1"
        },
        {
          "type": "checkbox",
          "id": "enable_spot_first",
          "label": "t:sections.product_showcase.blocks.hotspot.settings.spots.enable.label",
          "default": true
        },
        {
          "type": "product",
          "id": "block_product_1",
          "label": "t:sections.product_showcase.settings.product.label"
        },
        {
          "type": "header",
          "content": "t:sections.product_showcase.blocks.hotspot.settings.position.content"
        },
        {
          "type": "range",
          "id": "position_top_spot_first",
          "label": "t:sections.product_showcase.blocks.hotspot.settings.position.top.label",
          "min": 10,
          "max": 90,
          "step": 1,
          "default": 48,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "position_left_spot_first",
          "label": "t:sections.product_showcase.blocks.hotspot.settings.position.left.label",
          "min": 10,
          "max": 90,
          "step": 1,
          "default": 48,
          "unit": "%"
        },
        {
          "type": "header",
          "content": "t:sections.product_showcase.blocks.hotspot.settings.spots.content_2"
        },
        {
          "type": "checkbox",
          "id": "enable_spot_second",
          "label": "t:sections.product_showcase.blocks.hotspot.settings.spots.enable.label",
          "default": true
        },
        {
          "type": "product",
          "id": "block_product_2",
          "label": "t:sections.product_showcase.settings.product.label"
        },
        {
          "type": "header",
          "content": "t:sections.product_showcase.blocks.hotspot.settings.position.content"
        },
        {
          "type": "range",
          "id": "position_top_spot_second",
          "label": "t:sections.product_showcase.blocks.hotspot.settings.position.top.label",
          "min": 10,
          "max": 90,
          "step": 1,
          "default": 70,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "position_left_spot_second",
          "label": "t:sections.product_showcase.blocks.hotspot.settings.position.left.label",
          "min": 10,
          "max": 90,
          "step": 1,
          "default": 35,
          "unit": "%"
        }
      ]
    },
    {
      "name": "t:sections.product_showcase.blocks.text.name",
      "type": "scroll_text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.common.heading.label",
          "default": "Scroll text here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_showcase.name",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "position_top_spot_first": 48,
            "position_left_spot_first": 48
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "position_top_spot_second": 70,
            "position_left_spot_second": 35
          }
        },
        {
          "type": "scroll_text",
          "settings": {
          }
        }
      ]
    }
  ]
}
{% endschema %}
{{- 'events-list.css' | asset_url | stylesheet_tag -}}
{% liquid
  assign section_prefix_class = 'events-list'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture section_heading_size
    case section.settings.section_heading_size
      when 'heading_xx_large'
        echo 'h1'
      when 'heading_x_large'
        echo 'h2'
      when 'heading_large'
        echo 'h3'
      when 'heading_medium'
        echo 'h4'
      else
        echo 'h'
    endcase
  endcapture
%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-radius: 5px;
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --columns-count: {{ section.settings.number_of_columns_on_desktop }};
  }
{%- endstyle -%}
<div class="{{ section_prefix_class }} global-block {{ section_scheme_class }} {{ section_prefix_class }}-{{ section.id }}">
  <div class="container">
    <div class="{{ section_prefix_class }}_wrapper"> 
      {%- if section.settings.heading != blank or section.settings.section_description != blank -%}
        <header class="heading-head --align-center">
          {%- if section.settings.heading != blank-%}
            <h2 class="{{ section_prefix_class }}_heading {{ section_heading_size }} --h-anchor-none mty">{{- section.settings.heading -}}</h2>
          {%- endif -%}
          {%- if section.settings.section_description != blank -%}
            <div class="{{ section_prefix_class }}_description text-size--{{ section.settings.section_text_size }} mty">
              <p>{{- section.settings.section_description -}}</p>
            </div>
          {%- endif -%}
        </header>
      {%- endif -%}
      <div class="grid {{ section_prefix_class }}_grid">
        {%- for block in section.blocks -%}
          <div class="grid_col">
            {%- render 'event-row', row: block, prefix_class: section_prefix_class, index: forloop.index -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.events_list.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.heading.label",
      "default": "Exciting Event"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        }
      ],
      "default": "heading_x_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label",
      "default": "*Register your interest."
    },
    {
      "type": "select",
      "id": "section_text_size",
      "label": "t:sections.common.text.settings.fz_sizes.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.common.text.settings.fz_sizes.options.opt_3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:sections.common.grid.content"
    },
    {
      "type": "select",
      "id": "number_of_columns_on_desktop",
      "label": "t:sections.events_list.settings.num_col_d.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.events_list.settings.num_col_d.options.opt_1.label"
        },
        {
          "value": "2",
          "label": "t:sections.events_list.settings.num_col_d.options.opt_2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:sections.events_list.settings.card.content"
    },
    {
      "type": "select",
      "id": "column_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_small",
          "label": "t:sections.common.heading.size.options.opt_5.label"
        },
        {
          "value": "heading_x_small",
          "label": "t:sections.common.heading.size.options.opt_6.label"
        }
      ],
      "default": "heading_x_small"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.settings.top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.settings.bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "t:sections.events_list.blocks.event.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label",
          "info": "t:sections.events_list.blocks.event.settings.image.info"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Event",
          "label": "t:sections.common.heading.label"
        },
        {
          "type": "text",
          "id": "view_more_label",
          "label": "t:sections.events_list.blocks.event.settings.button.settings.btn_lab.label",
          "default": "Book your seat"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.events_list.blocks.event.settings.button.settings.btn_link.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "t:sections.common.target_blank.label",
          "default": false
        },
        {
          "type": "text",
          "id": "location",
          "label": "t:sections.events_list.blocks.event.settings.location.label",
          "default": "Location"
        },
        {
          "type": "text",
          "id": "start_date",
          "label": "t:sections.events_list.blocks.event.settings.start_date.label",
          "default": "Start date"
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "t:sections.events_list.blocks.event.settings.end_date.label",
          "default": "End date"
        },
        {
          "type": "text",
          "id": "organizer",
          "label": "t:sections.events_list.blocks.event.settings.organizer.label",
          "default": "Organizer"
        },
        {
          "type": "text",
          "id": "details_link",
          "label": "t:sections.events_list.blocks.event.settings.details_link.label",
          "default": "#"
        },
        {
          "type": "color_scheme",
          "id": "block_color_scheme",
          "default": "scheme2",
          "label": "t:sections.common.clr_scheme.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.events_list.name",
      "blocks": [
        {
          "type": "event"
        },
        {
          "type": "event"
        },
        {
          "type": "event"
        },
        {
          "type": "event"
        }
      ]
    }
  ]
}
{% endschema %}